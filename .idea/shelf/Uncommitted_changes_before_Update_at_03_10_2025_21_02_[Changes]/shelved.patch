<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Create Payment - Talim CRM</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\r\n    <style>\r\n        .payment-container {\r\n            max-width: 800px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        \r\n        .payment-header {\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n            color: white;\r\n            padding: 30px;\r\n            border-radius: 12px;\r\n            margin-bottom: 30px;\r\n            text-align: center;\r\n        }\r\n        \r\n        .payment-header h1 {\r\n            margin: 0;\r\n            font-size: 2.2rem;\r\n            font-weight: 600;\r\n        }\r\n        \r\n        .payment-header p {\r\n            margin: 10px 0 0 0;\r\n            opacity: 0.9;\r\n            font-size: 1.1rem;\r\n        }\r\n        \r\n        .payment-form {\r\n            background: white;\r\n            padding: 40px;\r\n            border-radius: 12px;\r\n            box-shadow: 0 4px 20px rgba(0,0,0,0.1);\r\n            border: 1px solid #e1e5e9;\r\n        }\r\n        \r\n        .form-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr 1fr;\r\n            gap: 20px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .form-group {\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .form-group.full-width {\r\n            grid-column: 1 / -1;\r\n        }\r\n        \r\n        .form-group label {\r\n            display: block;\r\n            margin-bottom: 8px;\r\n            font-weight: 600;\r\n            color: #2d3748;\r\n            font-size: 0.95rem;\r\n        }\r\n        \r\n        .form-group input,\r\n        .form-group select {\r\n            width: 100%;\r\n            padding: 12px 16px;\r\n            border: 2px solid #e2e8f0;\r\n            border-radius: 8px;\r\n            font-size: 1rem;\r\n            transition: all 0.2s ease;\r\n            background: #f8fafc;\r\n        }\r\n        \r\n        .form-group input:focus,\r\n        .form-group select:focus {\r\n            outline: none;\r\n            border-color: #667eea;\r\n            background: white;\r\n            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);\r\n        }\r\n        \r\n        .form-group input.error,\r\n        .form-group select.error {\r\n            border-color: #e53e3e;\r\n            background: #fed7d7;\r\n        }\r\n        \r\n        .error-message {\r\n            color: #e53e3e;\r\n            font-size: 0.875rem;\r\n            margin-top: 5px;\r\n            display: none;\r\n        }\r\n        \r\n        .form-actions {\r\n            display: flex;\r\n            gap: 15px;\r\n            justify-content: flex-end;\r\n            margin-top: 30px;\r\n            padding-top: 20px;\r\n            border-top: 1px solid #e2e8f0;\r\n        }\r\n        \r\n        .btn {\r\n            padding: 12px 24px;\r\n            border: none;\r\n            border-radius: 8px;\r\n            font-size: 1rem;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: all 0.2s ease;\r\n            text-decoration: none;\r\n            display: inline-flex;\r\n            align-items: center;\r\n            gap: 8px;\r\n        }\r\n        \r\n        .btn-primary {\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n            color: white;\r\n        }\r\n        \r\n        .btn-primary:hover {\r\n            transform: translateY(-1px);\r\n            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);\r\n        }\r\n        \r\n        .btn-secondary {\r\n            background: #f7fafc;\r\n            color: #4a5568;\r\n            border: 2px solid #e2e8f0;\r\n        }\r\n        \r\n        .btn-secondary:hover {\r\n            background: #edf2f7;\r\n            border-color: #cbd5e0;\r\n        }\r\n        \r\n        .loading {\r\n            display: none;\r\n            align-items: center;\r\n            gap: 8px;\r\n            color: #667eea;\r\n            font-weight: 500;\r\n        }\r\n        \r\n        .spinner {\r\n            width: 16px;\r\n            height: 16px;\r\n            border: 2px solid #e2e8f0;\r\n            border-top: 2px solid #667eea;\r\n            border-radius: 50%;\r\n            animation: spin 1s linear infinite;\r\n        }\r\n        \r\n        @keyframes spin {\r\n            0% { transform: rotate(0deg); }\r\n            100% { transform: rotate(360deg); }\r\n        }\r\n        \r\n        .success-message {\r\n            background: #f0fff4;\r\n            border: 1px solid #9ae6b4;\r\n            color: #22543d;\r\n            padding: 12px 16px;\r\n            border-radius: 8px;\r\n            margin-bottom: 20px;\r\n            display: none;\r\n        }\r\n        \r\n        .student-info,\r\n        .group-info {\r\n            background: #f8fafc;\r\n            padding: 15px;\r\n            border-radius: 8px;\r\n            margin-top: 10px;\r\n            border-left: 4px solid #667eea;\r\n            display: none;\r\n        }\r\n        \r\n        .info-item {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            margin-bottom: 5px;\r\n        }\r\n        \r\n        .info-label {\r\n            font-weight: 600;\r\n            color: #4a5568;\r\n        }\r\n        \r\n        .info-value {\r\n            color: #2d3748;\r\n        }\r\n        \r\n        @media (max-width: 768px) {\r\n            .form-grid {\r\n                grid-template-columns: 1fr;\r\n            }\r\n            \r\n            .payment-container {\r\n                padding: 10px;\r\n            }\r\n            \r\n            .payment-form {\r\n                padding: 20px;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link active\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n\r\n    <main class=\"main-content\">\r\n        <div class=\"payment-container\">\r\n        <div class=\"payment-header\">\r\n            <h1>Create New Payment</h1>\r\n            <p>Record a payment for a student in a specific group</p>\r\n        </div>\r\n\r\n        <div class=\"success-message\" id=\"successMessage\">\r\n            ✓ Payment created successfully! Redirecting to payments list...\r\n        </div>\r\n\r\n        <form id=\"paymentForm\" class=\"payment-form\">\r\n            <div class=\"form-grid\">\r\n                <div class=\"form-group\">\r\n                    <label for=\"studentId\">Select Student *</label>\r\n                    <select id=\"studentId\" required>\r\n                        <option value=\"\">Choose a student...</option>\r\n                    </select>\r\n                    <div class=\"error-message\" id=\"studentError\">Please select a student</div>\r\n                    <div class=\"student-info\" id=\"studentInfo\">\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Name:</span>\r\n                            <span class=\"info-value\" id=\"studentName\">-</span>\r\n                        </div>\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Phone:</span>\r\n                            <span class=\"info-value\" id=\"studentPhone\">-</span>\r\n                        </div>\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Parent:</span>\r\n                            <span class=\"info-value\" id=\"studentParent\">-</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label for=\"groupId\">Select Group *</label>\r\n                    <select id=\"groupId\" required>\r\n                        <option value=\"\">Choose a group...</option>\r\n                    </select>\r\n                    <div class=\"error-message\" id=\"groupError\">Please select a group</div>\r\n                    <div class=\"group-info\" id=\"groupInfo\">\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Group Name:</span>\r\n                            <span class=\"info-value\" id=\"groupName\">-</span>\r\n                        </div>\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Teacher:</span>\r\n                            <span class=\"info-value\" id=\"groupTeacher\">-</span>\r\n                        </div>\r\n                        <div class=\"info-item\">\r\n                            <span class=\"info-label\">Schedule:</span>\r\n                            <span class=\"info-value\" id=\"groupSchedule\">-</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label for=\"sum\">Payment Amount *</label>\r\n                <input type=\"number\" step=\"0.01\" id=\"sum\" placeholder=\"Enter amount (e.g., 150000)\" required>\r\n                <div class=\"error-message\" id=\"amountError\">Please enter a valid amount</div>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label for=\"paymentType\">Payment Method *</label>\r\n                <select id=\"paymentType\" required>\r\n                    <option value=\"\">Select payment method...</option>\r\n                    <option value=\"CASH\">\uD83D\uDCB5 Cash Payment</option>\r\n                    <option value=\"CARD\">\uD83D\uDCB3 Card Payment</option>\r\n                </select>\r\n                <div class=\"error-message\" id=\"typeError\">Please select a payment method</div>\r\n            </div>\r\n\r\n            <div class=\"form-actions\">\r\n                <a th:href=\"@{/v1/pay/listPage}\" class=\"btn btn-secondary\">\r\n                    ← Cancel\r\n                </a>\r\n                <button type=\"submit\" class=\"btn btn-primary\" id=\"submitBtn\">\r\n                    <span class=\"btn-text\">Create Payment</span>\r\n                    <div class=\"loading\" id=\"loading\">\r\n                        <div class=\"spinner\"></div>\r\n                        Creating...\r\n                    </div>\r\n                </button>\r\n            </div>\r\n        </form>\r\n        </div>\r\n    </main>\r\n</div>\r\n\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    const form = document.getElementById('paymentForm');\r\n    const studentSelect = document.getElementById('studentId');\r\n    const groupSelect = document.getElementById('groupId');\r\n    const submitBtn = document.getElementById('submitBtn');\r\n    const loading = document.getElementById('loading');\r\n    const successMessage = document.getElementById('successMessage');\r\n    \r\n    let students = [];\r\n    let groups = [];\r\n\r\n    // Load students and groups\r\n    async function loadData() {\r\n        try {\r\n            const [studentsRes, groupsRes] = await Promise.all([\r\n                fetch('/v1/student/list'),\r\n                fetch('/v1/group/list')\r\n            ]);\r\n            \r\n            if (studentsRes.ok) {\r\n                students = await studentsRes.json();\r\n                populateStudents();\r\n            }\r\n            \r\n            if (groupsRes.ok) {\r\n                groups = await groupsRes.json();\r\n                populateGroups();\r\n            }\r\n        } catch (error) {\r\n            console.error('Error loading data:', error);\r\n            showError('Failed to load students and groups. Please refresh the page.');\r\n        }\r\n    }\r\n\r\n    function populateStudents() {\r\n        studentSelect.innerHTML = '<option value=\"\">Choose a student...</option>';\r\n        students.forEach(student => {\r\n            const option = document.createElement('option');\r\n            option.value = student.id;\r\n            const phone = student.phoneNum || student.phone || '';\r\n            option.textContent = `${student.fullName} ${phone ? '(' + phone + ')' : ''}`;\r\n            studentSelect.appendChild(option);\r\n        });\r\n        enhanceSelectSearch(studentSelect, students.map(s => ({ id: s.id, label: `${s.fullName} ${s.phoneNum ? '('+s.phoneNum+')' : ''}`.trim() })));\r\n    }\r\n\r\n    function populateGroups() {\r\n        groupSelect.innerHTML = '<option value=\"\">Choose a group...</option>';\r\n        groups.forEach(group => {\r\n            const option = document.createElement('option');\r\n            option.value = group.id;\r\n            option.textContent = `${group.nameOfGroup}`;\r\n            groupSelect.appendChild(option);\r\n        });\r\n        enhanceSelectSearch(groupSelect, groups.map(g => ({ id: g.id, label: g.nameOfGroup })));\r\n    }\r\n\r\n    // Add simple search-as-you-type overlay for selects\r\n    function enhanceSelectSearch(selectEl, items) {\r\n        // Skip on very old browsers\r\n        if (!selectEl) return;\r\n        // Wrap select with a container and add an input above it\r\n        const wrapper = document.createElement('div');\r\n        wrapper.style.position = 'relative';\r\n        const search = document.createElement('input');\r\n        search.type = 'text';\r\n        search.placeholder = 'Type to search...';\r\n        search.style.marginBottom = '8px';\r\n        search.style.padding = '10px 14px';\r\n        search.style.border = '2px solid #e2e8f0';\r\n        search.style.borderRadius = '8px';\r\n        search.style.width = '100%';\r\n        search.style.background = '#f8fafc';\r\n        \r\n        const parent = selectEl.parentElement;\r\n        parent.insertBefore(wrapper, selectEl);\r\n        wrapper.appendChild(search);\r\n        wrapper.appendChild(selectEl);\r\n        \r\n        function renderOptions(filter) {\r\n            const lower = (filter || '').toLowerCase();\r\n            selectEl.innerHTML = '<option value=\"\">Choose...</option>';\r\n            items\r\n                .filter(it => it.label.toLowerCase().includes(lower))\r\n                .forEach(it => {\r\n                    const opt = document.createElement('option');\r\n                    opt.value = it.id;\r\n                    opt.textContent = it.label;\r\n                    selectEl.appendChild(opt);\r\n                });\r\n        }\r\n        \r\n        search.addEventListener('input', () => renderOptions(search.value));\r\n    }\r\n\r\n    // Student selection handler\r\n    studentSelect.addEventListener('change', function() {\r\n        const studentId = this.value;\r\n        const studentInfo = document.getElementById('studentInfo');\r\n        \r\n        if (studentId) {\r\n            const student = students.find(s => s.id == studentId);\r\n            if (student) {\r\n                document.getElementById('studentName').textContent = student.fullName || '-';\r\n                document.getElementById('studentPhone').textContent = student.phone || '-';\r\n                document.getElementById('studentParent').textContent = \r\n                    student.parentName ? `${student.parentName} (${student.parentPhone || 'No phone'})` : '-';\r\n                studentInfo.style.display = 'block';\r\n            }\r\n        } else {\r\n            studentInfo.style.display = 'none';\r\n        }\r\n        clearError('studentError');\r\n    });\r\n\r\n    // Group selection handler\r\n    groupSelect.addEventListener('change', function() {\r\n        const groupId = this.value;\r\n        const groupInfo = document.getElementById('groupInfo');\r\n        \r\n        if (groupId) {\r\n            const group = groups.find(g => g.id == groupId);\r\n            if (group) {\r\n                document.getElementById('groupName').textContent = group.nameOfGroup || '-';\r\n                document.getElementById('groupTeacher').textContent = \r\n                    group.teacher ? `${group.teacher.firstName} ${group.teacher.lastName}` : '-';\r\n                const schedule = group.lessonStartTime && group.lessonEndTime \r\n                    ? `${group.lessonStartTime} - ${group.lessonEndTime}` \r\n                    : 'Not set';\r\n                document.getElementById('groupSchedule').textContent = schedule;\r\n                groupInfo.style.display = 'block';\r\n            }\r\n        } else {\r\n            groupInfo.style.display = 'none';\r\n        }\r\n        clearError('groupError');\r\n    });\r\n\r\n    // Form validation\r\n    function validateForm() {\r\n        let isValid = true;\r\n        \r\n        if (!studentSelect.value) {\r\n            showError('studentError', 'Please select a student');\r\n            isValid = false;\r\n        }\r\n        \r\n        if (!groupSelect.value) {\r\n            showError('groupError', 'Please select a group');\r\n            isValid = false;\r\n        }\r\n        \r\n        const amount = document.getElementById('sum').value;\r\n        if (!amount || isNaN(amount) || parseFloat(amount) <= 0) {\r\n            showError('amountError', 'Please enter a valid amount');\r\n            isValid = false;\r\n        }\r\n        \r\n        if (!document.getElementById('paymentType').value) {\r\n            showError('typeError', 'Please select a payment method');\r\n            isValid = false;\r\n        }\r\n        \r\n        return isValid;\r\n    }\r\n\r\n    function showError(elementId, message) {\r\n        const errorElement = document.getElementById(elementId);\r\n        errorElement.textContent = message;\r\n        errorElement.style.display = 'block';\r\n        \r\n        const inputElement = document.getElementById(elementId.replace('Error', ''));\r\n        if (inputElement) {\r\n            inputElement.classList.add('error');\r\n        }\r\n    }\r\n\r\n    function clearError(elementId) {\r\n        const errorElement = document.getElementById(elementId);\r\n        errorElement.style.display = 'none';\r\n        \r\n        const inputElement = document.getElementById(elementId.replace('Error', ''));\r\n        if (inputElement) {\r\n            inputElement.classList.remove('error');\r\n        }\r\n    }\r\n\r\n    function showError(message) {\r\n        alert(message);\r\n    }\r\n\r\n    // Form submission\r\n    form.addEventListener('submit', async function(e) {\r\n        e.preventDefault();\r\n        \r\n        if (!validateForm()) {\r\n            return;\r\n        }\r\n        \r\n        const formData = {\r\n            sum: parseFloat(document.getElementById('sum').value),\r\n            paymentType: document.getElementById('paymentType').value\r\n        };\r\n        \r\n        const studentId = studentSelect.value;\r\n        const groupId = groupSelect.value;\r\n        \r\n        // Show loading state\r\n        submitBtn.disabled = true;\r\n        loading.style.display = 'flex';\r\n        document.querySelector('.btn-text').style.display = 'none';\r\n        \r\n        try {\r\n            const response = await fetch(`/v1/pay/create/${studentId}/${groupId}`, {\r\n                method: 'POST',\r\n                headers: {\r\n                    'Content-Type': 'application/json'\r\n                },\r\n                body: JSON.stringify(formData)\r\n            });\r\n            \r\n            if (!response.ok) {\r\n                const errorText = await response.text();\r\n                throw new Error(errorText || 'Failed to create payment');\r\n            }\r\n            \r\n            // Show success message\r\n            successMessage.style.display = 'block';\r\n            \r\n            // Redirect after a short delay\r\n            setTimeout(() => {\r\n                window.location.href = '/v1/pay/listPage';\r\n            }, 2000);\r\n            \r\n        } catch (error) {\r\n            console.error('Payment creation error:', error);\r\n            showError(error.message || 'Failed to create payment. Please try again.');\r\n        } finally {\r\n            // Reset button state\r\n            submitBtn.disabled = false;\r\n            loading.style.display = 'none';\r\n            document.querySelector('.btn-text').style.display = 'inline';\r\n        }\r\n    });\r\n\r\n    // Clear errors on input\r\n    ['studentId', 'groupId', 'sum', 'paymentType'].forEach(id => {\r\n        const element = document.getElementById(id);\r\n        if (element) {\r\n            element.addEventListener('input', () => clearError(id + 'Error'));\r\n        }\r\n    });\r\n\r\n    // Load initial data\r\n    loadData();\r\n});\r\n</script>\r\n</body>\r\n</html>\r\n\r\n
