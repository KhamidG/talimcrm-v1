<div style=\"margin-bottom:12px;\">\r\n                    <label>Full name *</label>\r\n                    <input type=\"text\" id=\"fullName\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"John Doe\" required>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                    <label>Phone *</label>\r\n                    <input type=\"tel\" id=\"phoneNum\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"+998 xx xxx xx xx\" required>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                    <label>Username *</label>\r\n                    <input type=\"text\" id=\"username\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"johndoe\" required>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                    <label>Password *</label>\r\n                    <input type=\"password\" id=\"password\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"Enter password\" required>\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                    <label>Level of Knowledge</label>\r\n                    <select id=\"levelOfKnowledge\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\r\n                        <option value=\"\">Select level</option>\r\n                        <option value=\"BEGINNER\">Beginner</option>\r\n                        <option value=\"INTERMEDIATE\">Intermediate</option>\r\n                        <option value=\"ADVANCED\">Advanced</option>\r\n                        <option value=\"EXPERT\">Expert</option>\r\n                    </select>\r\n                </div>\r\n                <div class=\"actions\">\r\n                    <button type=\"submit\" class=\"btn\">Create Teacher</button>\r\n                    <a th:href=\"@{/v1/teacher/listPage}\" class=\"btn\" style=\"background:#e0e0e0; color:#333;\">Cancel</a>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </main>\r\n</div>\r\n\r\n<script>\r\n    const API = '/v1/teacher';\r\n\r\n    document.getElementById('teacherRegisterForm').addEventListener('submit', async (e) => {\r\n        e.preventDefault();\r\n        \r\n        const payload = {\r\n            fullName: document.getElementById('fullName').value.trim(),\r\n            phoneNum: document.getElementById('phoneNum').value.trim(),\r\n            username: document.getElementById('username').value.trim(),\r\n            password: document.getElementById('password').value.trim(),\r\n            levelOfKnowledge: document.getElementById('levelOfKnowledge').value\r\n        };\r\n\r\n        try {\r\n            const res = await fetch(`${API}/register`, {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json' },\r\n                body: JSON.stringify(payload)\r\n            });\r\n            \r\n            if (res.ok) {\r\n                const teacher = await res.json();\r\n                alert('Teacher created successfully!');\r\n                window.location.href = '/v1/teacher/listPage';\r\n            } else {\r\n                const error = await res.text();\r\n                alert('Failed to create teacher: ' + error);\r\n            }\r\n        } catch (error) {\r\n            alert('Failed to create teacher: ' + error.message);\r\n        }\r\n    });\r\n\r\n    // sidebar toggle\r\n    (() => {\r\n      const sidebar = document.getElementById('sidebar');\r\n      const toggle = document.getElementById('sidebarToggle');\r\n      const key = 'talimcrm.sidebar.collapsed';\r\n      const apply = () => {\r\n        const collapsed = localStorage.getItem(key) === '1';\r\n        if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n      };\r\n      apply();\r\n      toggle.addEventListener('click', () => {\r\n        const collapsed = !(localStorage.getItem(key) === '1');\r\n        localStorage.setItem(key, collapsed ? '1' : '0');\r\n        apply();\r\n      });\r\n    })();\r\n</script>\r\n</body>\r\n</html>
