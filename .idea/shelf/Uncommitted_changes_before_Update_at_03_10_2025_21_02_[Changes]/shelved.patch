<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Reception - Talim CRM</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\">\r\n    <link rel=\"stylesheet\" th:href=\"@{/reception.css}\">\r\n</head>\r\n<body>\r\n    <div class=\"app-container\">\r\n        <aside class=\"sidebar\" id=\"sidebar\">\r\n            <div class=\"sidebar-header\">\r\n                Talim CRM\r\n            </div>\r\n            <nav class=\"sidebar-nav\">\r\n                <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n            </nav>\r\n        </aside>\r\n        \r\n        <main class=\"main-content\">\r\n            <div class=\"reception-container\">\r\n                <h1>Reception Dashboard - New Clients</h1>\r\n                \r\n                <!-- Teacher Login Section -->\r\n                <div class=\"teacher-login-section\" style=\"margin-bottom: 30px;\">\r\n                    <div class=\"card\" style=\"background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white;\">\r\n                        <h2 style=\"color: white; margin-bottom: 15px;\">\uD83D\uDC68\u200D\uD83C\uDFEB Teacher Access</h2>\r\n                        <p style=\"margin-bottom: 15px; opacity: 0.9;\">Teachers can access their dashboard to view students and manage their courses.</p>\r\n                        <a th:href=\"@{/v1/teacher/login}\" class=\"btn\" style=\"background: white; color: #28a745; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: 500;\">Teacher Login</a>\r\n                    </div>\r\n                </div>\r\n                \r\n                <!-- Quick Registration Form -->\r\n                <div class=\"registration-section\">\r\n                    <div class=\"card\">\r\n                        <h2>Quick Registration</h2>\r\n                        <form id=\"quickRegisterForm\" class=\"registration-form\">\r\n                            <div class=\"form-row\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"firstName\" class=\"form-label\">First Name</label>\r\n                                    <input type=\"text\" id=\"firstName\" name=\"firstName\" class=\"form-input\" required>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"lastName\" class=\"form-label\">Last Name</label>\r\n                                    <input type=\"text\" id=\"lastName\" name=\"lastName\" class=\"form-input\" required>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form-row\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"phone\" class=\"form-label\">Phone</label>\r\n                                    <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" required>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"role\" class=\"form-label\">Role</label>\r\n                                    <select id=\"role\" name=\"role\" class=\"form-input\" required>\r\n                                        <option value=\"\">Select Role</option>\r\n                                        <option value=\"STUDENT\">Student (Created with IN_REGISTER status)</option>\r\n                                        <option value=\"TEACHER\">Teacher</option>\r\n                                    </select>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form-row\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"testScore\" class=\"form-label\">Placement test score (0-40)</label>\r\n                                    <input type=\"number\" id=\"testScore\" name=\"testScore\" min=\"0\" max=\"40\" class=\"form-input\" placeholder=\"e.g. 26\">\r\n                                    <small style=\"color:#666;\">Used only for Students to suggest empty groups</small>\r\n                                </div>\r\n                            </div>\r\n                            <button type=\"submit\" class=\"btn btn-success\">Register User</button>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Suggested Groups (after student registration) -->\r\n                <div id=\"suggestedGroupsSection\" class=\"users-section\" style=\"display:none;\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-header\">\r\n                            <h2>Suggested empty groups</h2>\r\n                            <div class=\"controls\">\r\n                                <input type=\"text\" id=\"groupSearch\" placeholder=\"Search groups...\" class=\"form-input\">\r\n                            </div>\r\n                        </div>\r\n                        <div style=\"margin: -10px 0 10px 0; color:#666;\" id=\"suggestionHint\"></div>\r\n                        <div class=\"table-container\">\r\n                            <table>\r\n                                <thead>\r\n                                <tr>\r\n                                    <th>ID</th>\r\n                                    <th>Name</th>\r\n                                    <th>Type</th>\r\n                                    <th>Schedule</th>\r\n                                    <th>Students</th>\r\n                                    <th>Max</th>\r\n                                    <th>Created</th>\r\n                                </tr>\r\n                                </thead>\r\n                                <tbody id=\"suggestedGroupsBody\"></tbody>\r\n                            </table>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Recent Users List -->\r\n                <div class=\"users-section\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-header\">\r\n                            <h2>New Clients (IN_REGISTER status)</h2>\r\n                            <div class=\"controls\">\r\n                                <input type=\"text\" id=\"searchUsers\" placeholder=\"Search users...\" class=\"form-input\">\r\n                                <select id=\"pageSize\" class=\"form-input\" style=\"margin-left: 10px;\">\r\n                                    <option value=\"10\">10 per page</option>\r\n                                    <option value=\"25\" selected>25 per page</option>\r\n                                    <option value=\"50\">50 per page</option>\r\n                                    <option value=\"100\">100 per page</option>\r\n                                </select>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"table-container\">\r\n                            <table id=\"usersTable\">\r\n                                <thead>\r\n                                    <tr>\r\n                                        <th>ID</th>\r\n                                        <th>Name</th>\r\n                                        <th>Phone</th>\r\n                                        <th>Role</th>\r\n                                        <th>Status</th>\r\n                                        <th>Created</th>\r\n                                        <th>Actions</th>\r\n                                    </tr>\r\n                                </thead>\r\n                                <tbody id=\"usersTableBody\">\r\n                                    <!-- Users will be loaded here -->\r\n                                </tbody>\r\n                            </table>\r\n                        </div>\r\n                        \r\n                        <!-- Pagination Controls -->\r\n                        <div id=\"paginationControls\" style=\"display:flex; justify-content:space-between; align-items:center; margin:20px 0; padding:10px 0;\">\r\n                            <div id=\"paginationInfo\" style=\"color:#666; font-size:14px;\">\r\n                                Showing <span id=\"showingStart\">0</span> to <span id=\"showingEnd\">0</span> of <span id=\"totalRecords\">0</span> entries\r\n                            </div>\r\n                            <div id=\"paginationButtons\" style=\"display:flex; gap:8px;\">\r\n                                <button id=\"prevPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Previous</button>\r\n                                <div id=\"pageNumbers\" style=\"display:flex; gap:4px;\"></div>\r\n                                <button id=\"nextPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Next</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </main>\r\n    </div>\r\n\r\n    <!-- Group Selection Modal -->\r\n    <div id=\"groupSelectionModal\" class=\"modal\" style=\"display: none;\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <h3>Choose Group for <span id=\"modalClientName\"></span></h3>\r\n                <span class=\"close\" onclick=\"closeGroupSelectionModal()\">&times;</span>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <div class=\"form-group\">\r\n                    <label for=\"placementScore\" class=\"form-label\">Placement Test Score (0-40)</label>\r\n                    <input type=\"number\" id=\"placementScore\" min=\"0\" max=\"40\" class=\"form-input\" placeholder=\"Enter score\">\r\n                    <small style=\"color:#666;\">Score > 25 → IELTS groups with available spots, Score ≤ 25 → BEGINNER/PRE_IELTS groups with available spots</small>\r\n                </div>\r\n                <div class=\"form-group\">\r\n                    <label for=\"groupSearchModal\" class=\"form-label\">Search Groups</label>\r\n                    <input type=\"text\" id=\"groupSearchModal\" placeholder=\"Search groups...\" class=\"form-input\">\r\n                </div>\r\n                <div class=\"table-container\">\r\n                    <table>\r\n                        <thead>\r\n                            <tr>\r\n                                <th>ID</th>\r\n                                <th>Name</th>\r\n                                <th>Type</th>\r\n                                <th>Students</th>\r\n                                <th>Max</th>\r\n                                <th>Action</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody id=\"modalGroupsBody\">\r\n                            <!-- Groups will be loaded here -->\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        let allUsers = [];\r\n        let currentPage = 1;\r\n        let pageSize = 25;\r\n        let filteredData = [];\r\n\r\n        // Load users on page load\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            loadUsers();\r\n            document.getElementById('pageSize').addEventListener('change', (e) => {\r\n                pageSize = parseInt(e.target.value);\r\n                currentPage = 1;\r\n                applyFilters();\r\n            });\r\n            document.getElementById('prevPage').addEventListener('click', () => {\r\n                if (currentPage > 1) {\r\n                    currentPage--;\r\n                    renderPage();\r\n                }\r\n            });\r\n            document.getElementById('nextPage').addEventListener('click', () => {\r\n                const totalPages = Math.ceil(filteredData.length / pageSize);\r\n                if (currentPage < totalPages) {\r\n                    currentPage++;\r\n                    renderPage();\r\n                }\r\n            });\r\n\r\n            // Admin login form\r\n            document.getElementById('adminLoginForm').addEventListener('submit', async function(e) {\r\n                e.preventDefault();\r\n                \r\n                const username = document.getElementById('adminUsername').value.trim();\r\n                const password = document.getElementById('adminPassword').value;\r\n                const errorDiv = document.getElementById('adminLoginError');\r\n                \r\n                if (!username || !password) {\r\n                    errorDiv.textContent = 'Please fill in all fields';\r\n                    errorDiv.style.display = 'block';\r\n                    return;\r\n                }\r\n                \r\n                try {\r\n                    const response = await fetch('/v1/auth/login', {\r\n                        method: 'POST',\r\n                        headers: {\r\n                            'Content-Type': 'application/json'\r\n                        },\r\n                        body: JSON.stringify({ username, password })\r\n                    });\r\n                    \r\n                    const result = await response.json();\r\n                    \r\n                    if (result.success) {\r\n                        const userRole = result.user.role;\r\n                        showNotification(`Login successful! Welcome ${result.user.username} (${userRole})`, 'success');\r\n                        \r\n                        // Role-based redirects\r\n                        let redirectUrl = '/v1/student/listPage'; // default\r\n                        switch(userRole) {\r\n                            case 'admin':\r\n                                redirectUrl = '/v1/student/listPage';\r\n                                break;\r\n                            case 'manager':\r\n                                redirectUrl = '/v1/student/listPage';\r\n                                break;\r\n                            case 'receptionist':\r\n                                redirectUrl = '/v1/student/register';\r\n                                break;\r\n                            case 'accountant':\r\n                                redirectUrl = '/v1/pay/listPage';\r\n                                break;\r\n                        }\r\n                        \r\n                        setTimeout(() => {\r\n                            window.location.href = redirectUrl;\r\n                        }, 1500);\r\n                    } else {\r\n                        errorDiv.textContent = result.message || 'Login failed';\r\n                        errorDiv.style.display = 'block';\r\n                    }\r\n                } catch (error) {\r\n                    console.error('Login error:', error);\r\n                    errorDiv.textContent = 'Network error. Please try again.';\r\n                    errorDiv.style.display = 'block';\r\n                }\r\n            });\r\n        });\r\n\r\n        // Quick registration form\r\n        let isSubmitting = false;\r\n        document.getElementById('quickRegisterForm').addEventListener('submit', function(e) {\r\n            e.preventDefault();\r\n            if (isSubmitting) return; // prevent double submit\r\n            isSubmitting = true;\r\n\r\n            const formData = new FormData(this);\r\n            const userData = {\r\n                fullName: formData.get('firstName') + ' ' + formData.get('lastName'),\r\n                phoneNum: formData.get('phone'),\r\n                roles: formData.get('role')\r\n            };\r\n            const scoreValue = Number(document.getElementById('testScore').value || '0'); // capture before reset\r\n            const submitBtn = this.querySelector('button[type=\"submit\"]');\r\n            if (submitBtn) submitBtn.disabled = true;\r\n\r\n            fetch('/v1/auth/register', {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json' },\r\n                body: JSON.stringify(userData)\r\n            })\r\n            .then(async response => {\r\n                if (!response.ok) {\r\n                    const msg = await response.text();\r\n                    throw new Error(msg || 'Request failed');\r\n                }\r\n                return response.json();\r\n            })\r\n            .then(async dto => {\r\n                showNotification('New client registered successfully!', 'success');\r\n                this.reset();\r\n                loadUsers();\r\n                \r\n                // If role is STUDENT, show suggested groups for manual assignment\r\n                if ((userData.roles || '').toUpperCase() === 'STUDENT') {\r\n                    await showSuggestedGroups(scoreValue);\r\n                } else {\r\n                    hideSuggestedGroups();\r\n                }\r\n            })\r\n            .catch(error => {\r\n                console.error('Error:', error);\r\n                showNotification('Error registering user', 'error');\r\n            })\r\n            .finally(() => {\r\n                isSubmitting = false;\r\n                if (submitBtn) submitBtn.disabled = false;\r\n            });\r\n        });\r\n\r\n        // Load users from API\r\n        function loadUsers() {\r\n            fetch('/v1/auth/users')\r\n                .then(response => response.json())\r\n                .then(data => {\r\n                    allUsers = Array.isArray(data) ? data : [];\r\n                    applyFilters();\r\n                })\r\n                .catch(error => {\r\n                    console.error('Error:', error);\r\n                });\r\n        }\r\n\r\n        // Apply filters and pagination\r\n        function applyFilters() {\r\n            const searchTerm = document.getElementById('searchUsers').value.toLowerCase();\r\n            const filteredUsers = allUsers.filter(user => \r\n                (user.fullName && user.fullName.toLowerCase().includes(searchTerm)) ||\r\n                (user.phoneNum && user.phoneNum.includes(searchTerm)) ||\r\n                (user.roles && user.roles.toLowerCase().includes(searchTerm))\r\n            );\r\n            filteredData = filteredUsers;\r\n            currentPage = 1;\r\n            renderPage();\r\n        }\r\n\r\n        // Render users table with pagination\r\n        function renderPage() {\r\n            const startIndex = (currentPage - 1) * pageSize;\r\n            const endIndex = startIndex + pageSize;\r\n            const pageData = filteredData.slice(startIndex, endIndex);\r\n            \r\n            const tbody = document.getElementById('usersTableBody');\r\n            tbody.innerHTML = '';\r\n\r\n            if (pageData.length === 0) {\r\n                tbody.innerHTML = '<tr><td colspan=\"7\" class=\"no-data\">No users found</td></tr>';\r\n            } else {\r\n                pageData.forEach(user => {\r\n                    const row = document.createElement('tr');\r\n                    row.innerHTML = `\r\n                        <td>${user.id}</td>\r\n                        <td>${escapeHtml(user.fullName || 'N/A')}</td>\r\n                        <td>${escapeHtml(user.phoneNum || 'N/A')}</td>\r\n                        <td>${escapeHtml(user.roles || 'N/A')}</td>\r\n                        <td><span class=\"status ${user.status === 'IN_REGISTER' ? 'in_register' : 'active'}\">${user.status || 'ACTIVE'}</span></td>\r\n                        <td>${formatDate(user.created_at)}</td>\r\n                        <td>\r\n                            ${user.status === 'IN_REGISTER' ? \r\n                                `<button class=\"btn btn-primary\" onclick=\"showGroupSelection(${user.id}, '${escapeHtml(user.fullName)}', '${escapeHtml(user.phoneNum)}')\">Choose Group</button>` : \r\n                                user.roles === 'NEW_USER' ? \r\n                                    `<button class=\"btn btn-success\" onclick=\"convertToStudent(${user.id}, '${escapeHtml(user.fullName)}', '${escapeHtml(user.phoneNum)}')\">Add to Students</button>` : \r\n                                    '<span style=\"color: #999;\">Already converted</span>'\r\n                            }\r\n                        </td>\r\n                    `;\r\n                    tbody.appendChild(row);\r\n                });\r\n            }\r\n            updatePagination();\r\n        }\r\n\r\n        // Update pagination controls\r\n        function updatePagination() {\r\n            const totalPages = Math.ceil(filteredData.length / pageSize);\r\n            const startIndex = (currentPage - 1) * pageSize;\r\n            const endIndex = Math.min(startIndex + pageSize, filteredData.length);\r\n            \r\n            // Update pagination info\r\n            document.getElementById('showingStart').textContent = filteredData.length > 0 ? startIndex + 1 : 0;\r\n            document.getElementById('showingEnd').textContent = endIndex;\r\n            document.getElementById('totalRecords').textContent = filteredData.length;\r\n            \r\n            // Update buttons\r\n            document.getElementById('prevPage').disabled = currentPage <= 1;\r\n            document.getElementById('nextPage').disabled = currentPage >= totalPages;\r\n            \r\n            // Update page numbers\r\n            const pageNumbersDiv = document.getElementById('pageNumbers');\r\n            pageNumbersDiv.innerHTML = '';\r\n            \r\n            const maxVisiblePages = 5;\r\n            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));\r\n            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);\r\n            \r\n            if (endPage - startPage + 1 < maxVisiblePages) {\r\n                startPage = Math.max(1, endPage - maxVisiblePages + 1);\r\n            }\r\n            \r\n            for (let i = startPage; i <= endPage; i++) {\r\n                const pageBtn = document.createElement('button');\r\n                pageBtn.textContent = i;\r\n                pageBtn.className = i === currentPage ? 'btn btn-primary' : 'btn btn-outline';\r\n                pageBtn.style.cssText = 'padding:8px 12px; border:1px solid #ddd; background:' + (i === currentPage ? '#007bff; color:white' : 'white') + '; border-radius:6px; cursor:pointer;';\r\n                pageBtn.addEventListener('click', () => {\r\n                    currentPage = i;\r\n                    renderPage();\r\n                });\r\n                pageNumbersDiv.appendChild(pageBtn);\r\n            }\r\n        }\r\n\r\n        // Search functionality\r\n        document.getElementById('searchUsers').addEventListener('input', applyFilters);\r\n\r\n        // Utility functions\r\n        function formatDate(dateString) {\r\n            if (!dateString) return 'N/A';\r\n            const date = new Date(dateString);\r\n            return date.toLocaleDateString('en-GB', {\r\n                day: '2-digit',\r\n                month: '2-digit',\r\n                year: 'numeric',\r\n                hour: '2-digit',\r\n                minute: '2-digit'\r\n            });\r\n        }\r\n\r\n        function escapeHtml(text) {\r\n            const div = document.createElement('div');\r\n            div.textContent = text;\r\n            return div.innerHTML;\r\n        }\r\n\r\n        function showNotification(message, type) {\r\n            const notification = document.createElement('div');\r\n            notification.className = `notification ${type}`;\r\n            notification.textContent = message;\r\n            notification.style.cssText = `\r\n                position: fixed;\r\n                top: 20px;\r\n                right: 20px;\r\n                padding: 15px 20px;\r\n                border-radius: 8px;\r\n                color: white;\r\n                font-weight: 600;\r\n                z-index: 1000;\r\n                animation: slideIn 0.3s ease-out;\r\n            `;\r\n            \r\n            if (type === 'success') {\r\n                notification.style.backgroundColor = '#4CAF50';\r\n            } else if (type === 'warning') {\r\n                notification.style.backgroundColor = '#ff9800';\r\n            } else {\r\n                notification.style.backgroundColor = '#f44336';\r\n            }\r\n            \r\n            document.body.appendChild(notification);\r\n            \r\n            setTimeout(() => {\r\n                notification.remove();\r\n            }, 3000);\r\n        }\r\n\r\n        // Suggested groups helpers\r\n        async function showSuggestedGroups(score){\r\n            const section = document.getElementById('suggestedGroupsSection');\r\n            const tbody = document.getElementById('suggestedGroupsBody');\r\n            const hint = document.getElementById('suggestionHint');\r\n\r\n            const targetTypes = score > 25 ? ['IELTS'] : ['BEGINNER','PRE_IELTS'];\r\n            hint.textContent = score > 25 ? 'Score > 25 → Showing IELTS groups with available spots' : 'Score ≤ 25 → Showing BEGINNER and PRE_IELTS groups with available spots';\r\n\r\n            let groups = [];\r\n            try {\r\n                const res = await fetch('/v1/group/list');\r\n                groups = await res.json();\r\n            } catch (_) { groups = []; }\r\n\r\n            const availableGroups = groups.filter(g => targetTypes.includes(g.typeOfGroup) && (g.currentStudents || 0) < (g.maxStudents || 0));\r\n\r\n            const searchEl = document.getElementById('groupSearch');\r\n                const apply = () => {\r\n                const term = (searchEl.value || '').toLowerCase();\r\n                const data = term ? availableGroups.filter(g => (g.nameOfGroup||'').toLowerCase().includes(term)) : availableGroups;\r\n                tbody.innerHTML = '';\r\n                if (data.length === 0) {\r\n                    tbody.innerHTML = '<tr><td colspan=\"7\" class=\"no-data\">No available groups found</td></tr>';\r\n                    return;\r\n                }\r\n                data.forEach(g => {\r\n                    const tr = document.createElement('tr');\r\n                        const schedule = (g.lessonStartTime && g.lessonEndTime) ? `${g.lessonStartTime} - ${g.lessonEndTime}` : 'Not set';\r\n                        const days = g.lessonDays || '';\r\n                        tr.innerHTML = `\r\n                        <td>${g.id}</td>\r\n                        <td>${escapeHtml(g.nameOfGroup)||''}</td>\r\n                        <td>${escapeHtml(g.typeOfGroup)||''}</td>\r\n                        <td><div style=\"font-weight:500;\">${escapeHtml(schedule)}</div><div style=\"font-size:12px;color:#666;\">${escapeHtml(days)}</div></td>\r\n                        <td>${g.currentStudents ?? 0}</td>\r\n                        <td>${g.maxStudents ?? '—'}</td>\r\n                        <td>${escapeHtml(g.created_at)||'—'}</td>\r\n                    `;\r\n                    tbody.appendChild(tr);\r\n                });\r\n            };\r\n            apply();\r\n            searchEl.oninput = apply;\r\n            section.style.display = 'block';\r\n        }\r\n\r\n        function hideSuggestedGroups(){\r\n            document.getElementById('suggestedGroupsSection').style.display = 'none';\r\n            document.getElementById('suggestedGroupsBody').innerHTML = '';\r\n            document.getElementById('groupSearch').value = '';\r\n            document.getElementById('suggestionHint').textContent = '';\r\n        }\r\n\r\n        // Convert user to student\r\n        async function convertToStudent(userId, fullName, phoneNum) {\r\n            if (!confirm(`Convert ${fullName} to student and remove from new clients?`)) return;\r\n            \r\n            try {\r\n                const response = await fetch('/v1/student/convertFromUser', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        userId: userId,\r\n                        fullName: fullName,\r\n                        phoneNum: phoneNum\r\n                    })\r\n                });\r\n                \r\n                if (response.ok) {\r\n                    showNotification('Client converted to student and removed from new clients!', 'success');\r\n                    loadUsers(); // Reload the users list\r\n                } else {\r\n                    const error = await response.text();\r\n                    showNotification('Error: ' + error, 'error');\r\n                }\r\n            } catch (error) {\r\n                console.error('Error:', error);\r\n                showNotification('Error converting user to student', 'error');\r\n            }\r\n        }\r\n\r\n        // Group selection modal functions\r\n        let currentClientData = null;\r\n\r\n        function showGroupSelection(userId, fullName, phoneNum) {\r\n            currentClientData = { userId, fullName, phoneNum };\r\n            document.getElementById('modalClientName').textContent = fullName;\r\n            document.getElementById('groupSelectionModal').style.display = 'block';\r\n            document.getElementById('placementScore').value = '';\r\n            document.getElementById('groupSearchModal').value = '';\r\n            document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Enter placement test score to see available groups</td></tr>';\r\n        }\r\n\r\n        function closeGroupSelectionModal() {\r\n            document.getElementById('groupSelectionModal').style.display = 'none';\r\n            currentClientData = null;\r\n        }\r\n\r\n        // Load groups based on placement score\r\n        async function loadGroupsForModal() {\r\n            const score = Number(document.getElementById('placementScore').value || '0');\r\n            const searchTerm = document.getElementById('groupSearchModal').value.toLowerCase();\r\n            \r\n            if (score === 0) {\r\n                document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Enter placement test score to see available groups</td></tr>';\r\n                return;\r\n            }\r\n\r\n            try {\r\n                const response = await fetch('/v1/group/list');\r\n                const groups = await response.json();\r\n                \r\n                const targetTypes = score > 25 ? ['IELTS'] : ['BEGINNER', 'PRE_IELTS'];\r\n                const availableGroups = groups.filter(g => \r\n                    targetTypes.includes(g.typeOfGroup) && \r\n                    (g.currentStudents || 0) < (g.maxStudents || 0) &&\r\n                    (searchTerm === '' || (g.nameOfGroup || '').toLowerCase().includes(searchTerm))\r\n                );\r\n\r\n                const tbody = document.getElementById('modalGroupsBody');\r\n                tbody.innerHTML = '';\r\n\r\n                if (availableGroups.length === 0) {\r\n                    tbody.innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">No available groups found</td></tr>';\r\n                    return;\r\n                }\r\n\r\n                availableGroups.forEach(group => {\r\n                    const row = document.createElement('tr');\r\n                    row.innerHTML = `\r\n                        <td>${group.id}</td>\r\n                        <td>${escapeHtml(group.nameOfGroup || '')}</td>\r\n                        <td>${escapeHtml(group.typeOfGroup || '')}</td>\r\n                        <td>${group.currentStudents ?? 0}</td>\r\n                        <td>${group.maxStudents ?? '—'}</td>\r\n                        <td><button class=\"btn btn-success\" onclick=\"assignToGroup(${group.id}, '${escapeHtml(group.nameOfGroup || '')}')\">Assign</button></td>\r\n                    `;\r\n                    tbody.appendChild(row);\r\n                });\r\n            } catch (error) {\r\n                console.error('Error loading groups:', error);\r\n                document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Error loading groups</td></tr>';\r\n            }\r\n        }\r\n\r\n        // Assign client to group\r\n        async function assignToGroup(groupId, groupName) {\r\n            if (!currentClientData) return;\r\n            \r\n            if (!confirm(`Assign ${currentClientData.fullName} to group \"${groupName}\" and convert to student?`)) return;\r\n\r\n            try {\r\n                // First convert to student\r\n                const convertResponse = await fetch('/v1/student/convertFromUser', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        userId: currentClientData.userId,\r\n                        fullName: currentClientData.fullName,\r\n                        phoneNum: currentClientData.phoneNum\r\n                    })\r\n                });\r\n\r\n                if (!convertResponse.ok) {\r\n                    throw new Error('Failed to convert user to student');\r\n                }\r\n\r\n                const student = await convertResponse.json();\r\n\r\n                // Then assign to group\r\n                const assignResponse = await fetch(`/v1/student/addToGroup/${student.id}/${groupId}`, {\r\n                    method: 'POST'\r\n                });\r\n\r\n                if (assignResponse.ok) {\r\n                    showNotification(`${currentClientData.fullName} assigned to group \"${groupName}\" and converted to student!`, 'success');\r\n                    closeGroupSelectionModal();\r\n                    loadUsers(); // Reload the users list\r\n                } else {\r\n                    throw new Error('Failed to assign to group');\r\n                }\r\n            } catch (error) {\r\n                console.error('Error:', error);\r\n                showNotification('Error assigning to group: ' + error.message, 'error');\r\n            }\r\n        }\r\n\r\n        // Event listeners for modal\r\n        document.getElementById('placementScore').addEventListener('input', loadGroupsForModal);\r\n        document.getElementById('groupSearchModal').addEventListener('input', loadGroupsForModal);\r\n\r\n        // Logout function\r\n        async function logout() {\r\n            try {\r\n                await fetch('/v1/auth/logout', {\r\n                    method: 'POST',\r\n                    headers: {\r\n                        'Content-Type': 'application/json'\r\n                    }\r\n                });\r\n                showNotification('Logged out successfully', 'success');\r\n                setTimeout(() => {\r\n                    window.location.href = '/v1/auth/reception';\r\n                }, 1000);\r\n            } catch (error) {\r\n                console.error('Logout error:', error);\r\n                showNotification('Error during logout', 'error');\r\n            }\r\n        }\r\n    </script>\r\n\r\n    <style>\r\n        @keyframes slideIn {\r\n            from { transform: translateX(100%); opacity: 0; }\r\n            to { transform: translateX(0); opacity: 1; }\r\n        }\r\n\r\n        /* Modal Styles */\r\n        .modal {\r\n            position: fixed;\r\n            z-index: 1000;\r\n            left: 0;\r\n            top: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background-color: rgba(0, 0, 0, 0.5);\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        .modal-content {\r\n            background-color: white;\r\n            border-radius: 12px;\r\n            width: 90%;\r\n            max-width: 800px;\r\n            max-height: 90vh;\r\n            overflow-y: auto;\r\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\r\n        }\r\n\r\n        .modal-header {\r\n            padding: 20px;\r\n            border-bottom: 1px solid #e0e0e0;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: center;\r\n            background-color: #f8f9fa;\r\n            border-radius: 12px 12px 0 0;\r\n        }\r\n\r\n        .modal-header h3 {\r\n            margin: 0;\r\n            color: #333;\r\n            font-size: 1.4rem;\r\n        }\r\n\r\n        .close {\r\n            font-size: 28px;\r\n            font-weight: bold;\r\n            color: #aaa;\r\n            cursor: pointer;\r\n            line-height: 1;\r\n        }\r\n\r\n        .close:hover {\r\n            color: #000;\r\n        }\r\n\r\n        .modal-body {\r\n            padding: 20px;\r\n        }\r\n\r\n        .modal-body .form-group {\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        .modal-body .table-container {\r\n            margin-top: 20px;\r\n            max-height: 400px;\r\n            overflow-y: auto;\r\n        }\r\n\r\n        .modal-body table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n        .modal-body th,\r\n        .modal-body td {\r\n            padding: 12px;\r\n            text-align: left;\r\n            border-bottom: 1px solid #e0e0e0;\r\n        }\r\n\r\n        .modal-body th {\r\n            background-color: #f8f9fa;\r\n            font-weight: 600;\r\n            color: #333;\r\n        }\r\n\r\n        .modal-body .no-data {\r\n            text-align: center;\r\n            color: #666;\r\n            font-style: italic;\r\n            padding: 20px;\r\n        }\r\n\r\n        .btn-primary {\r\n            background-color: #007bff;\r\n            color: white;\r\n            border: none;\r\n            padding: 8px 16px;\r\n            border-radius: 6px;\r\n            cursor: pointer;\r\n            font-size: 14px;\r\n            font-weight: 500;\r\n            transition: background-color 0.2s;\r\n        }\r\n\r\n        .btn-primary:hover {\r\n            background-color: #0056b3;\r\n        }\r\n    </style>\r\n</body>\r\n</html>\r\n
