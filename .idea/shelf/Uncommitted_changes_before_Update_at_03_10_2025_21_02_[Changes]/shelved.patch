<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Students</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n    <main class=\"main-content\">\r\n<div class=\"container\">\r\n    <h1>Students</h1>\r\n\r\n    <div class=\"status-summary\" style=\"display:flex; gap:16px; flex-wrap:wrap; margin:16px 0;\">\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Total</h3>\r\n            <p id=\"statTotal\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Active</h3>\r\n            <p id=\"statActive\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>In register</h3>\r\n            <p id=\"statInRegister\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Stop learning</h3>\r\n            <p id=\"statStopped\">0</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\r\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search by name or phone\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:260px;\">\r\n        <select id=\"statusFilter\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\r\n            <option value=\"\">All statuses</option>\r\n            <option th:each=\"st : ${userStatuses}\" th:value=\"${st}\" th:text=\"${st}\"></option>\r\n        </select>\r\n    </div>\r\n\r\n    <div th:if=\"${#lists.isEmpty(students)}\">\r\n        <p>No students found.</p>\r\n    </div>\r\n\r\n    <div th:if=\"${!#lists.isEmpty(students)}\">\r\n        <table class=\"table\" style=\"width:100%; border-collapse: collapse;\">\r\n            <thead>\r\n            <tr>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">ID</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Full name</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Phone</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Status</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Created</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Actions</th>\r\n            </tr>\r\n            </thead>\r\n            <tbody id=\"studentsTableBody\"></tbody>\r\n        </table>\r\n    </div>\r\n</div>\r\n    </main>\r\n</div>\r\n\r\n<script th:inline=\"javascript\">\r\n    const API_BASE = '/v1/student';\r\n    let students = /*[[${students}]]*/ [];\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        if (!Array.isArray(students) || students.length === 0) {\r\n            loadStudents();\r\n        } else {\r\n            render(students);\r\n        }\r\n        document.getElementById('searchInput').addEventListener('input', applyFilters);\r\n        document.getElementById('statusFilter').addEventListener('change', applyFilters);\r\n    });\r\n\r\n    async function loadStudents() {\r\n        try {\r\n            const res = await fetch(`${API_BASE}/list`);\r\n            if (!res.ok) throw new Error(`HTTP ${res.status}`);\r\n            students = await res.json();\r\n            render(students);\r\n        } catch (e) {\r\n            console.error('Failed to load students', e);\r\n        }\r\n    }\r\n\r\n    function applyFilters() {\r\n        const term = document.getElementById('searchInput').value.toLowerCase().trim();\r\n        const status = document.getElementById('statusFilter').value;\r\n        let data = students.slice();\r\n        if (term) {\r\n            data = data.filter(s => (s.fullName || '').toLowerCase().includes(term) || (s.phoneNum || '').toLowerCase().includes(term));\r\n        }\r\n        if (status) {\r\n            data = data.filter(s => s.status === status);\r\n        }\r\n        render(data);\r\n    }\r\n\r\n    function render(data) {\r\n        const tbody = document.getElementById('studentsTableBody');\r\n        tbody.innerHTML = '';\r\n        if (!data || data.length === 0) {\r\n            tbody.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding:20px; color:#888;\">No students found</td></tr>`;\r\n        } else {\r\n            data.forEach(s => {\r\n                const tr = document.createElement('tr');\r\n                tr.innerHTML = `\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px;\">${s.id}</td>\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px;\">${escapeHtml(s.fullName) || ''}</td>\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px;\">${escapeHtml(s.phoneNum) || ''}</td>\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px;\"><span class=\"status ${statusClass(s.status)}\">${s.status || ''}</span></td>\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px;\">${formatDate(s.created_at)}</td>\r\n                    <td style=\"border-bottom:1px solid #f0f0f0; padding:8px; display:flex; gap:8px;\">\r\n                        <a href=\"/v1/student/details/${s.id}\" class=\"btn btn-sm\" style=\"background:#007bff; color:white; padding:4px 8px; text-decoration:none; border-radius:4px;\">Details</a>\r\n                        <a href=\"/v1/student/edit/${s.id}\" class=\"btn btn-sm\" style=\"background:#28a745; color:white; padding:4px 8px; text-decoration:none; border-radius:4px;\">Edit</a>\r\n                    </td>\r\n                `;\r\n                tbody.appendChild(tr);\r\n            });\r\n        }\r\n        updateStats(data || []);\r\n    }\r\n\r\n    function updateStats(list) {\r\n        const total = list.length;\r\n        const active = list.filter(s => s.status === 'ACTIVE').length;\r\n        const inRegister = list.filter(s => s.status === 'IN_REGISTER').length;\r\n        const stopped = list.filter(s => s.status === 'STOP_LEARNING').length;\r\n        document.getElementById('statTotal').textContent = total;\r\n        document.getElementById('statActive').textContent = active;\r\n        document.getElementById('statInRegister').textContent = inRegister;\r\n        document.getElementById('statStopped').textContent = stopped;\r\n    }\r\n\r\n    function statusClass(status) {\r\n        if (!status) return '';\r\n        const key = String(status).toLowerCase();\r\n        if (key === 'active') return 'active';\r\n        if (key === 'in_register') return 'in_register';\r\n        if (key === 'stop_learning') return 'stop_learning';\r\n        return '';\r\n    }\r\n\r\n    function formatDate(value) {\r\n        if (!value) return '';\r\n        try {\r\n            const d = new Date(value);\r\n            if (isNaN(d.getTime())) return String(value);\r\n            return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });\r\n        } catch (_) {\r\n            return String(value);\r\n        }\r\n    }\r\n\r\n    function escapeHtml(str) {\r\n        if (str == null) return '';\r\n        return String(str).replace(/[&<>\"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[s]));\r\n    }\r\n</script>\r\n</body>\r\n</html>\r\n
