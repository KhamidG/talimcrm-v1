<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Groups</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n    <main class=\"main-content\">\r\n        <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\r\n<div class=\"container\">\r\n\r\n    <h1>Groups</h1>\r\n\r\n    <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\r\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search by name or teacher\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:260px;\">\r\n        <select id=\"typeFilter\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\r\n            <option value=\"\">All types</option>\r\n                <option value=\"BEGINNER\">Beginner</option>\r\n                <option value=\"INTERMEDIATE\">Intermediate</option>\r\n                <option value=\"PRE_IELTS\">Pre-IELTS</option>\r\n                <option value=\"IELTS\">IELTS</option>\r\n                <option value=\"CEFR\">CEFR</option>\r\n            </select>\r\n        <select id=\"pageSize\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\r\n            <option value=\"10\">10 per page</option>\r\n            <option value=\"25\" selected>25 per page</option>\r\n            <option value=\"50\">50 per page</option>\r\n            <option value=\"100\">100 per page</option>\r\n            </select>\r\n        </div>\r\n\r\n    <table class=\"table\">\r\n                <thead>\r\n        <tr>\r\n            <th>ID</th>\r\n            <th>Name</th>\r\n            <th>Type</th>\r\n            <th>Teacher</th>\r\n            <th>Schedule</th>\r\n            <th>Students</th>\r\n            <th>Max</th>\r\n            <th>Created</th>\r\n            <th>Actions</th>\r\n                </tr>\r\n                </thead>\r\n        <tbody id=\"groupsTableBody\">\r\n            <!-- Groups will be loaded here -->\r\n        </tbody>\r\n            </table>\r\n            \r\n        <!-- Pagination Controls -->\r\n        <div id=\"paginationControls\" style=\"display:flex; justify-content:space-between; align-items:center; margin:20px 0; padding:10px 0;\">\r\n            <div id=\"paginationInfo\" style=\"color:#666; font-size:14px;\">\r\n                Showing <span id=\"showingStart\">0</span> to <span id=\"showingEnd\">0</span> of <span id=\"totalRecords\">0</span> entries\r\n            </div>\r\n            <div id=\"paginationButtons\" style=\"display:flex; gap:8px;\">\r\n                <button id=\"prevPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Previous</button>\r\n                <div id=\"pageNumbers\" style=\"display:flex; gap:4px;\"></div>\r\n                <button id=\"nextPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Next</button>\r\n            </div>\r\n        </div>\r\n</div>\r\n    </main>\r\n</div>\r\n<!-- Assign Teacher Modal -->\r\n<div id=\"assignTeacherModal\" class=\"modal\" style=\"display:none; position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,.4); align-items:center; justify-content:center;\">\r\n    <div class=\"modal-content\" style=\"background:#fff; border-radius:12px; padding:20px; width:90%; max-width:420px; position:relative; z-index:1;\">\r\n        <h3 style=\"margin-top:0;\">Assign teacher to group</h3>\r\n        <div style=\"margin:12px 0;\">\r\n            <label>Teacher</label>\r\n            <select id=\"assignTeacherSelect\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\"></select>\r\n        </div>\r\n        <div class=\"actions\" style=\"justify-content:flex-end;\">\r\n            <button class=\"action-btn\" type=\"button\" style=\"background:#ccc;\" onclick=\"closeAssignTeacherModal()\">Cancel</button>\r\n            <button class=\"action-btn edit-btn\" type=\"button\" onclick=\"confirmAssignTeacher()\">Assign</button>\r\n        </div>\r\n        <input type=\"hidden\" id=\"assignTeacherGroupId\" />\r\n    </div>\r\n    <div onclick=\"closeAssignTeacherModal()\" style=\"position:absolute; inset:0;\"></div>\r\n            </div>\r\n\r\n<!-- Add Student Modal -->\r\n<div id=\"addStudentModal\" class=\"modal\" style=\"display:none; position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,.4); align-items:center; justify-content:center;\">\r\n    <div class=\"modal-content\" style=\"background:#fff; border-radius:12px; padding:20px; width:90%; max-width:420px; position:relative; z-index:1;\">\r\n        <h3 style=\"margin-top:0;\">Add student to group</h3>\r\n        <div style=\"margin:12px 0;\">\r\n            <label>Student</label>\r\n            <select id=\"addStudentSelect\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\"></select>\r\n                </div>\r\n        <div class=\"actions\" style=\"justify-content:flex-end;\">\r\n            <button class=\"action-btn\" type=\"button\" style=\"background:#ccc;\" onclick=\"closeAddStudentModal()\">Cancel</button>\r\n            <button class=\"action-btn edit-btn\" type=\"button\" onclick=\"confirmAddStudent()\">Add</button>\r\n        </div>\r\n        <input type=\"hidden\" id=\"addStudentGroupId\" />\r\n    </div>\r\n    <div onclick=\"closeAddStudentModal()\" style=\"position:absolute; inset:0;\"></div>\r\n</div>\r\n\r\n<script>\r\n    const API_BASE = '/v1/group';\r\n    let groups = [];\r\n    let teachersCache = [];\r\n    let studentsCache = [];\r\n    let currentPage = 1;\r\n    let pageSize = 25;\r\n    let filteredData = [];\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        loadGroups();\r\n        document.getElementById('searchInput').addEventListener('input', applyFilters);\r\n        document.getElementById('typeFilter').addEventListener('change', applyFilters);\r\n        document.getElementById('pageSize').addEventListener('change', (e) => {\r\n            pageSize = parseInt(e.target.value);\r\n            currentPage = 1;\r\n            applyFilters();\r\n        });\r\n        document.getElementById('prevPage').addEventListener('click', () => {\r\n            if (currentPage > 1) {\r\n                currentPage--;\r\n                renderPage();\r\n            }\r\n        });\r\n        document.getElementById('nextPage').addEventListener('click', () => {\r\n            const totalPages = Math.ceil(filteredData.length / pageSize);\r\n            if (currentPage < totalPages) {\r\n                currentPage++;\r\n                renderPage();\r\n            }\r\n        });\r\n    });\r\n\r\n    async function loadGroups() {\r\n        try {\r\n            const res = await fetch(`${API_BASE}/list`);\r\n            if (!res.ok) throw new Error(`HTTP ${res.status}`);\r\n            groups = await res.json();\r\n            applyFilters();\r\n        } catch (e) {\r\n            console.error('Failed to load groups', e);\r\n        }\r\n    }\r\n\r\n    function applyFilters() {\r\n        const term = document.getElementById('searchInput').value.toLowerCase().trim();\r\n        const type = document.getElementById('typeFilter').value;\r\n        let data = groups.slice();\r\n        if (term) {\r\n            data = data.filter(g => \r\n                (g.nameOfGroup || '').toLowerCase().includes(term) || \r\n                (g.teacherFullName || '').toLowerCase().includes(term)\r\n            );\r\n        }\r\n        if (type) {\r\n            data = data.filter(g => g.typeOfGroup === type);\r\n        }\r\n        filteredData = data;\r\n        currentPage = 1;\r\n        renderPage();\r\n    }\r\n\r\n    function renderPage() {\r\n        const startIndex = (currentPage - 1) * pageSize;\r\n        const endIndex = startIndex + pageSize;\r\n        const pageData = filteredData.slice(startIndex, endIndex);\r\n        \r\n        const tbody = document.getElementById('groupsTableBody');\r\n        tbody.innerHTML = '';\r\n        if (!pageData || pageData.length === 0) {\r\n            tbody.innerHTML = `<tr><td colspan=\"9\" style=\"text-align:center; padding:20px; color:#888;\">No groups found</td></tr>`;\r\n        } else {\r\n            pageData.forEach(g => {\r\n                const tr = document.createElement('tr');\r\n                const schedule = (g.lessonStartTime && g.lessonEndTime) ? `${g.lessonStartTime} - ${g.lessonEndTime}` : 'Not set';\r\n                const days = g.lessonDays || '';\r\n                tr.innerHTML = `\r\n                    <td>${g.id}</td>\r\n                    <td>${escapeHtml(g.nameOfGroup || '—')}</td>\r\n                    <td>${escapeHtml(g.typeOfGroup || '—')}</td>\r\n                    <td>${escapeHtml(g.teacherFullName || '—')}</td>\r\n                    <td>\r\n                        <div style=\"font-weight:500;\">${escapeHtml(schedule)}</div>\r\n                        <div style=\"font-size:12px;color:#666;\">${escapeHtml(days)}</div>\r\n                    </td>\r\n                    <td>${g.currentStudents || 0}</td>\r\n                    <td>${g.maxStudents || '—'}</td>\r\n                    <td>${escapeHtml(g.created_at || '—')}</td>\r\n                    <td>\r\n                        <div class=\"actions\">\r\n                            <button class=\"action-btn edit-btn\" type=\"button\" data-group-id=\"${g.id}\" onclick=\"openAssignTeacherModal(this)\">Assign teacher</button>\r\n                            <button class=\"action-btn\" type=\"button\" style=\"background:#6c757d;color:#fff;\" data-group-id=\"${g.id}\" onclick=\"openAddStudentModal(this)\">Add student</button>\r\n                        </div>\r\n                </td>\r\n            `;\r\n                tbody.appendChild(tr);\r\n            });\r\n        }\r\n        updatePagination();\r\n    }\r\n\r\n    function updatePagination() {\r\n        const totalPages = Math.ceil(filteredData.length / pageSize);\r\n        const startIndex = (currentPage - 1) * pageSize;\r\n        const endIndex = Math.min(startIndex + pageSize, filteredData.length);\r\n        \r\n        // Update pagination info\r\n        document.getElementById('showingStart').textContent = filteredData.length > 0 ? startIndex + 1 : 0;\r\n        document.getElementById('showingEnd').textContent = endIndex;\r\n        document.getElementById('totalRecords').textContent = filteredData.length;\r\n        \r\n        // Update buttons\r\n        document.getElementById('prevPage').disabled = currentPage <= 1;\r\n        document.getElementById('nextPage').disabled = currentPage >= totalPages;\r\n        \r\n        // Update page numbers\r\n        const pageNumbersDiv = document.getElementById('pageNumbers');\r\n        pageNumbersDiv.innerHTML = '';\r\n        \r\n        const maxVisiblePages = 5;\r\n        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));\r\n        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);\r\n        \r\n        if (endPage - startPage + 1 < maxVisiblePages) {\r\n            startPage = Math.max(1, endPage - maxVisiblePages + 1);\r\n        }\r\n        \r\n        for (let i = startPage; i <= endPage; i++) {\r\n            const pageBtn = document.createElement('button');\r\n            pageBtn.textContent = i;\r\n            pageBtn.className = i === currentPage ? 'btn btn-primary' : 'btn btn-outline';\r\n            pageBtn.style.cssText = 'padding:8px 12px; border:1px solid #ddd; background:' + (i === currentPage ? '#007bff; color:white' : 'white') + '; border-radius:6px; cursor:pointer;';\r\n            pageBtn.addEventListener('click', () => {\r\n                currentPage = i;\r\n                renderPage();\r\n            });\r\n            pageNumbersDiv.appendChild(pageBtn);\r\n        }\r\n    }\r\n\r\n    async function openAssignTeacherModal(btn){\r\n        const groupId = btn.getAttribute('data-group-id');\r\n        document.getElementById('assignTeacherGroupId').value = groupId;\r\n        const modal = document.getElementById('assignTeacherModal');\r\n        modal.style.display = 'flex';\r\n        try {\r\n            if (teachersCache.length === 0) {\r\n                const res = await fetch('/v1/teacher/list');\r\n                if (!res.ok) throw new Error('Teacher list failed');\r\n                teachersCache = await res.json();\r\n            }\r\n            const sel = document.getElementById('assignTeacherSelect');\r\n            sel.innerHTML = teachersCache.map(t => `<option value=\"${t.id}\">${escapeHtml(t.fullName)||'—'} (${escapeHtml(t.phoneNum)||''})</option>`).join('');\r\n        } catch(e){ alert('Failed to load teachers'); }\r\n    }\r\n    function closeAssignTeacherModal(){ document.getElementById('assignTeacherModal').style.display='none'; }\r\n    async function confirmAssignTeacher(){\r\n        const groupId = document.getElementById('assignTeacherGroupId').value;\r\n        const teacherId = document.getElementById('assignTeacherSelect').value;\r\n        try{\r\n            const res = await fetch(`/v1/group/assignTeacher/${groupId}/${teacherId}`, { method:'POST' });\r\n            if (!res.ok) throw new Error(await res.text());\r\n            closeAssignTeacherModal();\r\n            loadGroups(); // Reload groups instead of full page reload\r\n        }catch(e){ alert(e.message || 'Failed to assign teacher'); }\r\n    }\r\n\r\n    async function openAddStudentModal(btn){\r\n        const groupId = btn.getAttribute('data-group-id');\r\n        document.getElementById('addStudentGroupId').value = groupId;\r\n        const modal = document.getElementById('addStudentModal');\r\n        modal.style.display = 'flex';\r\n        try {\r\n            if (studentsCache.length === 0) {\r\n                const res = await fetch('/v1/student/list');\r\n                if (!res.ok) throw new Error('Student list failed');\r\n                studentsCache = await res.json();\r\n            }\r\n            const sel = document.getElementById('addStudentSelect');\r\n            sel.innerHTML = studentsCache.map(s => `<option value=\"${s.id}\">${escapeHtml(s.fullName)||'—'} (${escapeHtml(s.phoneNum)||''})</option>`).join('');\r\n        } catch(e){ alert('Failed to load students'); }\r\n    }\r\n    function closeAddStudentModal(){ document.getElementById('addStudentModal').style.display='none'; }\r\n    async function confirmAddStudent(){\r\n        const groupId = document.getElementById('addStudentGroupId').value;\r\n        const studentId = document.getElementById('addStudentSelect').value;\r\n        try{\r\n            const res = await fetch(`/v1/student/addToGroup/${studentId}/${groupId}`, { method:'POST' });\r\n            if (!res.ok) throw new Error(await res.text());\r\n            closeAddStudentModal();\r\n            loadGroups(); // Reload groups instead of full page reload\r\n        }catch(e){ alert(e.message || 'Failed to add student'); }\r\n    }\r\n\r\n    function escapeHtml(s){ if(s==null) return ''; return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[c])); }\r\n// sidebar toggle\r\n(() => {\r\n  const sidebar = document.getElementById('sidebar');\r\n  const toggle = document.getElementById('sidebarToggle');\r\n  const key = 'talimcrm.sidebar.collapsed';\r\n  const apply = () => {\r\n    const collapsed = localStorage.getItem(key) === '1';\r\n    if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n  };\r\n  apply();\r\n  toggle.addEventListener('click', () => {\r\n    const collapsed = !(localStorage.getItem(key) === '1');\r\n    localStorage.setItem(key, collapsed ? '1' : '0');\r\n    apply();\r\n  });\r\n})();\r\n</script>\r\n</body>\r\n</html>
