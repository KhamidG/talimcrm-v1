<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Create Student</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n    <main class=\"main-content\">\r\n        <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\r\n<div class=\"container\">\r\n\r\n    <h1>Create Student</h1>\r\n\r\n    <form id=\"studentRegisterForm\" style=\"max-width:520px;\">\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Full name *</label>\r\n            <input type=\"text\" id=\"fullName\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"John Doe\" required>\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Phone *</label>\r\n            <input type=\"tel\" id=\"phoneNum\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"+998 xx xxx xx xx\" required>\r\n            </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Parent Name</label>\r\n            <input type=\"text\" id=\"parentName\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"Parent full name\">\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Parent Phone</label>\r\n            <input type=\"tel\" id=\"parentPhone\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"+998 xx xxx xx xx\">\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Placement test score (0-40)</label>\r\n            <input type=\"number\" id=\"testScore\" min=\"0\" max=\"40\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"e.g. 26\">\r\n            <small style=\"color:#666;\">If score > 25: show IELTS groups. Otherwise: BEGINNER and PRE_IELTS.</small>\r\n            </div>\r\n        <div class=\"actions\">\r\n            <button type=\"submit\" class=\"btn\">Create</button>\r\n            <a th:href=\"@{/v1/student/listPage}\" class=\"btn\" style=\"background:#e0e0e0; color:#333;\">Cancel</a>\r\n            </div>\r\n        </form>\r\n\r\n    <!-- Suggested Groups Section (shown after registration) -->\r\n    <div id=\"suggestions\" style=\"display:none; margin-top:24px;\">\r\n        <h2>Suggested empty groups</h2>\r\n        <p id=\"suggestionHint\" style=\"color:#666; margin-top:4px;\"></p>\r\n        <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\r\n            <input id=\"groupSearch\" type=\"text\" placeholder=\"Search groups\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:220px;\">\r\n        </div>\r\n        <table class=\"table\" style=\"width:100%; border-collapse: collapse;\">\r\n            <thead>\r\n            <tr>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">ID</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Name</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Type</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Students</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Max</th>\r\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Action</th>\r\n            </tr>\r\n            </thead>\r\n            <tbody id=\"suggestionsBody\"></tbody>\r\n        </table>\r\n    </div>\r\n    </div>\r\n</main>\r\n</div>\r\n\r\n<script>\r\n    const API = '/v1/student';\r\n    let createdStudentId = null;\r\n    let allGroups = [];\r\n\r\n    document.getElementById('studentRegisterForm').addEventListener('submit', async (e) => {\r\n        e.preventDefault();\r\n        const payload = {\r\n            fullName: document.getElementById('fullName').value.trim(),\r\n            phoneNum: document.getElementById('phoneNum').value.trim(),\r\n            parentName: document.getElementById('parentName').value.trim(),\r\n            parentPhone: document.getElementById('parentPhone').value.trim()\r\n        };\r\n        const res = await fetch(`${API}/register`, {\r\n            method: 'POST',\r\n            headers: { 'Content-Type': 'application/json' },\r\n            body: JSON.stringify(payload)\r\n        });\r\n        if (res.ok) {\r\n            const student = await res.json();\r\n            createdStudentId = student.id;\r\n            await showSuggestions();\r\n        } else {\r\n            alert('Failed to create student');\r\n        }\r\n    });\r\n\r\n    async function showSuggestions(){\r\n        if (allGroups.length === 0) {\r\n            try {\r\n                const res = await fetch('/v1/group/list');\r\n                allGroups = await res.json();\r\n            } catch(_) { allGroups = []; }\r\n        }\r\n        const score = Number(document.getElementById('testScore').value || '0');\r\n        const isIelts = score > 25;\r\n        const targetTypes = isIelts ? ['IELTS'] : ['BEGINNER','PRE_IELTS'];\r\n        document.getElementById('suggestionHint').textContent = isIelts ? 'Score > 25 → IELTS empty groups' : 'Score ≤ 25 → BEGINNER and PRE_IELTS empty groups';\r\n\r\n        const emptyGroups = allGroups.filter(g => targetTypes.includes(g.typeOfGroup) && (g.currentStudents === 0 || g.currentStudents == null));\r\n\r\n        const tbody = document.getElementById('suggestionsBody');\r\n        const search = document.getElementById('groupSearch').value?.toLowerCase?.() || '';\r\n        const filtered = search ? emptyGroups.filter(g => (g.nameOfGroup||'').toLowerCase().includes(search)) : emptyGroups;\r\n        tbody.innerHTML = '';\r\n        if (filtered.length === 0) {\r\n            tbody.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding:16px; color:#888;\">No empty groups found</td></tr>`;\r\n        } else {\r\n            filtered.forEach(g => {\r\n                const tr = document.createElement('tr');\r\n                tr.innerHTML = `\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.id}</td>\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${escapeHtml(g.nameOfGroup)||''}</td>\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${escapeHtml(g.typeOfGroup)||''}</td>\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.currentStudents ?? 0}</td>\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.maxStudents ?? '—'}</td>\r\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\"><button class=\\\"action-btn edit-btn\\\" data-group-id=\\\"${g.id}\\\">Assign</button></td>\r\n                `;\r\n                tbody.appendChild(tr);\r\n            });\r\n        }\r\n        tbody.querySelectorAll('button[data-group-id]').forEach(btn => {\r\n            btn.addEventListener('click', async () => {\r\n                const gid = btn.getAttribute('data-group-id');\r\n                if (!createdStudentId) return alert('Student not created');\r\n                try {\r\n                    const res = await fetch(`/v1/student/addToGroup/${createdStudentId}/${gid}`, { method: 'POST' });\r\n                    if (!res.ok) throw new Error(await res.text());\r\n                    alert('Student assigned to group');\r\n                } catch(e) {\r\n                    alert(e.message || 'Failed to assign');\r\n                }\r\n            });\r\n        });\r\n        document.getElementById('suggestions').style.display = 'block';\r\n        document.getElementById('groupSearch').oninput = showSuggestions;\r\n    }\r\n    // sidebar toggle\r\n    (() => {\r\n      const sidebar = document.getElementById('sidebar');\r\n      const toggle = document.getElementById('sidebarToggle');\r\n      const key = 'talimcrm.sidebar.collapsed';\r\n      const apply = () => {\r\n        const collapsed = localStorage.getItem(key) === '1';\r\n        if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n      };\r\n      apply();\r\n      toggle.addEventListener('click', () => {\r\n        const collapsed = !(localStorage.getItem(key) === '1');\r\n        localStorage.setItem(key, collapsed ? '1' : '0');\r\n        apply();\r\n      });\r\n    })();\r\n\r\n    function escapeHtml(str) {\r\n        if (str == null) return '';\r\n        return String(str).replace(/[&<>\"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[s]));\r\n    }\r\n</script>\r\n</body>\r\n</html>
