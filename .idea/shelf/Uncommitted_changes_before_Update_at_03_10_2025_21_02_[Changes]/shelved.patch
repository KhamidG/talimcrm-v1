ay: flex;\r\n            align-items: center;\r\n            margin-bottom: 16px;\r\n        }\r\n        \r\n        .stat-icon {\r\n            width: 48px;\r\n            height: 48px;\r\n            border-radius: 12px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-right: 16px;\r\n            font-size: 20px;\r\n            color: white;\r\n        }\r\n        \r\n        .stat-icon.students { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }\r\n        .stat-icon.groups { background: linear-gradient(135deg, #10b981, #059669); }\r\n        .stat-icon.teachers { background: linear-gradient(135deg, #f59e0b, #d97706); }\r\n        .stat-icon.revenue { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }\r\n        .stat-icon.reception { background: linear-gradient(135deg, #ef4444, #dc2626); }\r\n        \r\n        .stat-title {\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n            color: #64748b;\r\n            margin: 0;\r\n        }\r\n        \r\n        .stat-value {\r\n            font-size: 32px;\r\n            font-weight: 700;\r\n            color: #1e293b;\r\n            margin: 8px 0;\r\n        }\r\n        \r\n        .stat-change {\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 4px;\r\n        }\r\n        \r\n        .stat-change.positive { color: #10b981; }\r\n        .stat-change.negative { color: #ef4444; }\r\n        .stat-change.neutral { color: #64748b; }\r\n        \r\n        .charts-section {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\r\n            gap: 24px;\r\n            margin-bottom: 32px;\r\n        }\r\n        \r\n        .chart-card {\r\n            background: white;\r\n            border-radius: 16px;\r\n            padding: 24px;\r\n            box-shadow: 0 4px 20px rgba(0,0,0,0.08);\r\n            border: 1px solid #e2e8f0;\r\n        }\r\n        \r\n        .chart-header {\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .chart-header h3 {\r\n            margin: 0 0 4px 0;\r\n            font-size: 18px;\r\n            font-weight: 600;\r\n            color: #1e293b;\r\n        }\r\n        \r\n        .chart-header p {\r\n            margin: 0;\r\n            font-size: 14px;\r\n            color: #64748b;\r\n        }\r\n        \r\n        .chart-container {\r\n            position: relative;\r\n            height: 300px;\r\n        }\r\n        \r\n        .recent-section {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\r\n            gap: 24px;\r\n        }\r\n        \r\n        .recent-card {\r\n            background: white;\r\n            border-radius: 16px;\r\n            padding: 24px;\r\n            box-shadow: 0 4px 20px rgba(0,0,0,0.08);\r\n            border: 1px solid #e2e8f0;\r\n        }\r\n        \r\n        .recent-item {\r\n            display: flex;\r\n            align-items: center;\r\n            padding: 12px 0;\r\n            border-bottom: 1px solid #f1f5f9;\r\n        }\r\n        \r\n        .recent-item:last-child {\r\n            border-bottom: none;\r\n        }\r\n        \r\n        .recent-item-info {\r\n            flex: 1;\r\n        }\r\n        \r\n        .recent-item-name {\r\n            font-weight: 600;\r\n            color: #1e293b;\r\n            margin-bottom: 4px;\r\n        }\r\n        \r\n        .recent-item-meta {\r\n            font-size: 12px;\r\n            color: #64748b;\r\n        }\r\n        \r\n        .recent-item-status {\r\n            padding: 4px 12px;\r\n            border-radius: 20px;\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n        }\r\n        \r\n        .status-active { background: #dcfce7; color: #166534; }\r\n        .status-stopped { background: #fef2f2; color: #991b1b; }\r\n        .status-pending { background: #fef3c7; color: #92400e; }\r\n        .status-completed { background: #dcfce7; color: #166534; }\r\n        \r\n        .loading {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            padding: 40px;\r\n            color: #64748b;\r\n        }\r\n        \r\n        .error {\r\n            background: #fef2f2;\r\n            color: #991b1b;\r\n            padding: 16px;\r\n            border-radius: 8px;\r\n            margin: 16px 0;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n    \r\n    <main class=\"main-content\">\r\n        <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\r\n        \r\n        <div class=\"stats-container\">\r\n            <!-- Header -->\r\n            <div class=\"stats-header\">\r\n                <h1><i class=\"fas fa-chart-line\"></i> Statistics Dashboard</h1>\r\n                <p>Comprehensive overview of your educational center's performance</p>\r\n            </div>\r\n\r\n            <!-- Summary Cards -->\r\n            <div class=\"stats-grid\">\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-card-header\">\r\n                        <div class=\"stat-icon students\">\r\n                            <i class=\"fas fa-user-graduate\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <p class=\"stat-title\">Total Students</p>\r\n                            <div class=\"stat-value\" id=\"totalStudents\">-</div>\r\n                            <div class=\"stat-change neutral\">\r\n                                <i class=\"fas fa-users\"></i>\r\n                                <span>All time</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-card-header\">\r\n                        <div class=\"stat-icon students\">\r\n                            <i class=\"fas fa-check-circle\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <p class=\"stat-title\">Active Students</p>\r\n                            <div class=\"stat-value\" id=\"activeStudents\">-</div>\r\n                            <div class=\"stat-change positive\">\r\n                                <i class=\"fas fa-arrow-up\"></i>\r\n                                <span>Currently learning</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-card-header\">\r\n                        <div class=\"stat-icon groups\">\r\n                            <i class=\"fas fa-users\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <p class=\"stat-title\">Total Groups</p>\r\n                            <div class=\"stat-value\" id=\"totalGroups\">-</div>\r\n                            <div class=\"stat-change neutral\">\r\n                                <i class=\"fas fa-layer-group\"></i>\r\n                                <span>All groups</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-card-header\">\r\n                        <div class=\"stat-icon teachers\">\r\n                            <i class=\"fas fa-chalkboard-teacher\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <p class=\"stat-title\">Total Teachers</p>\r\n                            <div class=\"stat-value\" id=\"totalTeachers\">-</div>\r\n                            <div class=\"stat-change neutral\">\r\n                                <i class=\"fas fa-user-tie\"></i>\r\n                                <span>All teachers</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"stat-card\">\r\n                    <div class=\"stat-card-header\">\r\n                        <div class=\"stat-icon reception\">\r\n                            <i class=\"fas fa-clipboard-list\"></i>\r\n                        </div>\r\n                        <div>\r\n                            <p class=\"stat-title\">Reception Clients</p>\r\n                            <div class=\"stat-value\" id=\"receptionClients\">-</div>\r\n                            <div class=\"stat-change warning\">\r\n                                <i class=\"fas fa-clock\"></i>\r\n                                <span>Pending conversion</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Charts Section -->\r\n            <div class=\"charts-section\">\r\n                <div class=\"chart-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-chart-pie\"></i> Student Status Distribution</h3>\r\n                        <p>Current status breakdown</p>\r\n                    </div>\r\n                    <div class=\"chart-container\">\r\n                        <canvas id=\"statusChart\"></canvas>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"chart-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-chart-line\"></i> Monthly Registrations</h3>\r\n                        <p>New students over time</p>\r\n                    </div>\r\n                    <div class=\"chart-container\">\r\n                        <canvas id=\"registrationChart\"></canvas>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"chart-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-credit-card\"></i> Payment Types</h3>\r\n                        <p>Payment method distribution</p>\r\n                    </div>\r\n                    <div class=\"chart-container\">\r\n                        <canvas id=\"paymentTypeChart\"></canvas>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"chart-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-chart-area\"></i> Revenue Trend</h3>\r\n                        <p>Monthly revenue over time</p>\r\n                    </div>\r\n                    <div class=\"chart-container\">\r\n                        <canvas id=\"revenueChart\"></canvas>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Recent Activity -->\r\n            <div class=\"recent-section\">\r\n                <div class=\"recent-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-user-plus\"></i> Recent Students</h3>\r\n                        <p>Latest registrations</p>\r\n                    </div>\r\n                    <div id=\"recentStudents\" class=\"loading\">\r\n                        <i class=\"fas fa-spinner fa-spin\"></i> Loading...\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"recent-card\">\r\n                    <div class=\"chart-header\">\r\n                        <h3><i class=\"fas fa-credit-card\"></i> Recent Payments</h3>\r\n                        <p>Latest transactions</p>\r\n                    </div>\r\n                    <div id=\"recentPayments\" class=\"loading\">\r\n                        <i class=\"fas fa-spinner fa-spin\"></i> Loading...\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </main>\r\n</div>\r\n\r\n<script>\r\n    // Global variables\r\n    let statisticsData = null;\r\n    let chartData = null;\r\n\r\n    // Initialize the page\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        loadStatistics();\r\n        setupSidebarToggle();\r\n    });\r\n\r\n    // Load all statistics\r\n    async function loadStatistics() {\r\n        try {\r\n            // Load overview statistics\r\n            const statsResponse = await fetch('/v1/stats/overview');\r\n            if (statsResponse.ok) {\r\n                statisticsData = await statsResponse.json();\r\n                updateSummaryCards();\r\n            }\r\n\r\n            // Load chart data\r\n            const chartResponse = await fetch('/v1/stats/charts');\r\n            if (chartResponse.ok) {\r\n                chartData = await chartResponse.json();\r\n                renderCharts();\r\n            }\r\n\r\n            // Load recent data\r\n            loadRecentStudents();\r\n            loadRecentPayments();\r\n\r\n        } catch (error) {\r\n            console.error('Error loading statistics:', error);\r\n            showError('Failed to load statistics. Please refresh the page.');\r\n        }\r\n    }\r\n\r\n    // Update summary cards\r\n    function updateSummaryCards() {\r\n        if (!statisticsData) return;\r\n\r\n        document.getElementById('totalStudents').textContent = statisticsData.totalStudents || 0;\r\n        document.getElementById('activeStudents').textContent = statisticsData.activeStudents || 0;\r\n        document.getElementById('totalGroups').textContent = statisticsData.totalGroups || 0;\r\n        document.getElementById('totalTeachers').textContent = statisticsData.totalTeachers || 0;\r\n        document.getElementById('receptionClients').textContent = statisticsData.receptionClients || 0;\r\n    }\r\n\r\n    // Load recent students\r\n    async function loadRecentStudents() {\r\n        try {\r\n            const response = await fetch('/v1/stats/recent/students?limit=5');\r\n            if (response.ok) {\r\n                const students = await response.json();\r\n                renderRecentStudents(students);\r\n            }\r\n        } catch (error) {\r\n            console.error('Error loading recent students:', error);\r\n            document.getElementById('recentStudents').innerHTML = '<div class=\"error\">Failed to load recent students</div>';\r\n        }\r\n    }\r\n\r\n    // Load recent payments\r\n    async function loadRecentPayments() {\r\n        try {\r\n            const response = await fetch('/v1/stats/recent/payments?limit=5');\r\n            if (response.ok) {\r\n                const payments = await response.json();\r\n                renderRecentPayments(payments);\r\n            }\r\n        } catch (error) {\r\n            console.error('Error loading recent payments:', error);\r\n            document.getElementById('recentPayments').innerHTML = '<div class=\"error\">Failed to load recent payments</div>';\r\n        }\r\n    }\r\n\r\n    // Render recent students\r\n    function renderRecentStudents(students) {\r\n        const container = document.getElementById('recentStudents');\r\n        \r\n        if (students.length === 0) {\r\n            container.innerHTML = '<div style=\"text-align: center; color: #64748b; padding: 20px;\">No recent students</div>';\r\n            return;\r\n        }\r\n\r\n        container.innerHTML = students.map(student => `\r\n            <div class=\"recent-item\">\r\n                <div class=\"recent-item-info\">\r\n                    <div class=\"recent-item-name\">${escapeHtml(student.fullName || 'Unknown')}</div>\r\n                    <div class=\"recent-item-meta\">${escapeHtml(student.phoneNum || 'No phone')}</div>\r\n                </div>\r\n                <div class=\"recent-item-status status-${getStatusClass(student.status)}\">\r\n                    ${formatStatus(student.status)}\r\n                </div>\r\n            </div>\r\n        `).join('');\r\n    }\r\n\r\n    // Render recent payments\r\n    function renderRecentPayments(payments) {\r\n        const container = document.getElementById('recentPayments');\r\n        \r\n        if (payments.length === 0) {\r\n            container.innerHTML = '<div style=\"text-align: center; color: #64748b; padding: 20px;\">No recent payments</div>';\r\n            return;\r\n        }\r\n\r\n        container.innerHTML = payments.map(payment => `\r\n            <div class=\"recent-item\">\r\n                <div class=\"recent-item-info\">\r\n                    <div class=\"recent-item-name\">${formatCurrency(payment.sum || 0)}</div>\r\n                    <div class=\"recent-item-meta\">${formatPaymentType(payment.paymentType)}</div>\r\n                </div>\r\n                <div class=\"recent-item-status status-${getPaymentStatusClass(payment.paymentStatus)}\">\r\n                    ${formatPaymentStatus(payment.paymentStatus)}\r\n                </div>\r\n            </div>\r\n        `).join('');\r\n    }\r\n\r\n    // Render all charts\r\n    function renderCharts() {\r\n        if (!chartData) return;\r\n\r\n        renderStatusChart();\r\n        renderRegistrationChart();\r\n        renderPaymentTypeChart();\r\n        renderRevenueChart();\r\n    }\r\n\r\n    // Student status distribution chart\r\n    function renderStatusChart() {\r\n        const ctx = document.getElementById('statusChart').getContext('2d');\r\n        const statusData = chartData.studentStatus || {};\r\n\r\n        new Chart(ctx, {\r\n            type: 'doughnut',\r\n            data: {\r\n                labels: ['Active', 'Stopped Learning', 'In Register'],\r\n                datasets: [{\r\n                    data: [\r\n                        statusData.ACTIVE || 0,\r\n                        statusData.STOP_LEARNING || 0,\r\n                        statusData.IN_REGISTER || 0\r\n                    ],\r\n                    backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],\r\n                    borderWidth: 0,\r\n                    hoverOffset: 8\r\n                }]\r\n            },\r\n            options: {\r\n                responsive: true,\r\n                maintainAspectRatio: false,\r\n                plugins: {\r\n                    legend: {\r\n                        position: 'bottom',\r\n                        labels: {\r\n                            padding: 20,\r\n                            usePointStyle: true\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    // Monthly registration chart\r\n    function renderRegistrationChart() {\r\n        const ctx = document.getElementById('registrationChart').getContext('2d');\r\n        const registrationData = chartData.monthlyRegistrations || {};\r\n        const months = Object.keys(registrationData);\r\n        const values = Object.values(registrationData);\r\n\r\n        new Chart(ctx, {\r\n            type: 'line',\r\n            data: {\r\n                labels: months,\r\n                datasets: [{\r\n                    label: 'New Students',\r\n                    data: values,\r\n                    borderColor: '#3b82f6',\r\n                    backgroundColor: 'rgba(59, 130, 246, 0.1)',\r\n                    borderWidth: 3,\r\n                    fill: true,\r\n                    tension: 0.4\r\n                }]\r\n            },\r\n            options: {\r\n                responsive: true,\r\n                maintainAspectRatio: false,\r\n                plugins: {\r\n                    legend: {\r\n                        display: false\r\n                    }\r\n                },\r\n                scales: {\r\n                    y: {\r\n                        beginAtZero: true,\r\n                        grid: {\r\n                            color: 'rgba(0, 0, 0, 0.05)'\r\n                        }\r\n                    },\r\n                    x: {\r\n                        grid: {\r\n                            display: false\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    // Payment type chart\r\n    function renderPaymentTypeChart() {\r\n        const ctx = document.getElementById('paymentTypeChart').getContext('2d');\r\n        const paymentData = chartData.paymentTypes || {};\r\n        const types = Object.keys(paymentData);\r\n        const values = Object.values(paymentData);\r\n\r\n        new Chart(ctx, {\r\n            type: 'bar',\r\n            data: {\r\n                labels: types,\r\n                datasets: [{\r\n                    data: values,\r\n                    backgroundColor: ['#8b5cf6', '#06b6d4', '#10b981', '#f59e0b'],\r\n                    borderWidth: 0,\r\n                    borderRadius: 8\r\n                }]\r\n            },\r\n            options: {\r\n                responsive: true,\r\n                maintainAspectRatio: false,\r\n                plugins: {\r\n                    legend: {\r\n                        display: false\r\n                    }\r\n                },\r\n                scales: {\r\n                    y: {\r\n                        beginAtZero: true,\r\n                        grid: {\r\n                            color: 'rgba(0, 0, 0, 0.05)'\r\n                        }\r\n                    },\r\n                    x: {\r\n                        grid: {\r\n                            display: false\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    // Revenue chart\r\n    function renderRevenueChart() {\r\n        const ctx = document.getElementById('revenueChart').getContext('2d');\r\n        const revenueData = chartData.monthlyRevenue || {};\r\n        const months = Object.keys(revenueData);\r\n        const values = Object.values(revenueData);\r\n\r\n        new Chart(ctx, {\r\n            type: 'bar',\r\n            data: {\r\n                labels: months,\r\n                datasets: [{\r\n                    label: 'Revenue',\r\n                    data: values,\r\n                    backgroundColor: 'rgba(16, 185, 129, 0.8)',\r\n                    borderColor: '#10b981',\r\n                    borderWidth: 0,\r\n                    borderRadius: 8\r\n                }]\r\n            },\r\n            options: {\r\n                responsive: true,\r\n                maintainAspectRatio: false,\r\n                plugins: {\r\n                    legend: {\r\n                        display: false\r\n                    }\r\n                },\r\n                scales: {\r\n                    y: {\r\n                        beginAtZero: true,\r\n                        grid: {\r\n                            color: 'rgba(0, 0, 0, 0.05)'\r\n                        },\r\n                        ticks: {\r\n                            callback: function(value) {\r\n                                return '$' + value.toLocaleString();\r\n                            }\r\n                        }\r\n                    },\r\n                    x: {\r\n                        grid: {\r\n                            display: false\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    // Utility functions\r\n    function formatCurrency(amount) {\r\n        return '$' + Number(amount).toLocaleString();\r\n    }\r\n\r\n    function formatStatus(status) {\r\n        if (!status) return 'Unknown';\r\n        return status.replace('_', ' ').toLowerCase().replace(/\\b\\w/g, l => l.toUpperCase());\r\n    }\r\n\r\n    function formatPaymentType(type) {\r\n        if (!type) return 'Unknown';\r\n        return type.replace('_', ' ').toLowerCase().replace(/\\b\\w/g, l => l.toUpperCase());\r\n    }\r\n\r\n    function formatPaymentStatus(status) {\r\n        if (!status) return 'Unknown';\r\n        return status.replace('_', ' ').toLowerCase().replace(/\\b\\w/g, l => l.toUpperCase());\r\n    }\r\n\r\n    function getStatusClass(status) {\r\n        if (!status) return 'pending';\r\n        const s = status.toLowerCase();\r\n        if (s === 'active') return 'active';\r\n        if (s === 'stop_learning') return 'stopped';\r\n        if (s === 'in_register') return 'pending';\r\n        return 'pending';\r\n    }\r\n\r\n    function getPaymentStatusClass(status) {\r\n        if (!status) return 'pending';\r\n        const s = status.toLowerCase();\r\n        if (s === 'completed') return 'completed';\r\n        if (s === 'pending') return 'pending';\r\n        return 'pending';\r\n    }\r\n\r\n    function escapeHtml(text) {\r\n        if (!text) return '';\r\n        const div = document.createElement('div');\r\n        div.textContent = text;\r\n        return div.innerHTML;\r\n    }\r\n\r\n    function showError(message) {\r\n        const errorDiv = document.createElement('div');\r\n        errorDiv.className = 'error';\r\n        errorDiv.textContent = message;\r\n        document.querySelector('.stats-container').insertBefore(errorDiv, document.querySelector('.stats-grid'));\r\n    }\r\n\r\n    function setupSidebarToggle() {\r\n        const sidebar = document.getElementById('sidebar');\r\n        const toggle = document.getElementById('sidebarToggle');\r\n        const key = 'talimcrm.sidebar.collapsed';\r\n        \r\n        const apply = () => {\r\n            const collapsed = localStorage.getItem(key) === '1';\r\n            if (collapsed) sidebar.classList.add('collapsed'); \r\n            else sidebar.classList.remove('collapsed');\r\n        };\r\n        \r\n        apply();\r\n        toggle.addEventListener('click', () => {\r\n            const collapsed = !(localStorage.getItem(key) === '1');\r\n            localStorage.setItem(key, collapsed ? '1' : '0');\r\n            apply();\r\n        });\r\n    }\r\n</script>\r\n</body>\r\n</html>
