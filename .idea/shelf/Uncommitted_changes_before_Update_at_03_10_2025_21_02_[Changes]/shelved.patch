<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Create Group</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <aside class=\"sidebar\" id=\"sidebar\">\r\n        <div class=\"sidebar-header\">\r\n            Talim CRM\r\n        </div>\r\n        <nav class=\"sidebar-nav\">\r\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n        </nav>\r\n    </aside>\r\n    <main class=\"main-content\">\r\n        <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\r\n<div class=\"container\">\r\n\r\n    <h1>Create Group</h1>\r\n\r\n    <form id=\"groupRegisterForm\" style=\"max-width:520px;\">\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Name *</label>\r\n            <input type=\"text\" id=\"nameOfGroup\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"Group name\" required>\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Type *</label>\r\n            <select id=\"typeOfGroup\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" required>\r\n                <option value=\"BEGINNER\">Beginner</option>\r\n                <option value=\"INTERMEDIATE\">Intermediate</option>\r\n                <option value=\"PRE_IELTS\">Pre-IELTS</option>\r\n                <option value=\"IELTS\">IELTS</option>\r\n                <option value=\"CEFR\">CEFR</option>\r\n            </select>\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Max students</label>\r\n            <input type=\"number\" id=\"maxStudents\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"30\">\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Teacher</label>\r\n            <select id=\"teacherId\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\r\n                <option value=\"\">Select teacher</option>\r\n            </select>\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Lesson Start Time</label>\r\n            <input type=\"time\" id=\"lessonStartTime\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"16:00\">\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Lesson End Time</label>\r\n            <input type=\"time\" id=\"lessonEndTime\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"18:00\">\r\n        </div>\r\n        <div style=\"margin-bottom:12px;\">\r\n            <label>Lesson Days</label>\r\n            <div style=\"display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px;\">\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Monday\" name=\"lessonDays\">\r\n                    Monday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Tuesday\" name=\"lessonDays\">\r\n                    Tuesday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Wednesday\" name=\"lessonDays\">\r\n                    Wednesday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Thursday\" name=\"lessonDays\">\r\n                    Thursday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Friday\" name=\"lessonDays\">\r\n                    Friday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Saturday\" name=\"lessonDays\">\r\n                    Saturday\r\n                </label>\r\n                <label style=\"display: flex; align-items: center; gap: 4px;\">\r\n                    <input type=\"checkbox\" value=\"Sunday\" name=\"lessonDays\">\r\n                    Sunday\r\n                </label>\r\n            </div>\r\n        </div>\r\n        <div class=\"actions\">\r\n            <button type=\"submit\" class=\"btn\">Create</button>\r\n            <a th:href=\"@{/v1/group/listPage}\" class=\"btn\" style=\"background:#e0e0e0; color:#333;\">Cancel</a>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </main>\r\n    </div>\r\n\r\n<script>\r\n    const API = '/v1/group';\r\n    \r\n    // Load teachers on page load\r\n    document.addEventListener('DOMContentLoaded', async () => {\r\n        try {\r\n            const response = await fetch('/v1/teacher/list');\r\n            if (response.ok) {\r\n                const teachers = await response.json();\r\n                const teacherSelect = document.getElementById('teacherId');\r\n                teachers.forEach(teacher => {\r\n                    const option = document.createElement('option');\r\n                    option.value = teacher.id;\r\n                    option.textContent = teacher.fullName;\r\n                    teacherSelect.appendChild(option);\r\n                });\r\n            }\r\n        } catch (error) {\r\n            console.error('Failed to load teachers:', error);\r\n        }\r\n    });\r\n    \r\n    document.getElementById('groupRegisterForm').addEventListener('submit', async (e) => {\r\n        e.preventDefault();\r\n        \r\n        // Get selected lesson days\r\n        const selectedDays = Array.from(document.querySelectorAll('input[name=\"lessonDays\"]:checked'))\r\n            .map(checkbox => checkbox.value);\r\n        \r\n        const payload = {\r\n            nameOfGroup: document.getElementById('nameOfGroup').value.trim(),\r\n            typeOfGroup: document.getElementById('typeOfGroup').value,\r\n            maxStudents: document.getElementById('maxStudents').value ? parseInt(document.getElementById('maxStudents').value) : null,\r\n            teacherId: document.getElementById('teacherId').value ? parseInt(document.getElementById('teacherId').value) : null,\r\n            lessonStartTime: document.getElementById('lessonStartTime').value,\r\n            lessonEndTime: document.getElementById('lessonEndTime').value,\r\n            lessonDays: selectedDays.join(',')\r\n        };\r\n        \r\n        const res = await fetch(`${API}/register`, {\r\n            method: 'POST',\r\n            headers: { 'Content-Type': 'application/json' },\r\n            body: JSON.stringify(payload)\r\n        });\r\n        if (res.ok) {\r\n            window.location.href = '/v1/group/listPage';\r\n        } else {\r\n            alert('Failed to create group');\r\n        }\r\n    });\r\n// sidebar toggle\r\n(() => {\r\n  const sidebar = document.getElementById('sidebar');\r\n  const toggle = document.getElementById('sidebarToggle');\r\n  const key = 'talimcrm.sidebar.collapsed';\r\n  const apply = () => {\r\n    const collapsed = localStorage.getItem(key) === '1';\r\n    if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n  };\r\n  apply();\r\n  toggle.addEventListener('click', () => {\r\n    const collapsed = !(localStorage.getItem(key) === '1');\r\n    localStorage.setItem(key, collapsed ? '1' : '0');\r\n    apply();\r\n  });\r\n})();\r\n</script>\r\n</body>\r\n</html>\r\n\r\n
