tatIncome\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Total cash</h3>\r\n            <p id=\"statCash\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Total card</h3>\r\n            <p id=\"statCard\">0</p>\r\n        </div>\r\n        <div class=\"status-card\" style=\"flex:1; min-width:160px;\">\r\n            <h3>Payments count</h3>\r\n            <p id=\"statCount\">0</p>\r\n        </div>\r\n    </div>\r\n\r\n    <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n            <th>ID</th>\r\n            <th>Student ID</th>\r\n            <th>Amount</th>\r\n            <th>Type</th>\r\n            <th>Date</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody id=\"paymentsTableBody\">\r\n        <tr th:each=\"p : ${payments}\">\r\n            <td th:text=\"${p.id}\">1</td>\r\n            <td th:text=\"${p.student}\">10</td>\r\n            <td th:text=\"${p.sum}\">100000</td>\r\n            <td th:text=\"${p.paymentType}\">CASH</td>\r\n            <td th:text=\"${p.created_at}\">2025-01-01</td>\r\n        </tr>\r\n        <tr th:if=\"${#lists.isEmpty(payments)}\">\r\n            <td colspan=\"5\" style=\"text-align:center; padding:20px; color:#888;\">No payments</td>\r\n        </tr>\r\n        </tbody>\r\n    </table>\r\n</div>\r\n    </main>\r\n</div>\r\n\r\n<script th:inline=\"javascript\">\r\n    const payments = /*[[${payments}]]*/ [];\r\n    document.addEventListener('DOMContentLoaded', () => compute());\r\n    function compute(){\r\n        let income = 0, cash = 0, card = 0;\r\n        (payments||[]).forEach(p => {\r\n            const amount = Number(p.sum || 0);\r\n            income += amount;\r\n            if (p.paymentType === 'CASH') cash += amount; else if (p.paymentType === 'CARD') card += amount;\r\n        });\r\n        document.getElementById('statIncome').textContent = income.toLocaleString();\r\n        document.getElementById('statCash').textContent = cash.toLocaleString();\r\n        document.getElementById('statCard').textContent = card.toLocaleString();\r\n        document.getElementById('statCount').textContent = (payments||[]).length;\r\n    }\r\n</script>\r\n</body>\r\n</html>\r\n\r\n
