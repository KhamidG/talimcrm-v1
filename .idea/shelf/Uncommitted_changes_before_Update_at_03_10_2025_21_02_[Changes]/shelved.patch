<+><!DOCTYPE html>\r\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Monthly Payment Statistics - Talim CRM</title>\r\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\">\r\n    <link rel=\"stylesheet\" th:href=\"@{/monthly_payments.css}\">\r\n</head>\r\n<body>\r\n    <div class=\"app-container\">\r\n        <aside class=\"sidebar\" id=\"sidebar\">\r\n            <div class=\"sidebar-header\">\r\n                Talim CRM\r\n            </div>\r\n            <nav class=\"sidebar-nav\">\r\n                <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/createPage}\"><span>New Payment</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/stats/page}\"><span>Statistics</span></a>\r\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\r\n            </nav>\r\n        </aside>\r\n        \r\n        <main class=\"main-content\">\r\n            <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\r\n            <div class=\"monthly-stats-container\">\r\n                <h1>Monthly Payment Statistics</h1>\r\n                \r\n                <!-- Month Selection -->\r\n                <div class=\"month-selector\">\r\n                    <div class=\"card\">\r\n                        <h2>Select Month</h2>\r\n                        <div class=\"form-row\">\r\n                            <div class=\"form-group\">\r\n                                <label for=\"yearSelect\" class=\"form-label\">Year</label>\r\n                                <select id=\"yearSelect\" class=\"form-input\">\r\n                                    <!-- Years will be populated by JavaScript -->\r\n                                </select>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label for=\"monthSelect\" class=\"form-label\">Month</label>\r\n                                <select id=\"monthSelect\" class=\"form-input\">\r\n                                    <option value=\"0\">January</option>\r\n                                    <option value=\"1\">February</option>\r\n                                    <option value=\"2\">March</option>\r\n                                    <option value=\"3\">April</option>\r\n                                    <option value=\"4\">May</option>\r\n                                    <option value=\"5\">June</option>\r\n                                    <option value=\"6\">July</option>\r\n                                    <option value=\"7\">August</option>\r\n                                    <option value=\"8\">September</option>\r\n                                    <option value=\"9\">October</option>\r\n                                    <option value=\"10\">November</option>\r\n                                    <option value=\"11\">December</option>\r\n                                </select>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <button id=\"loadMonthData\" class=\"btn btn-primary\">Load Statistics</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Summary Cards -->\r\n                <div class=\"summary-cards\" id=\"summaryCards\" style=\"display: none;\">\r\n                    <div class=\"summary-card\">\r\n                        <div class=\"card-icon\">\uD83D\uDCB0</div>\r\n                        <div class=\"card-content\">\r\n                            <h3>Total Revenue</h3>\r\n                            <p class=\"card-number\" id=\"totalRevenue\">$0</p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"summary-card\">\r\n                        <div class=\"card-icon\">✅</div>\r\n                        <div class=\"card-content\">\r\n                            <h3>Paid Students</h3>\r\n                            <p class=\"card-number\" id=\"paidStudents\">0</p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"summary-card\">\r\n                        <div class=\"card-icon\">❌</div>\r\n                        <div class=\"card-content\">\r\n                            <h3>Not Paid</h3>\r\n                            <p class=\"card-number\" id=\"notPaidStudents\">0</p>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"summary-card\">\r\n                        <div class=\"card-icon\">\uD83D\uDCC5</div>\r\n                        <div class=\"card-content\">\r\n                            <h3>Selected Month</h3>\r\n                            <p class=\"card-number\" id=\"selectedMonth\">-</p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Paid Students Table -->\r\n                <div class=\"detailed-section\" id=\"detailedSection\" style=\"display: none;\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-header\">\r\n                            <h2>Paid Students for <span id=\"selectedMonthTitle\">Selected Month</span></h2>\r\n                            <div class=\"controls\">\r\n                                <input type=\"text\" id=\"searchPayments\" placeholder=\"Search by student ID...\" class=\"form-input\">\r\n                                <select id=\"statusFilter\" class=\"form-input\">\r\n                                    <option value=\"\">All Statuses</option>\r\n                                    <option value=\"PAID\">Paid</option>\r\n                                    <option value=\"NOT_PAID\">Not Paid</option>\r\n                                </select>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"table-container\">\r\n                            <table>\r\n                                <thead>\r\n                                    <tr>\r\n                                        <th>Payment ID</th>\r\n                                        <th>Student ID</th>\r\n                                        <th>Group ID</th>\r\n                                        <th>Amount</th>\r\n                                        <th>Payment Type</th>\r\n                                        <th>Status</th>\r\n                                        <th>Date</th>\r\n                                    </tr>\r\n                                </thead>\r\n                                <tbody id=\"paymentsTableBody\">\r\n                                    <!-- Payments will be loaded here -->\r\n                                </tbody>\r\n                            </table>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </main>\r\n    </div>\r\n\r\n    <script>\r\n        let allPayments = [];\r\n        let filteredPayments = [];\r\n        let currentYear = new Date().getFullYear();\r\n        let currentMonth = new Date().getMonth();\r\n\r\n        // Initialize page\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            initializeYearSelect();\r\n            setCurrentMonth();\r\n            loadAllPayments();\r\n        });\r\n\r\n        // Initialize year dropdown\r\n        function initializeYearSelect() {\r\n            const yearSelect = document.getElementById('yearSelect');\r\n            const currentYear = new Date().getFullYear();\r\n            \r\n            for (let year = currentYear - 2; year <= currentYear + 1; year++) {\r\n                const option = document.createElement('option');\r\n                option.value = year;\r\n                option.textContent = year;\r\n                if (year === currentYear) option.selected = true;\r\n                yearSelect.appendChild(option);\r\n            }\r\n        }\r\n\r\n        // Set current month as default\r\n        function setCurrentMonth() {\r\n            document.getElementById('monthSelect').value = currentMonth;\r\n        }\r\n\r\n        // Load all payments\r\n        async function loadAllPayments() {\r\n            try {\r\n                const response = await fetch('/v1/pay/all');\r\n                allPayments = await response.json();\r\n            } catch (error) {\r\n                console.error('Error loading payments:', error);\r\n                allPayments = [];\r\n            }\r\n        }\r\n\r\n        // Load month data button\r\n        document.getElementById('loadMonthData').addEventListener('click', function() {\r\n            const year = parseInt(document.getElementById('yearSelect').value);\r\n            const month = parseInt(document.getElementById('monthSelect').value);\r\n            loadMonthStatistics(year, month);\r\n        });\r\n\r\n        // Load statistics for selected month\r\n        function loadMonthStatistics(year, month) {\r\n            const monthPayments = allPayments.filter(payment => {\r\n                const paymentDate = new Date(payment.created_at);\r\n                return paymentDate.getFullYear() === year && paymentDate.getMonth() === month;\r\n            });\r\n\r\n            filteredPayments = monthPayments;\r\n            updateSummaryCards(monthPayments, year, month);\r\n            renderPaymentsTable(monthPayments);\r\n            \r\n            // Show sections\r\n            document.getElementById('summaryCards').style.display = 'block';\r\n            document.getElementById('detailedSection').style.display = 'block';\r\n        }\r\n\r\n        // Update summary cards\r\n        function updateSummaryCards(payments, year, month) {\r\n            const totalRevenue = payments.reduce((sum, p) => sum + (Number(p.sum) || 0), 0);\r\n            const paidStudents = payments.filter(p => p.paymentStatus === 'PAID').length;\r\n            const notPaidStudents = payments.filter(p => p.paymentStatus === 'NOT_PAID').length;\r\n            \r\n            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', \r\n                              'July', 'August', 'September', 'October', 'November', 'December'];\r\n            \r\n            document.getElementById('totalRevenue').textContent = '$' + totalRevenue.toLocaleString();\r\n            document.getElementById('paidStudents').textContent = paidStudents;\r\n            document.getElementById('notPaidStudents').textContent = notPaidStudents;\r\n            document.getElementById('selectedMonth').textContent = monthNames[month] + ' ' + year;\r\n            document.getElementById('selectedMonthTitle').textContent = monthNames[month] + ' ' + year;\r\n        }\r\n\r\n        // Render payments table\r\n        function renderPaymentsTable(payments) {\r\n            const tbody = document.getElementById('paymentsTableBody');\r\n            tbody.innerHTML = '';\r\n\r\n            if (payments.length === 0) {\r\n                tbody.innerHTML = '<tr><td colspan=\"7\" class=\"no-data\">No payments found for this month</td></tr>';\r\n                return;\r\n            }\r\n\r\n            payments.forEach(payment => {\r\n                const row = document.createElement('tr');\r\n                row.innerHTML = `\r\n                    <td>${payment.id}</td>\r\n                    <td>${payment.student || 'N/A'}</td>\r\n                    <td>${payment.groupId || 'N/A'}</td>\r\n                    <td>$${Number(payment.sum || 0).toLocaleString()}</td>\r\n                    <td><span class=\"status ${(payment.paymentType || '').toLowerCase()}\">${payment.paymentType || 'N/A'}</span></td>\r\n                    <td><span class=\"status ${(payment.paymentStatus || '').toLowerCase().replace('_', '-')}\">${payment.paymentStatus || 'N/A'}</span></td>\r\n                    <td>${formatDate(payment.created_at)}</td>\r\n                `;\r\n                tbody.appendChild(row);\r\n            });\r\n        }\r\n\r\n        // Search functionality\r\n        document.getElementById('searchPayments').addEventListener('input', function() {\r\n            const searchTerm = this.value.toLowerCase();\r\n            const statusFilter = document.getElementById('statusFilter').value;\r\n            \r\n            let filtered = filteredPayments.filter(payment => {\r\n                const matchesSearch = !searchTerm || \r\n                    String(payment.id).includes(searchTerm) ||\r\n                    String(payment.student || '').includes(searchTerm) ||\r\n                    String(payment.groupId || '').includes(searchTerm) ||\r\n                    String(payment.sum || '').includes(searchTerm);\r\n                \r\n                const matchesStatus = !statusFilter || payment.paymentStatus === statusFilter;\r\n                \r\n                return matchesSearch && matchesStatus;\r\n            });\r\n            \r\n            renderPaymentsTable(filtered);\r\n        });\r\n\r\n        // Status filter\r\n        document.getElementById('statusFilter').addEventListener('change', function() {\r\n            document.getElementById('searchPayments').dispatchEvent(new Event('input'));\r\n        });\r\n\r\n        // Utility functions\r\n        function formatDate(dateString) {\r\n            if (!dateString) return 'N/A';\r\n            const date = new Date(dateString);\r\n            return date.toLocaleDateString('en-GB', {\r\n                day: '2-digit',\r\n                month: '2-digit',\r\n                year: 'numeric',\r\n                hour: '2-digit',\r\n                minute: '2-digit'\r\n            });\r\n        }\r\n\r\n        // Sidebar toggle\r\n        (() => {\r\n            const sidebar = document.getElementById('sidebar');\r\n            const toggle = document.getElementById('sidebarToggle');\r\n            const key = 'talimcrm.sidebar.collapsed';\r\n            const apply = () => {\r\n                const collapsed = localStorage.getItem(key) === '1';\r\n                if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n            };\r\n            apply();\r\n            toggle.addEventListener('click', () => {\r\n                const collapsed = !(localStorage.getItem(key) === '1');\r\n                localStorage.setItem(key, collapsed ? '1' : '0');\r\n                apply();\r\n            });\r\n        })();\r\n    </script>\r\n</body>\r\n</html>\r\n
