= null or student.parentName == ''}\" style=\"grid-column: 1 / -1;\">\r\n                        <h3 style=\"color: #666; margin-bottom: 16px; border-bottom: 2px solid #ddd; padding-bottom: 8px;\">Parent Information</h3>\r\n                        <p style=\"color: #666; font-style: italic;\">No parent information provided</p>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div th:if=\"${student.group != null}\">\r\n                    <h3 style=\"color: #333; margin-bottom: 16px; border-bottom: 2px solid #ffc107; padding-bottom: 8px;\">Group Information</h3>\r\n                    <p style=\"margin: 8px 0;\"><strong>Group Name:</strong> <span th:text=\"${student.group.nameOfGroup}\"></span></p>\r\n                    <p style=\"margin: 8px 0;\"><strong>Group Type:</strong> <span th:text=\"${student.group.typeOfGroup}\"></span></p>\r\n                </div>\r\n                \r\n                <div th:if=\"${student.group == null}\">\r\n                    <h3 style=\"color: #666; margin-bottom: 16px; border-bottom: 2px solid #ddd; padding-bottom: 8px;\">Group Information</h3>\r\n                    <p style=\"color: #666; font-style: italic;\">Student is not assigned to any group</p>\r\n                </div>\r\n            </div>\r\n            \r\n            <div th:if=\"${student == null}\" class=\"error-message\" style=\"background: #f8d7da; color: #721c24; padding: 16px; border-radius: 8px; margin: 20px 0;\">\r\n                <h3>Student Not Found</h3>\r\n                <p>The requested student could not be found.</p>\r\n            </div>\r\n\r\n            <div class=\"details-actions\" style=\"margin-top: 24px; display: flex; gap: 12px;\">\r\n                <a th:href=\"@{/v1/student/listPage}\" class=\"btn\" style=\"background: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;\">Back to List</a>\r\n                <a th:href=\"@{/v1/student/edit/{id}(id=${student.id})}\" class=\"btn\" style=\"background: #28a745; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;\">Edit Student</a>\r\n            </div>\r\n        </div>\r\n    </main>\r\n</div>\r\n\r\n<script>\r\n    // sidebar toggle\r\n    (() => {\r\n      const sidebar = document.getElementById('sidebar');\r\n      const toggle = document.getElementById('sidebarToggle');\r\n      const key = 'talimcrm.sidebar.collapsed';\r\n      const apply = () => {\r\n        const collapsed = localStorage.getItem(key) === '1';\r\n        if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\r\n      };\r\n      apply();\r\n      toggle.addEventListener('click', () => {\r\n        const collapsed = !(localStorage.getItem(key) === '1');\r\n        localStorage.setItem(key, collapsed ? '1' : '0');\r\n        apply();\r\n      });\r\n    })();\r\n</script>\r\n</body>\r\n</html>
