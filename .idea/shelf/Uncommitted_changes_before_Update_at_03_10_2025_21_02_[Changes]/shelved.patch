xt-align:left; border-bottom:1px solid #ddd; padding:8px;\">Absent</th>\r\n                        <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">History</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody id=\"studentsBody\">\r\n                    <tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:#888;\">Loading...</td></tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </main>\r\n</div>\r\n<script>\r\n    // Get groupId from the URL path and validate\r\n    const pathParts = window.location.pathname.split('/');\r\n    const groupIdRaw = pathParts[pathParts.length - 2];\r\n    const groupId = Number(groupIdRaw);\r\n    \r\n    console.log('GroupId from URL:', groupIdRaw, 'parsed:', groupId);\r\n    console.log('Current URL:', window.location.pathname);\r\n    \r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        // Validate groupId\r\n        if (!Number.isFinite(groupId)) {\r\n            console.error('GroupId is invalid:', groupIdRaw);\r\n            const tbody = document.getElementById('studentsBody');\r\n            if (tbody) {\r\n                tbody.innerHTML = '<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:red;\">Error: Invalid Group ID</td></tr>';\r\n            }\r\n            return;\r\n        }\r\n\r\n        const teacherId = sessionStorage.getItem('teacherId');\r\n        if (!teacherId) {\r\n            alert('Please login first');\r\n            window.location.href = '/v1/teacher/login';\r\n            return;\r\n        }\r\n        \r\n        const today = new Date().toISOString().split('T')[0];\r\n        document.getElementById('attendanceDate').value = today;\r\n        loadStudents();\r\n        document.getElementById('saveBtn').addEventListener('click', saveAttendance);\r\n    });\r\n\r\n    async function loadStudents(){\r\n        try{\r\n            const teacherId = sessionStorage.getItem('teacherId');\r\n            if (!teacherId) {\r\n                document.getElementById('studentsBody').innerHTML = '<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:red;\">Please login first</td></tr>';\r\n                return;\r\n            }\r\n            \r\n            console.log('Loading students for group:', groupId, 'teacher:', teacherId);\r\n            const res = await fetch(`/v1/teacher/group/${groupId}/students`, { \r\n                headers: { 'X-Teacher-Id': teacherId } \r\n            });\r\n            \r\n            if (!res.ok) {\r\n                const errorText = await res.text();\r\n                console.error('Failed to load students:', res.status, errorText);\r\n                document.getElementById('studentsBody').innerHTML = `<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:red;\">Error: ${res.status} - ${errorText}</td></tr>`;\r\n                return;\r\n            }\r\n            \r\n            const students = await res.json();\r\n            console.log('Students loaded:', students);\r\n            const tbody = document.getElementById('studentsBody');\r\n            tbody.innerHTML = '';\r\n            \r\n            // Check if students is an array\r\n            if (!Array.isArray(students)) {\r\n                console.error('Students is not an array:', students);\r\n                tbody.innerHTML = '<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:red;\">Error: Invalid response format</td></tr>';\r\n                return;\r\n            }\r\n            \r\n            if(students.length === 0){\r\n                tbody.innerHTML = '<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:#888;\">No students in this group</td></tr>';\r\n                return;\r\n            }\r\n            students.forEach(s => {\r\n                const tr = document.createElement('tr');\r\n                tr.innerHTML = `\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\">${s.id}</td>\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\">${escapeHtml(s.fullName||'')}</td>\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\">${escapeHtml(s.phoneNum||'')}</td>\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\"><input type=\"radio\" name=\"att_${s.id}\" value=\"present\" checked></td>\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\"><input type=\"radio\" name=\"att_${s.id}\" value=\"absent\"></td>\r\n                    <td style=\"padding:8px; border-bottom:1px solid #f0f0f0;\"><a href=\"/v1/teacher/student/${s.id}/attendance/page\">View</a></td>\r\n                `;\r\n                tbody.appendChild(tr);\r\n            });\r\n        }catch(e){\r\n            console.error('Error loading students:', e);\r\n            document.getElementById('studentsBody').innerHTML = `<tr><td colspan=\"6\" style=\"padding:16px; text-align:center; color:red;\">Error: ${e.message}</td></tr>`;\r\n        }\r\n    }\r\n\r\n    async function saveAttendance(){\r\n        const date = document.getElementById('attendanceDate').value;\r\n        const rows = Array.from(document.querySelectorAll('#studentsBody tr'));\r\n        const payload = rows.map(row => {\r\n            const idCell = row.querySelector('td');\r\n            if(!idCell) return null;\r\n            const studentId = parseInt(idCell.textContent, 10);\r\n            const isPresent = row.querySelector(`input[name=\"att_${studentId}\"][value=\"present\"]`).checked;\r\n            return { studentId, groupId: groupId, attendanceDate: date, isPresent };\r\n        }).filter(Boolean);\r\n        try{\r\n            const teacherId = sessionStorage.getItem('teacherId');\r\n            const res = await fetch('/v1/teacher/attendance', {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json', 'X-Teacher-Id': teacherId },\r\n                body: JSON.stringify(payload)\r\n            });\r\n            if(res.ok){\r\n                alert('Saved');\r\n            }else{\r\n                alert('Failed');\r\n            }\r\n        }catch(e){ alert('Failed'); }\r\n    }\r\n\r\n    function escapeHtml(str){\r\n        if(str==null) return '';\r\n        return String(str).replace(/[&<>\"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[s]));\r\n    }\r\n</script>\r\n</body>\r\n</html>\r\n
