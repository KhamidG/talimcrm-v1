d=\"statusChart\"></canvas>\n                            </div>\n                        </div>\n\n                        <div class=\"chart-card\">\n                            <div class=\"chart-header\">\n                                <h3><i class=\"fas fa-chart-line\"></i> Monthly Registrations</h3>\n                                <p>New students over time</p>\n                            </div>\n                            <div class=\"chart-body\">\n                                <canvas id=\"registrationChart\"></canvas>\n                            </div>\n                        </div>\n\n                        <div class=\"chart-card\">\n                            <div class=\"chart-header\">\n                                <h3><i class=\"fas fa-credit-card\"></i> Payment Types</h3>\n                                <p>Payment method distribution</p>\n                            </div>\n                            <div class=\"chart-body\">\n                                <canvas id=\"paymentTypeChart\"></canvas>\n                            </div>\n                        </div>\n\n                        <div class=\"chart-card\">\n                            <div class=\"chart-header\">\n                                <h3><i class=\"fas fa-chart-area\"></i> Revenue Trend</h3>\n                                <p>Monthly revenue over time</p>\n                            </div>\n                            <div class=\"chart-body\">\n                                <canvas id=\"revenueChart\"></canvas>\n                            </div>\n                        </div>\n\n                        <div class=\"chart-card\">\n                            <div class=\"chart-header\">\n                                <h3><i class=\"fas fa-balance-scale\"></i> Reception vs Students</h3>\n                                <p>Client conversion overview</p>\n                            </div>\n                            <div class=\"chart-body\">\n                                <canvas id=\"receptionChart\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Detailed Statistics -->\n                <div class=\"detailed-stats\">\n                    <div class=\"stats-grid\">\n                        <div class=\"stats-card\">\n                            <div class=\"stats-header\">\n                                <h3><i class=\"fas fa-list\"></i> Recent Students</h3>\n                                <p>Latest registrations</p>\n                            </div>\n                            <div class=\"stats-body\">\n                                <div id=\"recentStudents\" class=\"stats-list\">\n                                    <!-- Recent students will be populated here -->\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"stats-card\">\n                            <div class=\"stats-header\">\n                                <h3><i class=\"fas fa-clipboard-list\"></i> Recent Reception Clients</h3>\n                                <p>New clients waiting</p>\n                            </div>\n                            <div class=\"stats-body\">\n                                <div id=\"recentReceptionClients\" class=\"stats-list\">\n                                    <!-- Recent reception clients will be populated here -->\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"stats-card\">\n                            <div class=\"stats-header\">\n                                <h3><i class=\"fas fa-credit-card\"></i> Recent Payments</h3>\n                                <p>Latest transactions</p>\n                            </div>\n                            <div class=\"stats-body\">\n                                <div id=\"recentPayments\" class=\"stats-list\">\n                                    <!-- Recent payments will be populated here -->\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script>\n        // Global variables\n        let studentsData = [];\n        let paymentsData = [];\n        let receptionData = [];\n        let selectedYear = new Date().getFullYear();\n        let selectedMonth = new Date().getMonth();\n\n        // Initialize the page\n        document.addEventListener('DOMContentLoaded', function() {\n            initializeYearSelector();\n            loadAllData();\n            setupEventListeners();\n        });\n\n        // Initialize year selector\n        function initializeYearSelector() {\n            const yearSelect = document.getElementById('yearSelect');\n            const currentYear = new Date().getFullYear();\n            \n            for (let year = currentYear - 5; year <= currentYear + 1; year++) {\n                const option = document.createElement('option');\n                option.value = year;\n                option.textContent = year;\n                if (year === currentYear) {\n                    option.selected = true;\n                }\n                yearSelect.appendChild(option);\n            }\n        }\n\n        // Setup event listeners\n        function setupEventListeners() {\n            document.getElementById('loadMonthStats').addEventListener('click', function() {\n                selectedYear = parseInt(document.getElementById('yearSelect').value);\n                selectedMonth = parseInt(document.getElementById('monthSelect').value);\n                updateMonthlyStats(selectedYear, selectedMonth);\n            });\n        }\n\n        // Load all data\n        async function loadAllData() {\n            await Promise.all([\n                loadStudents(),\n                loadPayments(),\n                loadReceptionData()\n            ]);\n            updateSummaryCards();\n            renderCharts();\n            renderDetailedStats();\n        }\n\n        // Load students data\n        async function loadStudents() {\n            try {\n                const response = await fetch('/v1/student/all');\n                studentsData = await response.json();\n            } catch (error) {\n                console.error('Error loading students:', error);\n                studentsData = [];\n            }\n        }\n\n        // Load payments data\n        async function loadPayments() {\n            try {\n                const response = await fetch('/v1/pay/all');\n                paymentsData = await response.json();\n            } catch (error) {\n                console.error('Error loading payments:', error);\n                paymentsData = [];\n            }\n        }\n\n        // Load reception data\n        async function loadReceptionData() {\n            try {\n                const response = await fetch('/v1/auth/users');\n                const allUsers = await response.json();\n                receptionData = allUsers.filter(user => user.status === 'IN_REGISTER');\n            } catch (error) {\n                console.error('Error loading reception data:', error);\n                receptionData = [];\n            }\n        }\n\n        // Update summary cards\n        function updateSummaryCards() {\n            const totalStudents = studentsData.length;\n            const activeStudents = studentsData.filter(s => s.status === 'ACTIVE').length;\n            const stoppedStudents = studentsData.filter(s => s.status === 'STOP_LEARNING').length;\n            const receptionClients = receptionData.length;\n\n            const totalRevenue = paymentsData.reduce((sum, p) => {\n                const amount = Number(p.sum) || 0;\n                return sum + amount;\n            }, 0);\n            const currentMonth = new Date().getMonth();\n            const currentYear = new Date().getFullYear();\n            const monthlyRevenue = paymentsData\n                .filter(p => {\n                    const paymentDate = new Date(p.created_at);\n                    return paymentDate.getMonth() === currentMonth && paymentDate.getFullYear() === currentYear;\n                })\n                .reduce((sum, p) => sum + (Number(p.sum) || 0), 0);\n\n            document.getElementById('totalStudents').textContent = totalStudents;\n            document.getElementById('activeStudents').textContent = activeStudents;\n            document.getElementById('stoppedStudents').textContent = stoppedStudents;\n            document.getElementById('receptionClients').textContent = receptionClients;\n            document.getElementById('totalRevenue').textContent = '$' + totalRevenue.toLocaleString();\n            document.getElementById('monthlyRevenue').textContent = '$' + monthlyRevenue.toLocaleString();\n            \n            // Initialize monthly stats with current month\n            updateMonthlyStats(currentYear, currentMonth);\n        }\n\n        // Update monthly statistics\n        function updateMonthlyStats(year, month) {\n            const newThisMonth = studentsData.filter(s => {\n                const createdDate = new Date(s.created_at);\n                return createdDate.getMonth() === month && createdDate.getFullYear() === year;\n            }).length;\n\n            const stoppedThisMonth = studentsData.filter(s => {\n                if (s.status !== 'STOP_LEARNING') return false;\n                const updatedDate = new Date(s.updated_at);\n                return updatedDate.getMonth() === month && updatedDate.getFullYear() === year;\n            }).length;\n\n            document.getElementById('newThisMonth').textContent = newThisMonth;\n            document.getElementById('stoppedThisMonth').textContent = stoppedThisMonth;\n        }\n\n        // Render all charts\n        function renderCharts() {\n            renderStatusChart();\n            renderRegistrationChart();\n            renderPaymentTypeChart();\n            renderRevenueChart();\n            renderReceptionChart();\n        }\n\n        // Student status distribution chart\n        function renderStatusChart() {\n            const ctx = document.getElementById('statusChart').getContext('2d');\n            const statusCounts = {\n                'ACTIVE': studentsData.filter(s => s.status === 'ACTIVE').length,\n                'STOP_LEARNING': studentsData.filter(s => s.status === 'STOP_LEARNING').length\n            };\n\n            new Chart(ctx, {\n                type: 'doughnut',\n                data: {\n                    labels: ['Active', 'Stop Learning'],\n                    datasets: [{\n                        data: Object.values(statusCounts),\n                        backgroundColor: ['#10B981', '#EF4444'],\n                        borderWidth: 0,\n                        hoverOffset: 4\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            position: 'bottom',\n                            labels: {\n                                padding: 20,\n                                usePointStyle: true\n                            }\n                        }\n                    }\n                }\n            });\n        }\n\n        // Monthly registration chart\n        function renderRegistrationChart() {\n            const ctx = document.getElementById('registrationChart').getContext('2d');\n            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n            const currentYear = new Date().getFullYear();\n            \n            const monthlyData = months.map((_, index) => {\n                return studentsData.filter(s => {\n                    const createdDate = new Date(s.created_at);\n                    return createdDate.getMonth() === index && createdDate.getFullYear() === currentYear;\n                }).length;\n            });\n\n            new Chart(ctx, {\n                type: 'line',\n                data: {\n                    labels: months,\n                    datasets: [{\n                        label: 'New Students',\n                        data: monthlyData,\n                        borderColor: '#3B82F6',\n                        backgroundColor: 'rgba(59, 130, 246, 0.1)',\n                        borderWidth: 3,\n                        fill: true,\n                        tension: 0.4\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            display: false\n                        }\n                    },\n                    scales: {\n                        y: {\n                            beginAtZero: true,\n                            grid: {\n                                color: 'rgba(0, 0, 0, 0.05)'\n                            }\n                        },\n                        x: {\n                            grid: {\n                                display: false\n                            }\n                        }\n                    }\n                }\n            });\n        }\n\n        // Payment type chart\n        function renderPaymentTypeChart() {\n            const ctx = document.getElementById('paymentTypeChart').getContext('2d');\n            const paymentTypes = {};\n            \n            paymentsData.forEach(payment => {\n                const type = payment.paymentType || 'Unknown';\n                paymentTypes[type] = (paymentTypes[type] || 0) + 1;\n            });\n\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: Object.keys(paymentTypes),\n                    datasets: [{\n                        data: Object.values(paymentTypes),\n                        backgroundColor: ['#8B5CF6', '#06B6D4', '#10B981', '#F59E0B'],\n                        borderWidth: 0,\n                        borderRadius: 8\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            display: false\n                        }\n                    },\n                    scales: {\n                        y: {\n                            beginAtZero: true,\n                            grid: {\n                                color: 'rgba(0, 0, 0, 0.05)'\n                            }\n                        },\n                        x: {\n                            grid: {\n                                display: false\n                            }\n                        }\n                    }\n                }\n            });\n        }\n\n        // Revenue chart\n        function renderRevenueChart() {\n            const ctx = document.getElementById('revenueChart').getContext('2d');\n            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n            const currentYear = new Date().getFullYear();\n            \n            const monthlyRevenue = months.map((_, index) => {\n                return paymentsData\n                    .filter(p => {\n                        const paymentDate = new Date(p.created_at);\n                        return paymentDate.getMonth() === index && paymentDate.getFullYear() === currentYear;\n                    })\n                    .reduce((sum, p) => sum + (Number(p.sum) || 0), 0);\n            });\n\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: months,\n                    datasets: [{\n                        label: 'Revenue',\n                        data: monthlyRevenue,\n                        backgroundColor: 'rgba(16, 185, 129, 0.8)',\n                        borderColor: '#10B981',\n                        borderWidth: 0,\n                        borderRadius: 8\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            display: false\n                        }\n                    },\n                    scales: {\n                        y: {\n                            beginAtZero: true,\n                            grid: {\n                                color: 'rgba(0, 0, 0, 0.05)'\n                            },\n                            ticks: {\n                                callback: function(value) {\n                                    return '$' + value.toLocaleString();\n                                }\n                            }\n                        },\n                        x: {\n                            grid: {\n                                display: false\n                            }\n                        }\n                    }\n                }\n            });\n        }\n\n        // Reception chart\n        function renderReceptionChart() {\n            const ctx = document.getElementById('receptionChart').getContext('2d');\n            const activeStudents = studentsData.filter(s => s.status === 'ACTIVE').length;\n            const receptionClients = receptionData.length;\n\n            new Chart(ctx, {\n                type: 'doughnut',\n                data: {\n                    labels: ['Active Students', 'Reception Clients'],\n                    datasets: [{\n                        data: [activeStudents, receptionClients],\n                        backgroundColor: ['#3B82F6', '#F59E0B'],\n                        borderWidth: 0,\n                        hoverOffset: 4\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: {\n                            position: 'bottom',\n                            labels: {\n                                padding: 20,\n                                usePointStyle: true\n                            }\n                        }\n                    }\n                }\n            });\n        }\n\n        // Render detailed statistics\n        function renderDetailedStats() {\n            renderRecentStudents();\n            renderRecentReceptionClients();\n            renderRecentPayments();\n        }\n\n        // Render recent students\n        function renderRecentStudents() {\n            const container = document.getElementById('recentStudents');\n            const recentStudents = studentsData\n                .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))\n                .slice(0, 5);\n\n            container.innerHTML = recentStudents.map(student => `\n                <div class=\"stats-item\">\n                    <div class=\"item-info\">\n                        <div class=\"item-name\">${student.fullName}</div>\n                        <div class=\"item-meta\">${student.phoneNum}</div>\n                    </div>\n                    <div class=\"item-status status-${student.status.toLowerCase().replace('_', '-')}\">\n                        ${student.status.replace('_', ' ')}\n                    </div>\n                </div>\n            `).join('');\n        }\n\n        // Render recent reception clients\n        function renderRecentReceptionClients() {\n            const container = document.getElementById('recentReceptionClients');\n            const recentClients = receptionData\n                .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))\n                .slice(0, 5);\n\n            container.innerHTML = recentClients.map(client => `\n                <div class=\"stats-item\">\n                    <div class=\"item-info\">\n                        <div class=\"item-name\">${client.fullName}</div>\n                        <div class=\"item-meta\">${client.phoneNum}</div>\n                    </div>\n                    <div class=\"item-status status-pending\">\n                        Pending\n                    </div>\n                </div>\n            `).join('');\n        }\n\n        // Render recent payments\n        function renderRecentPayments() {\n            const container = document.getElementById('recentPayments');\n            const recentPayments = paymentsData\n                .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))\n                .slice(0, 5);\n\n            container.innerHTML = recentPayments.map(payment => `\n                <div class=\"stats-item\">\n                    <div class=\"item-info\">\n                        <div class=\"item-name\">$${Number(payment.sum).toLocaleString()}</div>\n                        <div class=\"item-meta\">${payment.paymentType || 'Unknown'}</div>\n                    </div>\n                    <div class=\"item-status status-${payment.paymentStatus.toLowerCase().replace('_', '-')}\">\n                        ${payment.paymentStatus.replace('_', ' ')}\n                    </div>\n                </div>\n            `).join('');\n        }\n\n        // Sidebar toggle functionality\n        document.getElementById('sidebarToggle').addEventListener('click', function() {\n            const sidebar = document.getElementById('sidebar');\n            sidebar.classList.toggle('collapsed');\n        });\n    </script>\n</body>\n</html>
