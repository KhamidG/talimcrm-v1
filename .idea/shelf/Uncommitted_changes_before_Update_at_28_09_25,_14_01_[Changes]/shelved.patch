<+><!DOCTYPE html>\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Monthly Payment Statistics - Talim CRM</title>\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\">\n    <link rel=\"stylesheet\" th:href=\"@{/monthly_payments.css}\">\n</head>\n<body>\n    <div class=\"app-container\">\n        <aside class=\"sidebar\" id=\"sidebar\">\n            <div class=\"sidebar-header\">\n                <h2>\uD83D\uDCDA Talim CRM</h2>\n            </div>\n            <nav class=\"sidebar-nav\">\n                <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/statsPage}\"><span>Stats</span></a>\n                <a class=\"nav-link active\" th:href=\"@{/v1/pay/monthlyStatsPage}\"><span>Monthly Stats</span></a>\n            </nav>\n        </aside>\n        \n        <main class=\"main-content\">\n            <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\n            <div class=\"monthly-stats-container\">\n                <h1>Monthly Payment Statistics</h1>\n                \n                <!-- Month Selection -->\n                <div class=\"month-selector\">\n                    <div class=\"card\">\n                        <h2>Select Month</h2>\n                        <div class=\"form-row\">\n                            <div class=\"form-group\">\n                                <label for=\"yearSelect\" class=\"form-label\">Year</label>\n                                <select id=\"yearSelect\" class=\"form-input\">\n                                    <!-- Years will be populated by JavaScript -->\n                                </select>\n                            </div>\n                            <div class=\"form-group\">\n                                <label for=\"monthSelect\" class=\"form-label\">Month</label>\n                                <select id=\"monthSelect\" class=\"form-input\">\n                                    <option value=\"0\">January</option>\n                                    <option value=\"1\">February</option>\n                                    <option value=\"2\">March</option>\n                                    <option value=\"3\">April</option>\n                                    <option value=\"4\">May</option>\n                                    <option value=\"5\">June</option>\n                                    <option value=\"6\">July</option>\n                                    <option value=\"7\">August</option>\n                                    <option value=\"8\">September</option>\n                                    <option value=\"9\">October</option>\n                                    <option value=\"10\">November</option>\n                                    <option value=\"11\">December</option>\n                                </select>\n                            </div>\n                            <div class=\"form-group\">\n                                <button id=\"loadMonthData\" class=\"btn btn-primary\">Load Statistics</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Summary Cards -->\n                <div class=\"summary-cards\" id=\"summaryCards\" style=\"display: none;\">\n                    <div class=\"summary-card\">\n                        <div class=\"card-icon\">\uD83D\uDCB0</div>\n                        <div class=\"card-content\">\n                            <h3>Total Revenue</h3>\n                            <p class=\"card-number\" id=\"totalRevenue\">$0</p>\n                        </div>\n                    </div>\n                    <div class=\"summary-card\">\n                        <div class=\"card-icon\">✅</div>\n                        <div class=\"card-content\">\n                            <h3>Paid Students</h3>\n                            <p class=\"card-number\" id=\"paidStudents\">0</p>\n                        </div>\n                    </div>\n                    <div class=\"summary-card\">\n                        <div class=\"card-icon\">❌</div>\n                        <div class=\"card-content\">\n                            <h3>Not Paid</h3>\n                            <p class=\"card-number\" id=\"notPaidStudents\">0</p>\n                        </div>\n                    </div>\n                    <div class=\"summary-card\">\n                        <div class=\"card-icon\">\uD83D\uDCC5</div>\n                        <div class=\"card-content\">\n                            <h3>Selected Month</h3>\n                            <p class=\"card-number\" id=\"selectedMonth\">-</p>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Paid Students Table -->\n                <div class=\"detailed-section\" id=\"detailedSection\" style=\"display: none;\">\n                    <div class=\"card\">\n                        <div class=\"card-header\">\n                            <h2>Paid Students for <span id=\"selectedMonthTitle\">Selected Month</span></h2>\n                            <div class=\"controls\">\n                                <input type=\"text\" id=\"searchPayments\" placeholder=\"Search by student ID...\" class=\"form-input\">\n                                <select id=\"statusFilter\" class=\"form-input\">\n                                    <option value=\"\">All Statuses</option>\n                                    <option value=\"PAID\">Paid</option>\n                                    <option value=\"NOT_PAID\">Not Paid</option>\n                                </select>\n                            </div>\n                        </div>\n                        <div class=\"table-container\">\n                            <table>\n                                <thead>\n                                    <tr>\n                                        <th>Payment ID</th>\n                                        <th>Student ID</th>\n                                        <th>Group ID</th>\n                                        <th>Amount</th>\n                                        <th>Payment Type</th>\n                                        <th>Status</th>\n                                        <th>Date</th>\n                                    </tr>\n                                </thead>\n                                <tbody id=\"paymentsTableBody\">\n                                    <!-- Payments will be loaded here -->\n                                </tbody>\n                            </table>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script>\n        let allPayments = [];\n        let filteredPayments = [];\n        let currentYear = new Date().getFullYear();\n        let currentMonth = new Date().getMonth();\n\n        // Initialize page\n        document.addEventListener('DOMContentLoaded', function() {\n            initializeYearSelect();\n            setCurrentMonth();\n            loadAllPayments();\n        });\n\n        // Initialize year dropdown\n        function initializeYearSelect() {\n            const yearSelect = document.getElementById('yearSelect');\n            const currentYear = new Date().getFullYear();\n            \n            for (let year = currentYear - 2; year <= currentYear + 1; year++) {\n                const option = document.createElement('option');\n                option.value = year;\n                option.textContent = year;\n                if (year === currentYear) option.selected = true;\n                yearSelect.appendChild(option);\n            }\n        }\n\n        // Set current month as default\n        function setCurrentMonth() {\n            document.getElementById('monthSelect').value = currentMonth;\n        }\n\n        // Load all payments\n        async function loadAllPayments() {\n            try {\n                const response = await fetch('/v1/pay/all');\n                allPayments = await response.json();\n            } catch (error) {\n                console.error('Error loading payments:', error);\n                allPayments = [];\n            }\n        }\n\n        // Load month data button\n        document.getElementById('loadMonthData').addEventListener('click', function() {\n            const year = parseInt(document.getElementById('yearSelect').value);\n            const month = parseInt(document.getElementById('monthSelect').value);\n            loadMonthStatistics(year, month);\n        });\n\n        // Load statistics for selected month\n        function loadMonthStatistics(year, month) {\n            const monthPayments = allPayments.filter(payment => {\n                const paymentDate = new Date(payment.created_at);\n                return paymentDate.getFullYear() === year && paymentDate.getMonth() === month;\n            });\n\n            filteredPayments = monthPayments;\n            updateSummaryCards(monthPayments, year, month);\n            renderPaymentsTable(monthPayments);\n            \n            // Show sections\n            document.getElementById('summaryCards').style.display = 'block';\n            document.getElementById('detailedSection').style.display = 'block';\n        }\n\n        // Update summary cards\n        function updateSummaryCards(payments, year, month) {\n            const totalRevenue = payments.reduce((sum, p) => sum + (Number(p.sum) || 0), 0);\n            const paidStudents = payments.filter(p => p.paymentStatus === 'PAID').length;\n            const notPaidStudents = payments.filter(p => p.paymentStatus === 'NOT_PAID').length;\n            \n            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', \n                              'July', 'August', 'September', 'October', 'November', 'December'];\n            \n            document.getElementById('totalRevenue').textContent = '$' + totalRevenue.toLocaleString();\n            document.getElementById('paidStudents').textContent = paidStudents;\n            document.getElementById('notPaidStudents').textContent = notPaidStudents;\n            document.getElementById('selectedMonth').textContent = monthNames[month] + ' ' + year;\n            document.getElementById('selectedMonthTitle').textContent = monthNames[month] + ' ' + year;\n        }\n\n        // Render payments table\n        function renderPaymentsTable(payments) {\n            const tbody = document.getElementById('paymentsTableBody');\n            tbody.innerHTML = '';\n\n            if (payments.length === 0) {\n                tbody.innerHTML = '<tr><td colspan=\"7\" class=\"no-data\">No payments found for this month</td></tr>';\n                return;\n            }\n\n            payments.forEach(payment => {\n                const row = document.createElement('tr');\n                row.innerHTML = `\n                    <td>${payment.id}</td>\n                    <td>${payment.student || 'N/A'}</td>\n                    <td>${payment.groupId || 'N/A'}</td>\n                    <td>$${Number(payment.sum || 0).toLocaleString()}</td>\n                    <td><span class=\"status ${(payment.paymentType || '').toLowerCase()}\">${payment.paymentType || 'N/A'}</span></td>\n                    <td><span class=\"status ${(payment.paymentStatus || '').toLowerCase().replace('_', '-')}\">${payment.paymentStatus || 'N/A'}</span></td>\n                    <td>${formatDate(payment.created_at)}</td>\n                `;\n                tbody.appendChild(row);\n            });\n        }\n\n        // Search functionality\n        document.getElementById('searchPayments').addEventListener('input', function() {\n            const searchTerm = this.value.toLowerCase();\n            const statusFilter = document.getElementById('statusFilter').value;\n            \n            let filtered = filteredPayments.filter(payment => {\n                const matchesSearch = !searchTerm || \n                    String(payment.id).includes(searchTerm) ||\n                    String(payment.student || '').includes(searchTerm) ||\n                    String(payment.groupId || '').includes(searchTerm) ||\n                    String(payment.sum || '').includes(searchTerm);\n                \n                const matchesStatus = !statusFilter || payment.paymentStatus === statusFilter;\n                \n                return matchesSearch && matchesStatus;\n            });\n            \n            renderPaymentsTable(filtered);\n        });\n\n        // Status filter\n        document.getElementById('statusFilter').addEventListener('change', function() {\n            document.getElementById('searchPayments').dispatchEvent(new Event('input'));\n        });\n\n        // Utility functions\n        function formatDate(dateString) {\n            if (!dateString) return 'N/A';\n            const date = new Date(dateString);\n            return date.toLocaleDateString('en-GB', {\n                day: '2-digit',\n                month: '2-digit',\n                year: 'numeric',\n                hour: '2-digit',\n                minute: '2-digit'\n            });\n        }\n\n        // Sidebar toggle\n        (() => {\n            const sidebar = document.getElementById('sidebar');\n            const toggle = document.getElementById('sidebarToggle');\n            const key = 'talimcrm.sidebar.collapsed';\n            const apply = () => {\n                const collapsed = localStorage.getItem(key) === '1';\n                if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\n            };\n            apply();\n            toggle.addEventListener('click', () => {\n                const collapsed = !(localStorage.getItem(key) === '1');\n                localStorage.setItem(key, collapsed ? '1' : '0');\n                apply();\n            });\n        })();\n    </script>\n</body>\n</html>\n
