<+><!DOCTYPE html>\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Reception - Talim CRM</title>\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\">\n    <link rel=\"stylesheet\" th:href=\"@{/reception.css}\">\n</head>\n<body>\n    <div class=\"app-container\">\n        <aside class=\"sidebar\">\n            <div class=\"sidebar-header\">\n                <h2>\uD83D\uDCDA Talim CRM</h2>\n            </div>\n            <nav class=\"sidebar-nav\">\n                <a class=\"nav-link active\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\n                <a class=\"nav-link\" th:href=\"@{/v1/pay/statsPage}\"><span>Stats</span></a>\n            </nav>\n        </aside>\n        \n        <main class=\"main-content\">\n            <div class=\"reception-container\">\n                <h1>Reception Dashboard - New Clients</h1>\n                \n                <!-- Quick Registration Form -->\n                <div class=\"registration-section\">\n                    <div class=\"card\">\n                        <h2>Quick Registration</h2>\n                        <form id=\"quickRegisterForm\" class=\"registration-form\">\n                            <div class=\"form-row\">\n                                <div class=\"form-group\">\n                                    <label for=\"firstName\" class=\"form-label\">First Name</label>\n                                    <input type=\"text\" id=\"firstName\" name=\"firstName\" class=\"form-input\" required>\n                                </div>\n                                <div class=\"form-group\">\n                                    <label for=\"lastName\" class=\"form-label\">Last Name</label>\n                                    <input type=\"text\" id=\"lastName\" name=\"lastName\" class=\"form-input\" required>\n                                </div>\n                            </div>\n                            <div class=\"form-row\">\n                                <div class=\"form-group\">\n                                    <label for=\"phone\" class=\"form-label\">Phone</label>\n                                    <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" required>\n                                </div>\n                                <div class=\"form-group\">\n                                    <label for=\"role\" class=\"form-label\">Role</label>\n                                    <select id=\"role\" name=\"role\" class=\"form-input\" required>\n                                        <option value=\"\">Select Role</option>\n                                        <option value=\"STUDENT\">Student (Created with IN_REGISTER status)</option>\n                                        <option value=\"TEACHER\">Teacher</option>\n                                    </select>\n                                </div>\n                            </div>\n                            <div class=\"form-row\">\n                                <div class=\"form-group\">\n                                    <label for=\"testScore\" class=\"form-label\">Placement test score (0-40)</label>\n                                    <input type=\"number\" id=\"testScore\" name=\"testScore\" min=\"0\" max=\"40\" class=\"form-input\" placeholder=\"e.g. 26\">\n                                    <small style=\"color:#666;\">Used only for Students to suggest empty groups</small>\n                                </div>\n                            </div>\n                            <button type=\"submit\" class=\"btn btn-success\">Register User</button>\n                        </form>\n                    </div>\n                </div>\n\n                <!-- Suggested Groups (after student registration) -->\n                <div id=\"suggestedGroupsSection\" class=\"users-section\" style=\"display:none;\">\n                    <div class=\"card\">\n                        <div class=\"card-header\">\n                            <h2>Suggested empty groups</h2>\n                            <div class=\"controls\">\n                                <input type=\"text\" id=\"groupSearch\" placeholder=\"Search groups...\" class=\"form-input\">\n                            </div>\n                        </div>\n                        <div style=\"margin: -10px 0 10px 0; color:#666;\" id=\"suggestionHint\"></div>\n                        <div class=\"table-container\">\n                            <table>\n                                <thead>\n                                <tr>\n                                    <th>ID</th>\n                                    <th>Name</th>\n                                    <th>Type</th>\n                                    <th>Students</th>\n                                    <th>Max</th>\n                                    <th>Created</th>\n                                </tr>\n                                </thead>\n                                <tbody id=\"suggestedGroupsBody\"></tbody>\n                            </table>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Recent Users List -->\n                <div class=\"users-section\">\n                    <div class=\"card\">\n                        <div class=\"card-header\">\n                            <h2>New Clients (IN_REGISTER status)</h2>\n                            <div class=\"controls\">\n                                <input type=\"text\" id=\"searchUsers\" placeholder=\"Search users...\" class=\"form-input\">\n                                <select id=\"pageSize\" class=\"form-input\" style=\"margin-left: 10px;\">\n                                    <option value=\"10\">10 per page</option>\n                                    <option value=\"25\" selected>25 per page</option>\n                                    <option value=\"50\">50 per page</option>\n                                    <option value=\"100\">100 per page</option>\n                                </select>\n                            </div>\n                        </div>\n                        <div class=\"table-container\">\n                            <table id=\"usersTable\">\n                                <thead>\n                                    <tr>\n                                        <th>ID</th>\n                                        <th>Name</th>\n                                        <th>Phone</th>\n                                        <th>Role</th>\n                                        <th>Status</th>\n                                        <th>Created</th>\n                                        <th>Actions</th>\n                                    </tr>\n                                </thead>\n                                <tbody id=\"usersTableBody\">\n                                    <!-- Users will be loaded here -->\n                                </tbody>\n                            </table>\n                        </div>\n                        \n                        <!-- Pagination Controls -->\n                        <div id=\"paginationControls\" style=\"display:flex; justify-content:space-between; align-items:center; margin:20px 0; padding:10px 0;\">\n                            <div id=\"paginationInfo\" style=\"color:#666; font-size:14px;\">\n                                Showing <span id=\"showingStart\">0</span> to <span id=\"showingEnd\">0</span> of <span id=\"totalRecords\">0</span> entries\n                            </div>\n                            <div id=\"paginationButtons\" style=\"display:flex; gap:8px;\">\n                                <button id=\"prevPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Previous</button>\n                                <div id=\"pageNumbers\" style=\"display:flex; gap:4px;\"></div>\n                                <button id=\"nextPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Next</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <!-- Group Selection Modal -->\n    <div id=\"groupSelectionModal\" class=\"modal\" style=\"display: none;\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <h3>Choose Group for <span id=\"modalClientName\"></span></h3>\n                <span class=\"close\" onclick=\"closeGroupSelectionModal()\">&times;</span>\n            </div>\n            <div class=\"modal-body\">\n                <div class=\"form-group\">\n                    <label for=\"placementScore\" class=\"form-label\">Placement Test Score (0-40)</label>\n                    <input type=\"number\" id=\"placementScore\" min=\"0\" max=\"40\" class=\"form-input\" placeholder=\"Enter score\">\n                    <small style=\"color:#666;\">Score > 25 → IELTS groups with available spots, Score ≤ 25 → BEGINNER/PRE_IELTS groups with available spots</small>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"groupSearchModal\" class=\"form-label\">Search Groups</label>\n                    <input type=\"text\" id=\"groupSearchModal\" placeholder=\"Search groups...\" class=\"form-input\">\n                </div>\n                <div class=\"table-container\">\n                    <table>\n                        <thead>\n                            <tr>\n                                <th>ID</th>\n                                <th>Name</th>\n                                <th>Type</th>\n                                <th>Students</th>\n                                <th>Max</th>\n                                <th>Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"modalGroupsBody\">\n                            <!-- Groups will be loaded here -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        let allUsers = [];\n        let currentPage = 1;\n        let pageSize = 25;\n        let filteredData = [];\n\n        // Load users on page load\n        document.addEventListener('DOMContentLoaded', function() {\n            loadUsers();\n            document.getElementById('pageSize').addEventListener('change', (e) => {\n                pageSize = parseInt(e.target.value);\n                currentPage = 1;\n                applyFilters();\n            });\n            document.getElementById('prevPage').addEventListener('click', () => {\n                if (currentPage > 1) {\n                    currentPage--;\n                    renderPage();\n                }\n            });\n            document.getElementById('nextPage').addEventListener('click', () => {\n                const totalPages = Math.ceil(filteredData.length / pageSize);\n                if (currentPage < totalPages) {\n                    currentPage++;\n                    renderPage();\n                }\n            });\n        });\n\n        // Quick registration form\n        let isSubmitting = false;\n        document.getElementById('quickRegisterForm').addEventListener('submit', function(e) {\n            e.preventDefault();\n            if (isSubmitting) return; // prevent double submit\n            isSubmitting = true;\n\n            const formData = new FormData(this);\n            const userData = {\n                fullName: formData.get('firstName') + ' ' + formData.get('lastName'),\n                phoneNum: formData.get('phone'),\n                roles: formData.get('role')\n            };\n            const scoreValue = Number(document.getElementById('testScore').value || '0'); // capture before reset\n            const submitBtn = this.querySelector('button[type=\"submit\"]');\n            if (submitBtn) submitBtn.disabled = true;\n\n            fetch('/v1/auth/register', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify(userData)\n            })\n            .then(async response => {\n                if (!response.ok) {\n                    const msg = await response.text();\n                    throw new Error(msg || 'Request failed');\n                }\n                return response.json();\n            })\n            .then(async dto => {\n                showNotification('New client registered successfully!', 'success');\n                this.reset();\n                loadUsers();\n                \n                // If role is STUDENT, show suggested groups for manual assignment\n                if ((userData.roles || '').toUpperCase() === 'STUDENT') {\n                    await showSuggestedGroups(scoreValue);\n                } else {\n                    hideSuggestedGroups();\n                }\n            })\n            .catch(error => {\n                console.error('Error:', error);\n                showNotification('Error registering user', 'error');\n            })\n            .finally(() => {\n                isSubmitting = false;\n                if (submitBtn) submitBtn.disabled = false;\n            });\n        });\n\n        // Load users from API\n        function loadUsers() {\n            fetch('/v1/auth/users')\n                .then(response => response.json())\n                .then(data => {\n                    allUsers = Array.isArray(data) ? data : [];\n                    applyFilters();\n                })\n                .catch(error => {\n                    console.error('Error:', error);\n                });\n        }\n\n        // Apply filters and pagination\n        function applyFilters() {\n            const searchTerm = document.getElementById('searchUsers').value.toLowerCase();\n            const filteredUsers = allUsers.filter(user => \n                (user.fullName && user.fullName.toLowerCase().includes(searchTerm)) ||\n                (user.phoneNum && user.phoneNum.includes(searchTerm)) ||\n                (user.roles && user.roles.toLowerCase().includes(searchTerm))\n            );\n            filteredData = filteredUsers;\n            currentPage = 1;\n            renderPage();\n        }\n\n        // Render users table with pagination\n        function renderPage() {\n            const startIndex = (currentPage - 1) * pageSize;\n            const endIndex = startIndex + pageSize;\n            const pageData = filteredData.slice(startIndex, endIndex);\n            \n            const tbody = document.getElementById('usersTableBody');\n            tbody.innerHTML = '';\n\n            if (pageData.length === 0) {\n                tbody.innerHTML = '<tr><td colspan=\"7\" class=\"no-data\">No users found</td></tr>';\n            } else {\n                pageData.forEach(user => {\n                    const row = document.createElement('tr');\n                    row.innerHTML = `\n                        <td>${user.id}</td>\n                        <td>${escapeHtml(user.fullName || 'N/A')}</td>\n                        <td>${escapeHtml(user.phoneNum || 'N/A')}</td>\n                        <td>${escapeHtml(user.roles || 'N/A')}</td>\n                        <td><span class=\"status ${user.status === 'IN_REGISTER' ? 'in_register' : 'active'}\">${user.status || 'ACTIVE'}</span></td>\n                        <td>${formatDate(user.created_at)}</td>\n                        <td>\n                            ${user.status === 'IN_REGISTER' ? \n                                `<button class=\"btn btn-primary\" onclick=\"showGroupSelection(${user.id}, '${escapeHtml(user.fullName)}', '${escapeHtml(user.phoneNum)}')\">Choose Group</button>` : \n                                user.roles === 'NEW_USER' ? \n                                    `<button class=\"btn btn-success\" onclick=\"convertToStudent(${user.id}, '${escapeHtml(user.fullName)}', '${escapeHtml(user.phoneNum)}')\">Add to Students</button>` : \n                                    '<span style=\"color: #999;\">Already converted</span>'\n                            }\n                        </td>\n                    `;\n                    tbody.appendChild(row);\n                });\n            }\n            updatePagination();\n        }\n\n        // Update pagination controls\n        function updatePagination() {\n            const totalPages = Math.ceil(filteredData.length / pageSize);\n            const startIndex = (currentPage - 1) * pageSize;\n            const endIndex = Math.min(startIndex + pageSize, filteredData.length);\n            \n            // Update pagination info\n            document.getElementById('showingStart').textContent = filteredData.length > 0 ? startIndex + 1 : 0;\n            document.getElementById('showingEnd').textContent = endIndex;\n            document.getElementById('totalRecords').textContent = filteredData.length;\n            \n            // Update buttons\n            document.getElementById('prevPage').disabled = currentPage <= 1;\n            document.getElementById('nextPage').disabled = currentPage >= totalPages;\n            \n            // Update page numbers\n            const pageNumbersDiv = document.getElementById('pageNumbers');\n            pageNumbersDiv.innerHTML = '';\n            \n            const maxVisiblePages = 5;\n            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));\n            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);\n            \n            if (endPage - startPage + 1 < maxVisiblePages) {\n                startPage = Math.max(1, endPage - maxVisiblePages + 1);\n            }\n            \n            for (let i = startPage; i <= endPage; i++) {\n                const pageBtn = document.createElement('button');\n                pageBtn.textContent = i;\n                pageBtn.className = i === currentPage ? 'btn btn-primary' : 'btn btn-outline';\n                pageBtn.style.cssText = 'padding:8px 12px; border:1px solid #ddd; background:' + (i === currentPage ? '#007bff; color:white' : 'white') + '; border-radius:6px; cursor:pointer;';\n                pageBtn.addEventListener('click', () => {\n                    currentPage = i;\n                    renderPage();\n                });\n                pageNumbersDiv.appendChild(pageBtn);\n            }\n        }\n\n        // Search functionality\n        document.getElementById('searchUsers').addEventListener('input', applyFilters);\n\n        // Utility functions\n        function formatDate(dateString) {\n            if (!dateString) return 'N/A';\n            const date = new Date(dateString);\n            return date.toLocaleDateString('en-GB', {\n                day: '2-digit',\n                month: '2-digit',\n                year: 'numeric',\n                hour: '2-digit',\n                minute: '2-digit'\n            });\n        }\n\n        function escapeHtml(text) {\n            const div = document.createElement('div');\n            div.textContent = text;\n            return div.innerHTML;\n        }\n\n        function showNotification(message, type) {\n            const notification = document.createElement('div');\n            notification.className = `notification ${type}`;\n            notification.textContent = message;\n            notification.style.cssText = `\n                position: fixed;\n                top: 20px;\n                right: 20px;\n                padding: 15px 20px;\n                border-radius: 8px;\n                color: white;\n                font-weight: 600;\n                z-index: 1000;\n                animation: slideIn 0.3s ease-out;\n            `;\n            \n            if (type === 'success') {\n                notification.style.backgroundColor = '#4CAF50';\n            } else if (type === 'warning') {\n                notification.style.backgroundColor = '#ff9800';\n            } else {\n                notification.style.backgroundColor = '#f44336';\n            }\n            \n            document.body.appendChild(notification);\n            \n            setTimeout(() => {\n                notification.remove();\n            }, 3000);\n        }\n\n        // Suggested groups helpers\n        async function showSuggestedGroups(score){\n            const section = document.getElementById('suggestedGroupsSection');\n            const tbody = document.getElementById('suggestedGroupsBody');\n            const hint = document.getElementById('suggestionHint');\n\n            const targetTypes = score > 25 ? ['IELTS'] : ['BEGINNER','PRE_IELTS'];\n            hint.textContent = score > 25 ? 'Score > 25 → Showing IELTS groups with available spots' : 'Score ≤ 25 → Showing BEGINNER and PRE_IELTS groups with available spots';\n\n            let groups = [];\n            try {\n                const res = await fetch('/v1/group/list');\n                groups = await res.json();\n            } catch (_) { groups = []; }\n\n            const availableGroups = groups.filter(g => targetTypes.includes(g.typeOfGroup) && (g.currentStudents || 0) < (g.maxStudents || 0));\n\n            const searchEl = document.getElementById('groupSearch');\n            const apply = () => {\n                const term = (searchEl.value || '').toLowerCase();\n                const data = term ? availableGroups.filter(g => (g.nameOfGroup||'').toLowerCase().includes(term)) : availableGroups;\n                tbody.innerHTML = '';\n                if (data.length === 0) {\n                    tbody.innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">No available groups found</td></tr>';\n                    return;\n                }\n                data.forEach(g => {\n                    const tr = document.createElement('tr');\n                    tr.innerHTML = `\n                        <td>${g.id}</td>\n                        <td>${escapeHtml(g.nameOfGroup)||''}</td>\n                        <td>${escapeHtml(g.typeOfGroup)||''}</td>\n                        <td>${g.currentStudents ?? 0}</td>\n                        <td>${g.maxStudents ?? '—'}</td>\n                        <td>${escapeHtml(g.created_at)||'—'}</td>\n                    `;\n                    tbody.appendChild(tr);\n                });\n            };\n            apply();\n            searchEl.oninput = apply;\n            section.style.display = 'block';\n        }\n\n        function hideSuggestedGroups(){\n            document.getElementById('suggestedGroupsSection').style.display = 'none';\n            document.getElementById('suggestedGroupsBody').innerHTML = '';\n            document.getElementById('groupSearch').value = '';\n            document.getElementById('suggestionHint').textContent = '';\n        }\n\n        // Convert user to student\n        async function convertToStudent(userId, fullName, phoneNum) {\n            if (!confirm(`Convert ${fullName} to student and remove from new clients?`)) return;\n            \n            try {\n                const response = await fetch('/v1/student/convertFromUser', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({\n                        userId: userId,\n                        fullName: fullName,\n                        phoneNum: phoneNum\n                    })\n                });\n                \n                if (response.ok) {\n                    showNotification('Client converted to student and removed from new clients!', 'success');\n                    loadUsers(); // Reload the users list\n                } else {\n                    const error = await response.text();\n                    showNotification('Error: ' + error, 'error');\n                }\n            } catch (error) {\n                console.error('Error:', error);\n                showNotification('Error converting user to student', 'error');\n            }\n        }\n\n        // Group selection modal functions\n        let currentClientData = null;\n\n        function showGroupSelection(userId, fullName, phoneNum) {\n            currentClientData = { userId, fullName, phoneNum };\n            document.getElementById('modalClientName').textContent = fullName;\n            document.getElementById('groupSelectionModal').style.display = 'block';\n            document.getElementById('placementScore').value = '';\n            document.getElementById('groupSearchModal').value = '';\n            document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Enter placement test score to see available groups</td></tr>';\n        }\n\n        function closeGroupSelectionModal() {\n            document.getElementById('groupSelectionModal').style.display = 'none';\n            currentClientData = null;\n        }\n\n        // Load groups based on placement score\n        async function loadGroupsForModal() {\n            const score = Number(document.getElementById('placementScore').value || '0');\n            const searchTerm = document.getElementById('groupSearchModal').value.toLowerCase();\n            \n            if (score === 0) {\n                document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Enter placement test score to see available groups</td></tr>';\n                return;\n            }\n\n            try {\n                const response = await fetch('/v1/group/list');\n                const groups = await response.json();\n                \n                const targetTypes = score > 25 ? ['IELTS'] : ['BEGINNER', 'PRE_IELTS'];\n                const availableGroups = groups.filter(g => \n                    targetTypes.includes(g.typeOfGroup) && \n                    (g.currentStudents || 0) < (g.maxStudents || 0) &&\n                    (searchTerm === '' || (g.nameOfGroup || '').toLowerCase().includes(searchTerm))\n                );\n\n                const tbody = document.getElementById('modalGroupsBody');\n                tbody.innerHTML = '';\n\n                if (availableGroups.length === 0) {\n                    tbody.innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">No available groups found</td></tr>';\n                    return;\n                }\n\n                availableGroups.forEach(group => {\n                    const row = document.createElement('tr');\n                    row.innerHTML = `\n                        <td>${group.id}</td>\n                        <td>${escapeHtml(group.nameOfGroup || '')}</td>\n                        <td>${escapeHtml(group.typeOfGroup || '')}</td>\n                        <td>${group.currentStudents ?? 0}</td>\n                        <td>${group.maxStudents ?? '—'}</td>\n                        <td><button class=\"btn btn-success\" onclick=\"assignToGroup(${group.id}, '${escapeHtml(group.nameOfGroup || '')}')\">Assign</button></td>\n                    `;\n                    tbody.appendChild(row);\n                });\n            } catch (error) {\n                console.error('Error loading groups:', error);\n                document.getElementById('modalGroupsBody').innerHTML = '<tr><td colspan=\"6\" class=\"no-data\">Error loading groups</td></tr>';\n            }\n        }\n\n        // Assign client to group\n        async function assignToGroup(groupId, groupName) {\n            if (!currentClientData) return;\n            \n            if (!confirm(`Assign ${currentClientData.fullName} to group \"${groupName}\" and convert to student?`)) return;\n\n            try {\n                // First convert to student\n                const convertResponse = await fetch('/v1/student/convertFromUser', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({\n                        userId: currentClientData.userId,\n                        fullName: currentClientData.fullName,\n                        phoneNum: currentClientData.phoneNum\n                    })\n                });\n\n                if (!convertResponse.ok) {\n                    throw new Error('Failed to convert user to student');\n                }\n\n                const student = await convertResponse.json();\n\n                // Then assign to group\n                const assignResponse = await fetch(`/v1/student/addToGroup/${student.id}/${groupId}`, {\n                    method: 'POST'\n                });\n\n                if (assignResponse.ok) {\n                    showNotification(`${currentClientData.fullName} assigned to group \"${groupName}\" and converted to student!`, 'success');\n                    closeGroupSelectionModal();\n                    loadUsers(); // Reload the users list\n                } else {\n                    throw new Error('Failed to assign to group');\n                }\n            } catch (error) {\n                console.error('Error:', error);\n                showNotification('Error assigning to group: ' + error.message, 'error');\n            }\n        }\n\n        // Event listeners for modal\n        document.getElementById('placementScore').addEventListener('input', loadGroupsForModal);\n        document.getElementById('groupSearchModal').addEventListener('input', loadGroupsForModal);\n    </script>\n\n    <style>\n        @keyframes slideIn {\n            from { transform: translateX(100%); opacity: 0; }\n            to { transform: translateX(0); opacity: 1; }\n        }\n\n        /* Modal Styles */\n        .modal {\n            position: fixed;\n            z-index: 1000;\n            left: 0;\n            top: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(0, 0, 0, 0.5);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .modal-content {\n            background-color: white;\n            border-radius: 12px;\n            width: 90%;\n            max-width: 800px;\n            max-height: 90vh;\n            overflow-y: auto;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n        }\n\n        .modal-header {\n            padding: 20px;\n            border-bottom: 1px solid #e0e0e0;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background-color: #f8f9fa;\n            border-radius: 12px 12px 0 0;\n        }\n\n        .modal-header h3 {\n            margin: 0;\n            color: #333;\n            font-size: 1.4rem;\n        }\n\n        .close {\n            font-size: 28px;\n            font-weight: bold;\n            color: #aaa;\n            cursor: pointer;\n            line-height: 1;\n        }\n\n        .close:hover {\n            color: #000;\n        }\n\n        .modal-body {\n            padding: 20px;\n        }\n\n        .modal-body .form-group {\n            margin-bottom: 15px;\n        }\n\n        .modal-body .table-container {\n            margin-top: 20px;\n            max-height: 400px;\n            overflow-y: auto;\n        }\n\n        .modal-body table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n\n        .modal-body th,\n        .modal-body td {\n            padding: 12px;\n            text-align: left;\n            border-bottom: 1px solid #e0e0e0;\n        }\n\n        .modal-body th {\n            background-color: #f8f9fa;\n            font-weight: 600;\n            color: #333;\n        }\n\n        .modal-body .no-data {\n            text-align: center;\n            color: #666;\n            font-style: italic;\n            padding: 20px;\n        }\n\n        .btn-primary {\n            background-color: #007bff;\n            color: white;\n            border: none;\n            padding: 8px 16px;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 14px;\n            font-weight: 500;\n            transition: background-color 0.2s;\n        }\n\n        .btn-primary:hover {\n            background-color: #0056b3;\n        }\n    </style>\n</body>\n</html>\n
