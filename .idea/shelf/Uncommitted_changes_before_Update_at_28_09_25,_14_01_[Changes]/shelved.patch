 <div style=\"margin-bottom:12px;\">\n            <label>Amount *</label>\n            <input type=\"number\" step=\"0.01\" id=\"sum\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"e.g. 150000\" required>\n        </div>\n        <div style=\"margin-bottom:12px;\">\n            <label>Payment type *</label>\n            <select id=\"paymentType\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" required>\n                <option value=\"CASH\">CASH</option>\n                <option value=\"CARD\">CARD</option>\n            </select>\n        </div>\n        <div class=\"actions\">\n            <button type=\"submit\" class=\"btn\">Create</button>\n            <a th:href=\"@{/v1/pay/listPage}\" class=\"btn\" style=\"background:#e0e0e0; color:#333;\">Cancel</a>\n        </div>\n    </form>\n</div>\n\n<script>\n    document.getElementById('paymentForm').addEventListener('submit', async (e) => {\n        e.preventDefault();\n        const studentId = Number(document.getElementById('studentId').value);\n        const groupId = Number(document.getElementById('groupId').value);\n        const payload = {\n            sum: Number(document.getElementById('sum').value),\n            paymentType: document.getElementById('paymentType').value\n        };\n        try{\n            const res = await fetch(`/v1/pay/create/${studentId}/${groupId}`, {\n                method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)\n            });\n            if(!res.ok) throw new Error(await res.text());\n            window.location.href = '/v1/pay/listPage';\n        }catch(e){ alert(e.message || 'Failed to create payment'); }\n    });\n</script>\n</body>\n</html>\n\n
