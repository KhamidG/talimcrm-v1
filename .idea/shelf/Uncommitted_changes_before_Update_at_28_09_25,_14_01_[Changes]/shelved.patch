<+>/* Monthly Payments Statistics Page Styles */\n.monthly-stats-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n}\n\n.month-selector {\n    margin-bottom: 30px;\n}\n\n.month-selector .card {\n    background: #4CAF50;\n    color: white;\n    border: none;\n}\n\n.month-selector .card h2 {\n    color: white;\n    margin-bottom: 20px;\n}\n\n.month-selector .form-label {\n    color: rgba(255, 255, 255, 0.9);\n    font-weight: 600;\n}\n\n.month-selector .form-input {\n    background: rgba(255, 255, 255, 0.9);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    color: #333;\n}\n\n.month-selector .form-input:focus {\n    background: white;\n    border-color: rgba(255, 255, 255, 0.5);\n    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);\n}\n\n.month-selector .btn-primary {\n    background: rgba(255, 255, 255, 0.2);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    color: white;\n    font-weight: 600;\n}\n\n.month-selector .btn-primary:hover {\n    background: rgba(255, 255, 255, 0.3);\n    border-color: rgba(255, 255, 255, 0.5);\n}\n\n.summary-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 20px;\n    margin-bottom: 40px;\n}\n\n.summary-card {\n    background: white;\n    border-radius: 12px;\n    padding: 24px;\n    color: #333;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n    border-left: 4px solid #4CAF50;\n}\n\n.summary-card:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);\n}\n\n.summary-card:nth-child(1) {\n    border-left-color: #4CAF50;\n}\n\n.summary-card:nth-child(2) {\n    border-left-color: #2196F3;\n}\n\n.summary-card:nth-child(3) {\n    border-left-color: #f44336;\n}\n\n.summary-card:nth-child(4) {\n    border-left-color: #ff9800;\n}\n\n.card-icon {\n    font-size: 32px;\n    opacity: 0.8;\n}\n\n.card-content h3 {\n    margin: 0 0 8px 0;\n    font-size: 14px;\n    font-weight: 600;\n    color: #666;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n}\n\n.card-number {\n    margin: 0;\n    font-size: 28px;\n    font-weight: 700;\n    line-height: 1;\n    color: #333;\n}\n\n.detailed-section {\n    margin-bottom: 40px;\n}\n\n.detailed-section .card {\n    background: white;\n    border-radius: 12px;\n    padding: 24px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n}\n\n.detailed-section .card-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n    flex-wrap: wrap;\n    gap: 15px;\n}\n\n.detailed-section .card-header h2 {\n    margin: 0;\n    color: #333;\n    font-size: 24px;\n    font-weight: 600;\n}\n\n.detailed-section .controls {\n    display: flex;\n    align-items: center;\n    gap: 15px;\n    flex-wrap: wrap;\n}\n\n.detailed-section .form-input {\n    padding: 10px 15px;\n    border: 2px solid #e0e0e0;\n    border-radius: 8px;\n    font-size: 14px;\n    outline: none;\n    transition: border-color 0.3s, box-shadow 0.3s;\n}\n\n.detailed-section .form-input:focus {\n    border-color: #4CAF50;\n    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.1);\n}\n\n.table-container {\n    overflow-x: auto;\n    border-radius: 8px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\ntable {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    background-color: #ffffff;\n    border-radius: 8px;\n    overflow: hidden;\n}\n\nth, td {\n    padding: 15px;\n    text-align: left;\n    border-bottom: 1px solid #f0f0f0;\n}\n\nth {\n    background-color: #f8f9fa;\n    font-weight: 600;\n    color: #555;\n    text-transform: uppercase;\n    font-size: 14px;\n    letter-spacing: 0.5px;\n}\n\ntr:hover {\n    background-color: #f8f9fa;\n}\n\n.status {\n    display: inline-block;\n    padding: 6px 12px;\n    border-radius: 20px;\n    color: #fff;\n    font-weight: 600;\n    font-size: 12px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n}\n\n.status.card {\n    background-color: #2196F3;\n}\n\n.status.cash {\n    background-color: #4CAF50;\n}\n\n.status.paid {\n    background-color: #4CAF50;\n}\n\n.status.not-paid {\n    background-color: #f44336;\n}\n\n.no-data {\n    text-align: center;\n    color: #888;\n    font-style: italic;\n    padding: 40px;\n    font-size: 16px;\n}\n\n/* Responsive Design */\n@media (max-width: 1200px) {\n    .charts-section {\n        grid-template-columns: 1fr;\n    }\n}\n\n@media (max-width: 768px) {\n    .monthly-stats-container {\n        padding: 15px;\n    }\n    \n    .summary-cards {\n        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n        gap: 15px;\n    }\n    \n    .summary-card {\n        padding: 16px;\n        flex-direction: column;\n        text-align: center;\n    }\n    \n    .card-icon {\n        font-size: 24px;\n    }\n    \n    .card-number {\n        font-size: 20px;\n    }\n    \n    .chart-container,\n    .detailed-section .card {\n        padding: 16px;\n    }\n    \n    .chart-card canvas {\n        max-height: 250px;\n    }\n    \n    .detailed-section .card-header {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n    \n    .detailed-section .controls {\n        width: 100%;\n        justify-content: stretch;\n    }\n    \n    .detailed-section .form-input {\n        flex: 1;\n        min-width: 0;\n    }\n}\n\n@media (max-width: 480px) {\n    .summary-cards {\n        grid-template-columns: 1fr;\n    }\n    \n    .summary-card {\n        flex-direction: row;\n        text-align: left;\n    }\n    \n    .card-icon {\n        font-size: 20px;\n    }\n    \n    .card-number {\n        font-size: 18px;\n    }\n    \n    th, td {\n        padding: 10px 8px;\n        font-size: 14px;\n    }\n    \n    .status {\n        padding: 4px 8px;\n        font-size: 10px;\n    }\n}\n\n/* Animation for loading */\n@keyframes fadeInUp {\n    from {\n        opacity: 0;\n        transform: translateY(30px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.summary-card,\n.chart-container,\n.detailed-section .card {\n    animation: fadeInUp 0.6s ease-out;\n}\n\n.summary-card:nth-child(1) { animation-delay: 0.1s; }\n.summary-card:nth-child(2) { animation-delay: 0.2s; }\n.summary-card:nth-child(3) { animation-delay: 0.3s; }\n.summary-card:nth-child(4) { animation-delay: 0.4s; }\n.summary-card:nth-child(5) { animation-delay: 0.5s; }\n.summary-card:nth-child(6) { animation-delay: 0.6s; }\n
