<+><!DOCTYPE html>\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Payments</title>\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\n</head>\n<body>\n<div class=\"app-container\">\n    <aside class=\"sidebar\">\n        <div class=\"sidebar-header\">\uD83D\uDCDA Talim CRM</div>\n        <nav class=\"sidebar-nav\">\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/statsPage}\"><span>Stats</span></a>\n        </nav>\n    </aside>\n    <main class=\"main-content\">\n<div class=\"container\">\n\n    <h1>Payments</h1>\n\n    <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search by student id or group id\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:260px;\">\n        <select id=\"typeFilter\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\n            <option value=\"\">All types</option>\n            <option value=\"CASH\">CASH</option>\n            <option value=\"CARD\">CARD<