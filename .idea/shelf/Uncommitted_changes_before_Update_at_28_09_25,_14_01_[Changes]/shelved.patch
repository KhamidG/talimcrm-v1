<+>/* Statistics Page Styles */\n.statistics-container {\n    padding: 2rem;\n    max-width: 1400px;\n    margin: 0 auto;\n}\n\n/* Header Section */\n.stats-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    margin-bottom: 2rem;\n    padding: 2rem;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    border-radius: 20px;\n    color: white;\n    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);\n}\n\n.header-content h1 {\n    font-size: 2.5rem;\n    font-weight: 700;\n    margin: 0 0 0.5rem 0;\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n}\n\n.header-content h1 i {\n    font-size: 2rem;\n    opacity: 0.9;\n}\n\n.header-content p {\n    font-size: 1.1rem;\n    opacity: 0.9;\n    margin: 0;\n}\n\n.header-actions {\n    display: flex;\n    align-items: center;\n}\n\n.month-selector {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n}\n\n.selector-card {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    background: rgba(255, 255, 255, 0.15);\n    padding: 1rem 1.5rem;\n    border-radius: 15px;\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.selector-card i {\n    font-size: 1.2rem;\n    opacity: 0.9;\n}\n\n.selector-content {\n    display: flex;\n    flex-direction: column;\n    gap: 0.25rem;\n}\n\n.selector-content label {\n    font-size: 0.9rem;\n    font-weight: 500;\n    opacity: 0.9;\n}\n\n.selector-content select {\n    background: rgba(255, 255, 255, 0.9);\n    border: none;\n    padding: 0.5rem 0.75rem;\n    border-radius: 8px;\n    font-size: 0.9rem;\n    color: #374151;\n    min-width: 120px;\n}\n\n.selector-content select:focus {\n    outline: none;\n    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);\n}\n\n/* Summary Grid */\n.summary-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n    gap: 1.5rem;\n    margin-bottom: 3rem;\n}\n\n.summary-card {\n    background: white;\n    border-radius: 20px;\n    padding: 1.5rem;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n    border: 1px solid rgba(0, 0, 0, 0.05);\n    transition: all 0.3s ease;\n    position: relative;\n    overflow: hidden;\n}\n\n.summary-card::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background: linear-gradient(90deg, #667eea, #764ba2);\n}\n\n.summary-card:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);\n}\n\n.card-header {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    margin-bottom: 1rem;\n}\n\n.card-icon {\n    width: 60px;\n    height: 60px;\n    border-radius: 15px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.5rem;\n    color: white;\n    flex-shrink: 0;\n}\n\n.card-title h3 {\n    font-size: 1.1rem;\n    font-weight: 600;\n    margin: 0 0 0.25rem 0;\n    color: #374151;\n}\n\n.card-title p {\n    font-size: 0.9rem;\n    color: #6B7280;\n    margin: 0;\n}\n\n.card-body {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n}\n\n.card-number {\n    font-size: 2.5rem;\n    font-weight: 700;\n    color: #1F2937;\n    line-height: 1;\n}\n\n.card-trend {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-size: 0.85rem;\n    font-weight: 500;\n    padding: 0.5rem 0.75rem;\n    border-radius: 20px;\n    background: #F3F4F6;\n}\n\n.card-trend.positive {\n    background: #D1FAE5;\n    color: #065F46;\n}\n\n.card-trend.negative {\n    background: #FEE2E2;\n    color: #991B1B;\n}\n\n.card-trend.warning {\n    background: #FEF3C7;\n    color: #92400E;\n}\n\n/* Card Color Variants */\n.total-students .card-icon {\n    background: linear-gradient(135deg, #3B82F6, #1D4ED8);\n}\n\n.active-students .card-icon {\n    background: linear-gradient(135deg, #10B981, #059669);\n}\n\n.stopped-students .card-icon {\n    background: linear-gradient(135deg, #EF4444, #DC2626);\n}\n\n.new-students .card-icon {\n    background: linear-gradient(135deg, #8B5CF6, #7C3AED);\n}\n\n.stopped-month .card-icon {\n    background: linear-gradient(135deg, #F59E0B, #D97706);\n}\n\n.reception-clients .card-icon {\n    background: linear-gradient(135deg, #06B6D4, #0891B2);\n}\n\n.total-revenue .card-icon {\n    background: linear-gradient(135deg, #10B981, #059669);\n}\n\n.monthly-revenue .card-icon {\n    background: linear-gradient(135deg, #F59E0B, #D97706);\n}\n\n/* Charts Section */\n.charts-section {\n    margin-bottom: 3rem;\n}\n\n.chart-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n    gap: 1.5rem;\n}\n\n.chart-card {\n    background: white;\n    border-radius: 20px;\n    padding: 1.5rem;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n    border: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.chart-header {\n    margin-bottom: 1.5rem;\n    padding-bottom: 1rem;\n    border-bottom: 1px solid #F3F4F6;\n}\n\n.chart-header h3 {\n    font-size: 1.2rem;\n    font-weight: 600;\n    margin: 0 0 0.5rem 0;\n    color: #374151;\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n}\n\n.chart-header h3 i {\n    color: #6B7280;\n}\n\n.chart-header p {\n    font-size: 0.9rem;\n    color: #6B7280;\n    margin: 0;\n}\n\n.chart-body {\n    height: 300px;\n    position: relative;\n}\n\n/* Detailed Statistics */\n.detailed-stats {\n    margin-bottom: 2rem;\n}\n\n.stats-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\n    gap: 1.5rem;\n}\n\n.stats-card {\n    background: white;\n    border-radius: 20px;\n    padding: 1.5rem;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n    border: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.stats-header {\n    margin-bottom: 1.5rem;\n    padding-bottom: 1rem;\n    border-bottom: 1px solid #F3F4F6;\n}\n\n.stats-header h3 {\n    font-size: 1.2rem;\n    font-weight: 600;\n    margin: 0 0 0.5rem 0;\n    color: #374151;\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n}\n\n.stats-header h3 i {\n    color: #6B7280;\n}\n\n.stats-header p {\n    font-size: 0.9rem;\n    color: #6B7280;\n    margin: 0;\n}\n\n.stats-list {\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.stats-item {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 1rem;\n    background: #F9FAFB;\n    border-radius: 12px;\n    border: 1px solid #F3F4F6;\n    transition: all 0.2s ease;\n}\n\n.stats-item:hover {\n    background: #F3F4F6;\n    border-color: #E5E7EB;\n}\n\n.item-info {\n    flex: 1;\n}\n\n.item-name {\n    font-weight: 600;\n    color: #374151;\n    margin-bottom: 0.25rem;\n}\n\n.item-meta {\n    font-size: 0.85rem;\n    color: #6B7280;\n}\n\n.item-status {\n    padding: 0.5rem 0.75rem;\n    border-radius: 20px;\n    font-size: 0.8rem;\n    font-weight: 500;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n}\n\n.status-active {\n    background: #D1FAE5;\n    color: #065F46;\n}\n\n.status-stop-learning {\n    background: #FEE2E2;\n    color: #991B1B;\n}\n\n.status-pending {\n    background: #FEF3C7;\n    color: #92400E;\n}\n\n.status-paid {\n    background: #D1FAE5;\n    color: #065F46;\n}\n\n.status-not-paid {\n    background: #FEE2E2;\n    color: #991B1B;\n}\n\n/* Responsive Design */\n@media (max-width: 768px) {\n    .statistics-container {\n        padding: 1rem;\n    }\n    \n    .stats-header {\n        flex-direction: column;\n        gap: 1.5rem;\n        text-align: center;\n    }\n    \n    .header-content h1 {\n        font-size: 2rem;\n    }\n    \n    .summary-grid {\n        grid-template-columns: 1fr;\n        gap: 1rem;\n    }\n    \n    .chart-grid {\n        grid-template-columns: 1fr;\n    }\n    \n    .stats-grid {\n        grid-template-columns: 1fr;\n    }\n    \n    .selector-card {\n        flex-direction: column;\n        align-items: stretch;\n        gap: 0.75rem;\n    }\n    \n    .selector-content {\n        align-items: center;\n    }\n}\n\n@media (max-width: 480px) {\n    .summary-card {\n        padding: 1rem;\n    }\n    \n    .card-header {\n        flex-direction: column;\n        align-items: flex-start;\n        gap: 0.75rem;\n    }\n    \n    .card-body {\n        flex-direction: column;\n        align-items: flex-start;\n        gap: 0.75rem;\n    }\n    \n    .card-number {\n        font-size: 2rem;\n    }\n}\n\n/* Animation for loading states */\n@keyframes pulse {\n    0%, 100% {\n        opacity: 1;\n    }\n    50% {\n        opacity: 0.5;\n    }\n}\n\n.loading {\n    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n/* Custom scrollbar */\n.stats-list::-webkit-scrollbar {\n    width: 6px;\n}\n\n.stats-list::-webkit-scrollbar-track {\n    background: #F3F4F6;\n    border-radius: 3px;\n}\n\n.stats-list::-webkit-scrollbar-thumb {\n    background: #D1D5DB;\n    border-radius: 3px;\n}\n\n.stats-list::-webkit-scrollbar-thumb:hover {\n    background: #9CA3AF;\n}
