           <input type=\"tel\" id=\"phoneNum\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"+998 xx xxx xx xx\" required>\n            </div>\n        <div style=\"margin-bottom:12px;\">\n            <label>Placement test score (0-40)</label>\n            <input type=\"number\" id=\"testScore\" min=\"0\" max=\"40\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\" placeholder=\"e.g. 26\">\n            <small style=\"color:#666;\">If score > 25: show IELTS groups. Otherwise: BEGINNER and PRE_IELTS.</small>\n            </div>\n        <div class=\"actions\">\n            <button type=\"submit\" class=\"btn\">Create</button>\n            <a th:href=\"@{/v1/student/listPage}\" class=\"btn\" style=\"background:#e0e0e0; color:#333;\">Cancel</a>\n            </div>\n        </form>\n\n    <!-- Suggested Groups Section (shown after registration) -->\n    <div id=\"suggestions\" style=\"display:none; margin-top:24px;\">\n        <h2>Suggested empty groups</h2>\n        <p id=\"suggestionHint\" style=\"color:#666; margin-top:4px;\"></p>\n        <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\n            <input id=\"groupSearch\" type=\"text\" placeholder=\"Search groups\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:220px;\">\n        </div>\n        <table class=\"table\" style=\"width:100%; border-collapse: collapse;\">\n            <thead>\n            <tr>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">ID</th>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Name</th>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Type</th>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Students</th>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Max</th>\n                <th style=\"text-align:left; border-bottom:1px solid #ddd; padding:8px;\">Action</th>\n            </tr>\n            </thead>\n            <tbody id=\"suggestionsBody\"></tbody>\n        </table>\n    </div>\n    </div>\n</main>\n</div>\n\n<script>\n    const API = '/v1/student';\n    let createdStudentId = null;\n    let allGroups = [];\n\n    document.getElementById('studentRegisterForm').addEventListener('submit', async (e) => {\n        e.preventDefault();\n        const payload = {\n            fullName: document.getElementById('fullName').value.trim(),\n            phoneNum: document.getElementById('phoneNum').value.trim()\n        };\n        const res = await fetch(`${API}/register`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify(payload)\n        });\n        if (res.ok) {\n            const student = await res.json();\n            createdStudentId = student.id;\n            await showSuggestions();\n        } else {\n            alert('Failed to create student');\n        }\n    });\n\n    async function showSuggestions(){\n        if (allGroups.length === 0) {\n            try {\n                const res = await fetch('/v1/group/list');\n                allGroups = await res.json();\n            } catch(_) { allGroups = []; }\n        }\n        const score = Number(document.getElementById('testScore').value || '0');\n        const isIelts = score > 25;\n        const targetTypes = isIelts ? ['IELTS'] : ['BEGINNER','PRE_IELTS'];\n        document.getElementById('suggestionHint').textContent = isIelts ? 'Score > 25 → IELTS empty groups' : 'Score ≤ 25 → BEGINNER and PRE_IELTS empty groups';\n\n        const emptyGroups = allGroups.filter(g => targetTypes.includes(g.typeOfGroup) && (g.currentStudents === 0 || g.currentStudents == null));\n\n        const tbody = document.getElementById('suggestionsBody');\n        const search = document.getElementById('groupSearch').value?.toLowerCase?.() || '';\n        const filtered = search ? emptyGroups.filter(g => (g.nameOfGroup||'').toLowerCase().includes(search)) : emptyGroups;\n        tbody.innerHTML = '';\n        if (filtered.length === 0) {\n            tbody.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding:16px; color:#888;\">No empty groups found</td></tr>`;\n        } else {\n            filtered.forEach(g => {\n                const tr = document.createElement('tr');\n                tr.innerHTML = `\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.id}</td>\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${escapeHtml(g.nameOfGroup)||''}</td>\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${escapeHtml(g.typeOfGroup)||''}</td>\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.currentStudents ?? 0}</td>\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\">${g.maxStudents ?? '—'}</td>\n                    <td style=\\\"border-bottom:1px solid #f0f0f0; padding:8px;\\\"><button class=\\\"action-btn edit-btn\\\" data-group-id=\\\"${g.id}\\\">Assign</button></td>\n                `;\n                tbody.appendChild(tr);\n            });\n        }\n        tbody.querySelectorAll('button[data-group-id]').forEach(btn => {\n            btn.addEventListener('click', async () => {\n                const gid = btn.getAttribute('data-group-id');\n                if (!createdStudentId) return alert('Student not created');\n                try {\n                    const res = await fetch(`/v1/student/addToGroup/${createdStudentId}/${gid}`, { method: 'POST' });\n                    if (!res.ok) throw new Error(await res.text());\n                    alert('Student assigned to group');\n                } catch(e) {\n                    alert(e.message || 'Failed to assign');\n                }\n            });\n        });\n        document.getElementById('suggestions').style.display = 'block';\n        document.getElementById('groupSearch').oninput = showSuggestions;\n    }\n    // sidebar toggle\n    (() => {\n      const sidebar = document.getElementById('sidebar');\n      const toggle = document.getElementById('sidebarToggle');\n      const key = 'talimcrm.sidebar.collapsed';\n      const apply = () => {\n        const collapsed = localStorage.getItem(key) === '1';\n        if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\n      };\n      apply();\n      toggle.addEventListener('click', () => {\n        const collapsed = !(localStorage.getItem(key) === '1');\n        localStorage.setItem(key, collapsed ? '1' : '0');\n        apply();\n      });\n    })();\n\n    function escapeHtml(str) {\n        if (str == null) return '';\n        return String(str).replace(/[&<>\"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[s]));\n    }\n</script>\n</body>\n</html>
