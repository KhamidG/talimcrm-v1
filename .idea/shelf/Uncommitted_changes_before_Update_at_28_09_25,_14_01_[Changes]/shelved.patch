<+><!DOCTYPE html>\n<html lang=\"en\" xmlns:th=\"http://www.thymeleaf.org\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Groups</title>\n    <link rel=\"stylesheet\" th:href=\"@{/style.css}\" />\n</head>\n<body>\n<div class=\"app-container\">\n    <aside class=\"sidebar\" id=\"sidebar\">\n        <div class=\"sidebar-header\">\uD83D\uDCDA Talim CRM</div>\n        <nav class=\"sidebar-nav\">\n            <a class=\"nav-link\" th:href=\"@{/v1/auth/reception}\"><span>Reception</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/student/listPage}\"><span>Students</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/student/register}\"><span>New student</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/group/listPage}\"><span>Groups</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/group/register}\"><span>New group</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/listPage}\"><span>Teachers</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/teacher/register}\"><span>New teacher</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/listPage}\"><span>Payments</span></a>\n            <a class=\"nav-link\" th:href=\"@{/v1/pay/statsPage}\"><span>Stats</span></a>\n    </nav>\n</aside>\n    <main class=\"main-content\">\n        <button class=\"menu-toggle btn btn-outline\" id=\"sidebarToggle\" aria-label=\"Toggle menu\">☰</button>\n<div class=\"container\">\n\n    <h1>Groups</h1>\n\n    <div class=\"controls\" style=\"display:flex; gap:12px; align-items:center; margin:12px 0; flex-wrap:wrap;\">\n        <input id=\"searchInput\" type=\"text\" placeholder=\"Search by name or teacher\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px; min-width:260px;\">\n        <select id=\"typeFilter\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\n            <option value=\"\">All types</option>\n                <option value=\"BEGINNER\">Beginner</option>\n                <option value=\"INTERMEDIATE\">Intermediate</option>\n                <option value=\"PRE_IELTS\">Pre-IELTS</option>\n                <option value=\"IELTS\">IELTS</option>\n                <option value=\"CEFR\">CEFR</option>\n            </select>\n        <select id=\"pageSize\" style=\"padding:10px 14px; border:1px solid #ddd; border-radius:8px;\">\n            <option value=\"10\">10 per page</option>\n            <option value=\"25\" selected>25 per page</option>\n            <option value=\"50\">50 per page</option>\n            <option value=\"100\">100 per page</option>\n            </select>\n        </div>\n\n    <table class=\"table\">\n                <thead>\n        <tr>\n            <th>ID</th>\n            <th>Name</th>\n            <th>Type</th>\n            <th>Teacher</th>\n            <th>Students</th>\n            <th>Max</th>\n            <th>Created</th>\n            <th>Actions</th>\n                </tr>\n                </thead>\n        <tbody id=\"groupsTableBody\">\n            <!-- Groups will be loaded here -->\n        </tbody>\n            </table>\n            \n        <!-- Pagination Controls -->\n        <div id=\"paginationControls\" style=\"display:flex; justify-content:space-between; align-items:center; margin:20px 0; padding:10px 0;\">\n            <div id=\"paginationInfo\" style=\"color:#666; font-size:14px;\">\n                Showing <span id=\"showingStart\">0</span> to <span id=\"showingEnd\">0</span> of <span id=\"totalRecords\">0</span> entries\n            </div>\n            <div id=\"paginationButtons\" style=\"display:flex; gap:8px;\">\n                <button id=\"prevPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Previous</button>\n                <div id=\"pageNumbers\" style=\"display:flex; gap:4px;\"></div>\n                <button id=\"nextPage\" class=\"btn btn-outline\" style=\"padding:8px 12px; border:1px solid #ddd; background:white; border-radius:6px; cursor:pointer;\" disabled>Next</button>\n            </div>\n        </div>\n</div>\n    </main>\n</div>\n<!-- Assign Teacher Modal -->\n<div id=\"assignTeacherModal\" class=\"modal\" style=\"display:none; position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,.4); align-items:center; justify-content:center;\">\n    <div class=\"modal-content\" style=\"background:#fff; border-radius:12px; padding:20px; width:90%; max-width:420px; position:relative; z-index:1;\">\n        <h3 style=\"margin-top:0;\">Assign teacher to group</h3>\n        <div style=\"margin:12px 0;\">\n            <label>Teacher</label>\n            <select id=\"assignTeacherSelect\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\"></select>\n        </div>\n        <div class=\"actions\" style=\"justify-content:flex-end;\">\n            <button class=\"action-btn\" type=\"button\" style=\"background:#ccc;\" onclick=\"closeAssignTeacherModal()\">Cancel</button>\n            <button class=\"action-btn edit-btn\" type=\"button\" onclick=\"confirmAssignTeacher()\">Assign</button>\n        </div>\n        <input type=\"hidden\" id=\"assignTeacherGroupId\" />\n    </div>\n    <div onclick=\"closeAssignTeacherModal()\" style=\"position:absolute; inset:0;\"></div>\n            </div>\n\n<!-- Add Student Modal -->\n<div id=\"addStudentModal\" class=\"modal\" style=\"display:none; position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,.4); align-items:center; justify-content:center;\">\n    <div class=\"modal-content\" style=\"background:#fff; border-radius:12px; padding:20px; width:90%; max-width:420px; position:relative; z-index:1;\">\n        <h3 style=\"margin-top:0;\">Add student to group</h3>\n        <div style=\"margin:12px 0;\">\n            <label>Student</label>\n            <select id=\"addStudentSelect\" style=\"width:100%; padding:10px 14px; border:1px solid #ddd; border-radius:8px;\"></select>\n                </div>\n        <div class=\"actions\" style=\"justify-content:flex-end;\">\n            <button class=\"action-btn\" type=\"button\" style=\"background:#ccc;\" onclick=\"closeAddStudentModal()\">Cancel</button>\n            <button class=\"action-btn edit-btn\" type=\"button\" onclick=\"confirmAddStudent()\">Add</button>\n        </div>\n        <input type=\"hidden\" id=\"addStudentGroupId\" />\n    </div>\n    <div onclick=\"closeAddStudentModal()\" style=\"position:absolute; inset:0;\"></div>\n</div>\n\n<script>\n    const API_BASE = '/v1/group';\n    let groups = [];\n    let teachersCache = [];\n    let studentsCache = [];\n    let currentPage = 1;\n    let pageSize = 25;\n    let filteredData = [];\n\n    document.addEventListener('DOMContentLoaded', () => {\n        loadGroups();\n        document.getElementById('searchInput').addEventListener('input', applyFilters);\n        document.getElementById('typeFilter').addEventListener('change', applyFilters);\n        document.getElementById('pageSize').addEventListener('change', (e) => {\n            pageSize = parseInt(e.target.value);\n            currentPage = 1;\n            applyFilters();\n        });\n        document.getElementById('prevPage').addEventListener('click', () => {\n            if (currentPage > 1) {\n                currentPage--;\n                renderPage();\n            }\n        });\n        document.getElementById('nextPage').addEventListener('click', () => {\n            const totalPages = Math.ceil(filteredData.length / pageSize);\n            if (currentPage < totalPages) {\n                currentPage++;\n                renderPage();\n            }\n        });\n    });\n\n    async function loadGroups() {\n        try {\n            const res = await fetch(`${API_BASE}/list`);\n            if (!res.ok) throw new Error(`HTTP ${res.status}`);\n            groups = await res.json();\n            applyFilters();\n        } catch (e) {\n            console.error('Failed to load groups', e);\n        }\n    }\n\n    function applyFilters() {\n        const term = document.getElementById('searchInput').value.toLowerCase().trim();\n        const type = document.getElementById('typeFilter').value;\n        let data = groups.slice();\n        if (term) {\n            data = data.filter(g => \n                (g.nameOfGroup || '').toLowerCase().includes(term) || \n                (g.teacherFullName || '').toLowerCase().includes(term)\n            );\n        }\n        if (type) {\n            data = data.filter(g => g.typeOfGroup === type);\n        }\n        filteredData = data;\n        currentPage = 1;\n        renderPage();\n    }\n\n    function renderPage() {\n        const startIndex = (currentPage - 1) * pageSize;\n        const endIndex = startIndex + pageSize;\n        const pageData = filteredData.slice(startIndex, endIndex);\n        \n        const tbody = document.getElementById('groupsTableBody');\n        tbody.innerHTML = '';\n        if (!pageData || pageData.length === 0) {\n            tbody.innerHTML = `<tr><td colspan=\"8\" style=\"text-align:center; padding:20px; color:#888;\">No groups found</td></tr>`;\n        } else {\n            pageData.forEach(g => {\n                const tr = document.createElement('tr');\n                tr.innerHTML = `\n                    <td>${g.id}</td>\n                    <td>${escapeHtml(g.nameOfGroup || '—')}</td>\n                    <td>${escapeHtml(g.typeOfGroup || '—')}</td>\n                    <td>${escapeHtml(g.teacherFullName || '—')}</td>\n                    <td>${g.currentStudents || 0}</td>\n                    <td>${g.maxStudents || '—'}</td>\n                    <td>${escapeHtml(g.created_at || '—')}</td>\n                    <td>\n                        <div class=\"actions\">\n                            <button class=\"action-btn edit-btn\" type=\"button\" data-group-id=\"${g.id}\" onclick=\"openAssignTeacherModal(this)\">Assign teacher</button>\n                            <button class=\"action-btn\" type=\"button\" style=\"background:#6c757d;color:#fff;\" data-group-id=\"${g.id}\" onclick=\"openAddStudentModal(this)\">Add student</button>\n                        </div>\n                </td>\n            `;\n                tbody.appendChild(tr);\n            });\n        }\n        updatePagination();\n    }\n\n    function updatePagination() {\n        const totalPages = Math.ceil(filteredData.length / pageSize);\n        const startIndex = (currentPage - 1) * pageSize;\n        const endIndex = Math.min(startIndex + pageSize, filteredData.length);\n        \n        // Update pagination info\n        document.getElementById('showingStart').textContent = filteredData.length > 0 ? startIndex + 1 : 0;\n        document.getElementById('showingEnd').textContent = endIndex;\n        document.getElementById('totalRecords').textContent = filteredData.length;\n        \n        // Update buttons\n        document.getElementById('prevPage').disabled = currentPage <= 1;\n        document.getElementById('nextPage').disabled = currentPage >= totalPages;\n        \n        // Update page numbers\n        const pageNumbersDiv = document.getElementById('pageNumbers');\n        pageNumbersDiv.innerHTML = '';\n        \n        const maxVisiblePages = 5;\n        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));\n        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);\n        \n        if (endPage - startPage + 1 < maxVisiblePages) {\n            startPage = Math.max(1, endPage - maxVisiblePages + 1);\n        }\n        \n        for (let i = startPage; i <= endPage; i++) {\n            const pageBtn = document.createElement('button');\n            pageBtn.textContent = i;\n            pageBtn.className = i === currentPage ? 'btn btn-primary' : 'btn btn-outline';\n            pageBtn.style.cssText = 'padding:8px 12px; border:1px solid #ddd; background:' + (i === currentPage ? '#007bff; color:white' : 'white') + '; border-radius:6px; cursor:pointer;';\n            pageBtn.addEventListener('click', () => {\n                currentPage = i;\n                renderPage();\n            });\n            pageNumbersDiv.appendChild(pageBtn);\n        }\n    }\n\n    async function openAssignTeacherModal(btn){\n        const groupId = btn.getAttribute('data-group-id');\n        document.getElementById('assignTeacherGroupId').value = groupId;\n        const modal = document.getElementById('assignTeacherModal');\n        modal.style.display = 'flex';\n        try {\n            if (teachersCache.length === 0) {\n                const res = await fetch('/v1/teacher/list');\n                if (!res.ok) throw new Error('Teacher list failed');\n                teachersCache = await res.json();\n            }\n            const sel = document.getElementById('assignTeacherSelect');\n            sel.innerHTML = teachersCache.map(t => `<option value=\"${t.id}\">${escapeHtml(t.fullName)||'—'} (${escapeHtml(t.phoneNum)||''})</option>`).join('');\n        } catch(e){ alert('Failed to load teachers'); }\n    }\n    function closeAssignTeacherModal(){ document.getElementById('assignTeacherModal').style.display='none'; }\n    async function confirmAssignTeacher(){\n        const groupId = document.getElementById('assignTeacherGroupId').value;\n        const teacherId = document.getElementById('assignTeacherSelect').value;\n        try{\n            const res = await fetch(`/v1/group/assignTeacher/${groupId}/${teacherId}`, { method:'POST' });\n            if (!res.ok) throw new Error(await res.text());\n            closeAssignTeacherModal();\n            loadGroups(); // Reload groups instead of full page reload\n        }catch(e){ alert(e.message || 'Failed to assign teacher'); }\n    }\n\n    async function openAddStudentModal(btn){\n        const groupId = btn.getAttribute('data-group-id');\n        document.getElementById('addStudentGroupId').value = groupId;\n        const modal = document.getElementById('addStudentModal');\n        modal.style.display = 'flex';\n        try {\n            if (studentsCache.length === 0) {\n                const res = await fetch('/v1/student/list');\n                if (!res.ok) throw new Error('Student list failed');\n                studentsCache = await res.json();\n            }\n            const sel = document.getElementById('addStudentSelect');\n            sel.innerHTML = studentsCache.map(s => `<option value=\"${s.id}\">${escapeHtml(s.fullName)||'—'} (${escapeHtml(s.phoneNum)||''})</option>`).join('');\n        } catch(e){ alert('Failed to load students'); }\n    }\n    function closeAddStudentModal(){ document.getElementById('addStudentModal').style.display='none'; }\n    async function confirmAddStudent(){\n        const groupId = document.getElementById('addStudentGroupId').value;\n        const studentId = document.getElementById('addStudentSelect').value;\n        try{\n            const res = await fetch(`/v1/student/addToGroup/${studentId}/${groupId}`, { method:'POST' });\n            if (!res.ok) throw new Error(await res.text());\n            closeAddStudentModal();\n            loadGroups(); // Reload groups instead of full page reload\n        }catch(e){ alert(e.message || 'Failed to add student'); }\n    }\n\n    function escapeHtml(s){ if(s==null) return ''; return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;','\\'':'&#39;'}[c])); }\n// sidebar toggle\n(() => {\n  const sidebar = document.getElementById('sidebar');\n  const toggle = document.getElementById('sidebarToggle');\n  const key = 'talimcrm.sidebar.collapsed';\n  const apply = () => {\n    const collapsed = localStorage.getItem(key) === '1';\n    if (collapsed) sidebar.classList.add('collapsed'); else sidebar.classList.remove('collapsed');\n  };\n  apply();\n  toggle.addEventListener('click', () => {\n    const collapsed = !(localStorage.getItem(key) === '1');\n    localStorage.setItem(key, collapsed ? '1' : '0');\n    apply();\n  });\n})();\n</script>\n</body>\n</html>
